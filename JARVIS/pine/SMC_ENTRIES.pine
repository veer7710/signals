//@version=6
// IF LINE 1 ABOVE SHOWS ONE SLASH, YOUR PASTE DROPPED A CHARACTER.
// It must read exactly:  //@version=6
// ---------------------------------------------------------------------------
//  SMC ENTRIES — the liquidity model, as entry signals. Nothing else.
//
//  Veer: "liqudirt smc strat bro just make entries sifgnals of this si all im
//  askign". This is that, built from the structure in his own screenshots:
//  BOS, CHoCH, EQH/EQL, buyside/sellside liquidity, order blocks, strong and
//  weak highs and lows, premium and discount.
//
//  THE ENTRY MODEL, in four steps and no more:
//    1. LIQUIDITY IS TAKEN   price runs a pool of equal highs/lows or a prior
//                            swing, and CLOSES BACK INSIDE. Stop hunt, not
//                            breakout.
//    2. CHARACTER CHANGES    structure breaks the other way (CHoCH) within
//                            chochBars of the sweep. This is the confirmation.
//    3. ENTRY                the order block or fair value gap left behind by
//                            the CHoCH leg. A limit, at the level, on the
//                            retrace. Market entry if you would rather not miss.
//    4. STOP AND TARGET      stop beyond the sweep extreme, target the OPPOSITE
//                            liquidity pool. Both are structural, not multiples
//                            of anything.
//
//  WHAT THIS DOES NOT DO
//  It does not simulate a book, count trades, or print a win rate. Every panel
//  in this project that reported one has at some point reported a wrong one -
//  a scoreboard that could only print zero (E-182), a trail that booked exits
//  at prices the bar never traded (E-183), a basket rule needing an 85% win
//  rate (E-189). So this file draws the setup and stays out of the arithmetic.
//
//  A SIGNAL, ONCE PRINTED, IS NEVER REMOVED. plotshape output cannot be
//  deleted, which is the whole reason it is used here.
//
//  Structure detection follows the standard SMC vocabulary that LuxAlgo's
//  "Smart Money Concepts" popularised. That indicator is CC BY-NC-SA 4.0 and
//  none of its code is used here - this is an independent implementation of
//  the published concepts.
// ---------------------------------------------------------------------------
// max_bars_back is REQUIRED, not optional: the order-block scan below reads
// close[i] with a VARIABLE i, and Pine cannot size its historical buffer from
// a variable offset. Without this it throws "bar index too far in the past" at
// runtime, on some charts and not others, which is the worst kind of bug.
indicator("SMC ENTRIES", overlay = true, max_labels_count = 500,
     max_lines_count = 500, max_boxes_count = 500, max_bars_back = 500)

// ============================== INPUTS ====================================
gS = "1 · STRUCTURE"
swLen   = input.int(5, "Swing length", group = gS, minval = 2,
     tooltip = "Bars either side of a pivot. A pivot is only KNOWN this many bars after it forms, and everything here waits for that - nothing is drawn earlier than it was knowable.")
eqTol   = input.float(0.10, "Equal high/low tolerance (ATR)", group = gS, step = 0.05,
     tooltip = "Two swings within this many ATR of each other are EQUAL - a pool of stops sitting at one price. That pool is what gets taken.")

gE = "2 · THE ENTRY"
sweepAtr  = input.float(0.05, "Sweep must clear the pool by (ATR)", group = gE, step = 0.05)
chochBars = input.int(20, "CHoCH must arrive within N bars of the sweep", group = gE, minval = 1)
useOB     = input.bool(true,  "Enter at the order block", group = gE)
useFVG    = input.bool(true,  "...or the fair value gap if there is no OB", group = gE)
entryMode = input.string("Limit at the zone", "Entry", group = gE,
     options = ["Limit at the zone", "Market on the CHoCH"],
     tooltip = "LIMIT waits for price to come back into the order block. Better price, and it misses the setups that never come back. MARKET takes the CHoCH close - it never misses, and it pays more.")
zoneLife  = input.int(30, "Cancel an untouched zone after N bars", group = gE, minval = 1)

gR = "3 · STOP AND TARGET"
stopBuf = input.float(0.20, "Stop beyond the sweep extreme (ATR)", group = gR, step = 0.05)
tpMode  = input.string("Opposite liquidity", "Target", group = gR,
     options = ["Opposite liquidity", "Fixed R"])
tpR     = input.float(2.0, "...if Fixed R", group = gR, step = 0.5)

gF = "4 · FILTERS  (each one refuses trades — turn on deliberately)"
useDisc  = input.bool(false, "Only buy in discount / sell in premium", group = gF,
     tooltip = "Premium and discount are measured on the current dealing range - the last confirmed swing high to swing low. E-184 measured this at 1.14-1.23 lift as a leg-start marker on four samples, the second strongest of every SMC concept tested.")
useHtf   = input.bool(false, "Higher timeframe must agree", group = gF,
     tooltip = "E-185 measured five different higher-timeframe contexts on top of an entry like this one and every single one landed within 0.02 of the unfiltered result, while cutting the signal count by half to two thirds. It is here because it is asked for, not because it measured well.")
htfTf    = input.timeframe("60", "...which timeframe", group = gF)

gD = "5 · CHART"
showStruct = input.bool(true,  "BOS / CHoCH labels", group = gD)
showPools  = input.bool(true,  "Liquidity pools", group = gD)
showZones  = input.bool(true,  "Order blocks and FVGs", group = gD)
showLevels = input.bool(true,  "Entry / stop / target lines", group = gD)
cBuy   = input.color(#00B0FF, "Buy",  group = gD, inline = "c")
cSell  = input.color(#FF3B5C, "Sell", group = gD, inline = "c")
cDim   = input.color(#8FA3B8, "Dim",  group = gD, inline = "c")

atr = ta.atr(14)

// ========================= SWINGS AND STRUCTURE ===========================
// A pivot confirms swLen bars after it forms. ph/pl are non-na only on the
// bar of confirmation, and every use below reads them there - so nothing in
// this file knows a swing before the chart did.
ph = ta.pivothigh(high, swLen, swLen)
pl = ta.pivotlow(low, swLen, swLen)

var float lastSwH  = na          // the most recent CONFIRMED swing high
var float lastSwL  = na
var int   lastSwHb = na
var int   lastSwLb = na
var float prevSwH  = na          // and the one before it, for EQH/EQL
var float prevSwL  = na
var int   trend    = 0           // +1 bullish structure, -1 bearish

if not na(ph)
    prevSwH := lastSwH
    lastSwH := ph
    lastSwHb := bar_index - swLen
if not na(pl)
    prevSwL := lastSwL
    lastSwL := pl
    lastSwLb := bar_index - swLen

// BOS = structure broken IN the trend's direction. CHoCH = the FIRST break
// AGAINST it, which is the one this model trades. Both are measured on the
// CLOSE of a confirmed bar, never on a wick, because a wick through a level
// is the sweep, not the break.
bosUp   = not na(lastSwH) and close > lastSwH and barstate.isconfirmed
bosDn   = not na(lastSwL) and close < lastSwL and barstate.isconfirmed
chochUp = bosUp and trend <= 0
chochDn = bosDn and trend >= 0
if bosUp
    trend := 1
if bosDn
    trend := -1

// ============================ LIQUIDITY POOLS =============================
// A pool is two swings at the same price - equal highs or equal lows. That is
// where the stops are, and it is what price reaches for.
eqH  = not na(lastSwH) and not na(prevSwH) and math.abs(lastSwH - prevSwH) <= eqTol * atr
eqL  = not na(lastSwL) and not na(prevSwL) and math.abs(lastSwL - prevSwL) <= eqTol * atr
poolH = eqH ? math.max(lastSwH, prevSwH) : lastSwH      // single swing counts too
poolL = eqL ? math.min(lastSwL, prevSwL) : lastSwL

// ============================== THE SWEEP =================================
// Price runs the pool and CLOSES BACK INSIDE it. A close beyond is a break,
// not a sweep, and this model wants the failed break.
var float sweptHiPx = na         // the pool that was taken
var int   sweptHiB  = na
var float sweptHiEx = na         // and how far past it price actually went
var float sweptLoPx = na
var int   sweptLoB  = na
var float sweptLoEx = na

sweepHi = not na(poolH) and high > poolH + sweepAtr * atr and close < poolH
     and barstate.isconfirmed
sweepLo = not na(poolL) and low < poolL - sweepAtr * atr and close > poolL
     and barstate.isconfirmed

if sweepHi
    sweptHiPx := poolH
    sweptHiB  := bar_index
    sweptHiEx := high
if sweepLo
    sweptLoPx := poolL
    sweptLoB  := bar_index
    sweptLoEx := low
// the extreme keeps extending while the setup is alive - the stop goes with it
if not na(sweptHiB) and bar_index > sweptHiB
    sweptHiEx := math.max(sweptHiEx, high)
if not na(sweptLoB) and bar_index > sweptLoB
    sweptLoEx := math.min(sweptLoEx, low)
// a sweep nobody answered is not a setup
if not na(sweptHiB) and bar_index - sweptHiB > chochBars
    sweptHiB := na
if not na(sweptLoB) and bar_index - sweptLoB > chochBars
    sweptLoB := na

// ========================= ORDER BLOCKS AND FVG ===========================
// The order block is the last opposing candle before the move that broke
// structure. The FVG is the three-bar imbalance inside that move. Both mark
// the same thing - the price the move left behind - and the OB is preferred
// because it is a candle, not a gap.
float obBullTop = na
float obBullBot = na
float obBearTop = na
float obBearBot = na
for i = 1 to 20
    if na(obBullTop) and close[i] < open[i] and close > high[i]
        obBullTop := high[i]
        obBullBot := low[i]
    if na(obBearTop) and close[i] > open[i] and close < low[i]
        obBearTop := high[i]
        obBearBot := low[i]

fvgBullTop = low > high[2] ? low : na
fvgBullBot = low > high[2] ? high[2] : na
fvgBearTop = high < low[2] ? low[2] : na
fvgBearBot = high < low[2] ? high : na

// ======================== PREMIUM AND DISCOUNT ============================
// The dealing range is the last confirmed swing high to the last confirmed
// swing low. Below the midpoint is discount, above is premium.
rngHi = lastSwH
rngLo = lastSwL
rngOk = not na(rngHi) and not na(rngLo) and rngHi > rngLo
eqm   = rngOk ? (rngHi + rngLo) / 2.0 : na
inDisc = rngOk and close < eqm
inPrem = rngOk and close > eqm

// ========================== HIGHER TIMEFRAME ==============================
// lookahead_off on the PREVIOUS HTF bar is the only non-repainting idiom. A
// forming higher-timeframe bar is not knowable and reading it is how a
// multi-timeframe indicator lies about its own history.
htfC = request.security(syminfo.tickerid, htfTf, close[1],
     lookahead = barmerge.lookahead_off)
htfE = request.security(syminfo.tickerid, htfTf, ta.ema(close, 50)[1],
     lookahead = barmerge.lookahead_off)
htfUp = not useHtf or na(htfC) or na(htfE) or htfC > htfE
htfDn = not useHtf or na(htfC) or na(htfE) or htfC < htfE

// ============================== THE SIGNAL ================================
// BUY  = sellside liquidity taken, then structure changes character UP,
//        inside chochBars. SELL is the mirror.
rawBuy  = not na(sweptLoB) and chochUp and bar_index - sweptLoB <= chochBars
rawSell = not na(sweptHiB) and chochDn and bar_index - sweptHiB <= chochBars

okBuy  = rawBuy  and (not useDisc or inDisc) and htfUp
okSell = rawSell and (not useDisc or inPrem) and htfDn

// The zone to enter at, the stop, and the target - all structural.
zBuyTop = useOB and not na(obBullTop) ? obBullTop : useFVG ? fvgBullTop : na
zBuyBot = useOB and not na(obBullBot) ? obBullBot : useFVG ? fvgBullBot : na
zSellTop = useOB and not na(obBearTop) ? obBearTop : useFVG ? fvgBearTop : na
zSellBot = useOB and not na(obBearBot) ? obBearBot : useFVG ? fvgBearBot : na

var float armBuyPx = na
var float armBuySl = na
var float armBuyTp = na
var int   armBuyB  = na
var float armSellPx = na
var float armSellSl = na
var float armSellTp = na
var int   armSellB  = na

if okBuy
    z = na(zBuyTop) ? close : zBuyTop
    armBuyPx := entryMode == "Limit at the zone" ? z : close
    armBuySl := sweptLoEx - stopBuf * atr
    r = armBuyPx - armBuySl
    armBuyTp := tpMode == "Fixed R" ? armBuyPx + tpR * r
         : (not na(poolH) ? poolH : armBuyPx + 2.0 * r)
    armBuyB := bar_index
if okSell
    z = na(zSellBot) ? close : zSellBot
    armSellPx := entryMode == "Limit at the zone" ? z : close
    armSellSl := sweptHiEx + stopBuf * atr
    r = armSellSl - armSellPx
    armSellTp := tpMode == "Fixed R" ? armSellPx - tpR * r
         : (not na(poolL) ? poolL : armSellPx - 2.0 * r)
    armSellB := bar_index

// an untouched zone expires
if not na(armBuyB) and bar_index - armBuyB > zoneLife
    armBuyB := na
if not na(armSellB) and bar_index - armSellB > zoneLife
    armSellB := na

// THE FILL. Market fills on the signal bar; a limit fills when price returns
// into the zone. Both are marked, and neither mark is ever removed.
fillBuy = entryMode == "Market on the CHoCH" ? okBuy
     : (not na(armBuyB) and bar_index > armBuyB and low <= armBuyPx
        and barstate.isconfirmed)
fillSell = entryMode == "Market on the CHoCH" ? okSell
     : (not na(armSellB) and bar_index > armSellB and high >= armSellPx
        and barstate.isconfirmed)
if fillBuy
    armBuyB := na
if fillSell
    armSellB := na

// ================================ DRAWING =================================
plotshape(fillBuy, "BUY", shape.labelup, location.belowbar, color = cBuy,
     text = "BUY", textcolor = color.white, size = size.small)
plotshape(fillSell, "SELL", shape.labeldown, location.abovebar, color = cSell,
     text = "SELL", textcolor = color.white, size = size.small)
plotshape(showStruct and chochUp, "CHoCH up", shape.triangleup,
     location.belowbar, color = color.new(cBuy, 40), size = size.tiny)
plotshape(showStruct and chochDn, "CHoCH down", shape.triangledown,
     location.abovebar, color = color.new(cSell, 40), size = size.tiny)
plotshape(showStruct and sweepLo, "sellside taken", shape.xcross,
     location.belowbar, color = color.new(cBuy, 55), size = size.tiny)
plotshape(showStruct and sweepHi, "buyside taken", shape.xcross,
     location.abovebar, color = color.new(cSell, 55), size = size.tiny)

plot(showPools and not na(poolH) ? poolH : na, "Buyside liquidity",
     color = color.new(cSell, 55), style = plot.style_linebr, linewidth = 1)
plot(showPools and not na(poolL) ? poolL : na, "Sellside liquidity",
     color = color.new(cBuy, 55), style = plot.style_linebr, linewidth = 1)
plot(showZones and rngOk ? eqm : na, "Equilibrium",
     color = color.new(cDim, 70), style = plot.style_linebr, linewidth = 1)

// The live setup: entry, stop and target, redrawn on one set of objects rather
// than a fresh set per bar - which is what fills a chart's object budget and
// makes the oldest drawings silently vanish.
var line lE = na
var line lS = na
var line lT = na
var label lL = na
if barstate.islast and showLevels
    if not na(lE)
        line.delete(lE)
    if not na(lS)
        line.delete(lS)
    if not na(lT)
        line.delete(lT)
    if not na(lL)
        label.delete(lL)
    live = not na(armBuyB) or not na(armSellB)
    if live
        isB = not na(armBuyB)
        e = isB ? armBuyPx : armSellPx
        sl = isB ? armBuySl : armSellSl
        tp = isB ? armBuyTp : armSellTp
        col = isB ? cBuy : cSell
        lE := line.new(bar_index, e, bar_index + 25, e, color = col, width = 2)
        lS := line.new(bar_index, sl, bar_index + 25, sl,
             color = color.new(cSell, 25), style = line.style_dashed)
        lT := line.new(bar_index, tp, bar_index + 25, tp,
             color = color.new(cBuy, 25), style = line.style_dashed)
        rr = math.abs(e - sl) > 0 ? math.abs(tp - e) / math.abs(e - sl) : 0.0
        lL := label.new(bar_index + 25, e,
             (isB ? "BUY " : "SELL ") + str.tostring(e, format.mintick)
             + "\nSL " + str.tostring(sl, format.mintick)
             + "\nTP " + str.tostring(tp, format.mintick)
             + "\n" + str.tostring(rr, "0.0") + "R",
             style = label.style_label_left, size = size.small,
             color = color.new(chart.bg_color, 90), textcolor = col)

alertcondition(fillBuy,  "SMC BUY",  "SMC BUY {{ticker}} {{interval}}")
alertcondition(fillSell, "SMC SELL", "SMC SELL {{ticker}} {{interval}}")
alertcondition(sweepLo,  "Sellside taken", "Sellside liquidity taken")
alertcondition(sweepHi,  "Buyside taken",  "Buyside liquidity taken")
