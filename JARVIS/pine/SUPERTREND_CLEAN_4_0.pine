//@version=6
// ===========================================================================
//  SUPERTREND CLEAN 4.0  —  the chart for SuperTrendSniper.mq5
//
//  Same visual language as ZONE SNIPER 3.0 so the two charts read the same way:
//  signal label, live stop, a shaded box on every finished trade, one profit box
//  in the corner. Nothing else touches the candles.
//
//  THE CORE, and it is the EA's core, not a lookalike:
//     SIGNAL   a SuperTrend(7, 1.2) flip
//     GATE     the DEMA must be sloping the right way (dema >= dema[2] to buy)
//     STOP     2.0 x ATR(14) from the fill
//     TRAIL    3.0 x ATR(14), armed immediately, ratcheted one way
//     STALL    close a trade that has gone nowhere for 25 bars
//     CEILING  50 bars
//     There is no take profit. InpTargetR ships at 0.
//
//  READ THIS BEFORE YOU TRUST THE GREEN NUMBER
//  -------------------------------------------
//  On 157,051 real M1 bars built from 18,816,940 bid/ask ticks, measured against
//  a matched control:
//     the SuperTrend FLIP as an entry   +0.0021R over control AT ZERO COST,
//                                       1.2 control se. That is nothing.
//     the DEMA gate                     -3.1 control se. WORSE THAN RANDOM.
//     the SuperTrend as a TRAIL          39.6 points vs 11.0 for a fixed
//                                       give-back. This is where it works.
//  E-125/E-126. The band widens in a trend and tightens in chop by construction,
//  which is exactly what an exit rule has to do and what a fixed percentage
//  cannot. SuperTrend was never an entry. It is an exit.
//
//  That is why this chart shows TWO equity lines in the profit box, and the
//  second one is the point of the whole thing:
//     SYSTEM        flip in, stop / trail / stall out    <- what the EA does
//     FLIP & HOLD   flip in, opposite flip out           <- no exit machinery
//  The difference is what the stop, the trail and the stall are actually worth
//  on YOUR data, on YOUR broker, in points. If FLIP & HOLD is beating SYSTEM,
//  the exit machinery is costing you and the chart will say so.
//
//  Nothing here is proof. In the vocabulary of EXPERIMENTS.md the flip entry is
//  REJECTED as a source of edge and the trail is SUPPORTED. A backtest is
//  evidence, never proof, and this chart is not even a backtest - it is a
//  running tally on whatever bars you point it at.
//
//  RUN IT ON XAUUSD. M1, M5 or M15.
// ===========================================================================
indicator("SUPERTREND CLEAN 4.0", overlay = true, max_labels_count = 500,
     max_lines_count = 500, max_boxes_count = 500, max_bars_back = 1000)

gS = "1 · SIGNAL"
stLen   = input.int(7,     "SuperTrend ATR length", group = gS)
stMult  = input.float(1.2, "SuperTrend multiplier", group = gS, step = 0.1)
useDema = input.bool(true, "DEMA slope gate",       group = gS,
     tooltip = "The EA ships with this ON. It measured at -3.1 control se, which is worse than random. Turn it off and watch the profit box.")
demaLen = input.int(0,     "DEMA length (0 = per-clock: 60 on M1, 100 on M3, else 200)",
     group = gS, minval = 0)

gE = "2 · RISK / EXIT"
stopAtr  = input.float(2.0, "Initial stop (ATR)",   group = gE, step = 0.5)
useTrail = input.bool(true, "ATR trail",            group = gE)
trailAtr = input.float(3.0, "Trail distance (ATR)", group = gE, step = 0.5,
     tooltip = "Wide on purpose. Tight trails lost on every market tested.")
useSt    = input.bool(false,"Trail on the SuperTrend band instead", group = gE,
     tooltip = "E-125: the band beat a fixed give-back 39.6 points to 11.0. Worth testing against the ATR trail with the profit box.")
maxStall = input.int(25,    "Close a stalled trade after N bars", group = gE)
maxHold  = input.int(50,    "Absolute ceiling (bars)",           group = gE)

gM = "3 · MONEY"
lots     = input.float(0.01,  "Lots", group = gM, step = 0.01, minval = 0.01)
gbpPoint = input.float(0.787, "GBP per point at 0.01 lots", group = gM, step = 0.001,
     tooltip = "E-081. 0.01 lots on XAUUSD is about GBP 0.787 per point and cannot go lower. This is why the TIMEFRAME sets the risk, not the account.")

gD = "4 · CHART"
cBuy   = input.color(#00B0FF, "Buy",  group = gD, inline = "c")
cSell  = input.color(#FF3B5C, "Sell", group = gD, inline = "c")
showBand  = input.bool(true, "SuperTrend band", group = gD, inline = "s")
showDema  = input.bool(true, "DEMA",            group = gD, inline = "s")
showBoxes = input.bool(true, "Trade boxes",     group = gD, inline = "s")
showPanel = input.bool(true, "Profit box",      group = gD, inline = "s")
panelPos  = input.string("Bottom right", "Profit box position", group = gD,
     options = ["Bottom right", "Top right", "Bottom left"])

// Pine's str.tostring format has no "+x;-x" subpattern, so the sign is explicit.
f_num(x, d) =>
    (x >= 0 ? "+" : "") + str.tostring(x, d)

// ------------------------------------------------------------------ maths --
atr = ta.atr(14)
[stLine, stDir] = ta.supertrend(stMult, stLen)
bull = stDir == -1

// The EA's per-clock DEMA rule, and Pine has no ta.dema, so it is built from
// two EMAs exactly as the EA builds it. Pine's ta.ema is SMA-seeded, which is
// what the EA was changed to in 2.30 - that seeding difference was a real
// source of signal drift before P92.
dLen = demaLen > 0 ? demaLen :
       timeframe.period == "1" ? 60 :
       timeframe.period == "3" ? 100 : 200
e1   = ta.ema(close, dLen)
dema = 2 * e1 - ta.ema(e1, dLen)

flipUp   = bull and not bull[1]
flipDown = not bull and bull[1]
// the EA's gate, verbatim: dema >= dema[2] to buy, dema <= dema[2] to sell
gateBuy  = not useDema or dema >= dema[2]
gateSell = not useDema or dema <= dema[2]

// --------------------------------------------------------- position state ---
var int   posDir   = 0
var float posEntry = na
var float posStop  = na
var int   posBar   = na
var float posPeak  = na      // best price seen, for the trail
var int   stallBar = na      // last bar that made a new best
var float initStop = na      // the stop we opened with, for the exit autopsy

// the shadow book: same entries, no exit machinery at all
var int   shDir    = 0
var float shEntry  = na

// ------------------------------------------------------------ book-keeping --
var int   nTrades = 0
var int   nWins   = 0
var float sumPts  = 0.0
var float shPts   = 0.0      // FLIP & HOLD running total
var float bestPts = 0.0
var float worstPts= 0.0
var float peakEq  = 0.0
var float maxDD   = 0.0
var int   nLong   = 0
var int   nShort  = 0
var float ptsLong = 0.0
var float ptsShort= 0.0
var int   nStop   = 0        // how each trade ended - this is the exit autopsy
var int   nTrail  = 0
var int   nStall  = 0
var int   nAged   = 0
var int   firstT  = 0

buySig  = flipUp   and gateBuy  and barstate.isconfirmed
sellSig = flipDown and gateSell and barstate.isconfirmed

// ---- the shadow book closes only on the opposite flip ----------------------
if shDir != 0 and barstate.isconfirmed and ((shDir > 0 and flipDown) or (shDir < 0 and flipUp))
    shPts += shDir * (close - shEntry)
    shDir := 0
if (buySig or sellSig) and shDir == 0
    shDir   := buySig ? 1 : -1
    shEntry := close

// ---- the real book ---------------------------------------------------------
// E-110: nothing is checked on the entry bar. A bar that gave us the fill must
// not also be allowed to give us the exit.
var float exitPx = na
var string exitWhy = ""
closedNow = false

if posDir != 0 and barstate.isconfirmed and bar_index > posBar
    // track the best excursion, which both the trail and the stall rule need
    newBest = posDir > 0 ? high > posPeak : low < posPeak
    if newBest
        posPeak  := posDir > 0 ? high : low
        stallBar := bar_index

    if useTrail
        cand = useSt ? stLine :
               posDir > 0 ? posPeak - trailAtr * atr : posPeak + trailAtr * atr
        posStop := posDir > 0 ? math.max(posStop, cand) : math.min(posStop, cand)

    hitStop = posDir > 0 ? low <= posStop : high >= posStop
    stalled = bar_index - stallBar >= maxStall
    aged    = bar_index - posBar   >= maxHold
    // an opposite flip is a structural exit and the EA takes it
    flipOut = (posDir > 0 and flipDown) or (posDir < 0 and flipUp)

    if hitStop or stalled or aged or flipOut
        exitPx  := hitStop ? posStop : close
        exitWhy := hitStop ? (posStop == (posDir > 0 ? posEntry - stopAtr * atr : posEntry + stopAtr * atr) ? "stop" : "trail") :
                   flipOut ? "flip" : stalled ? "stall" : "time"
        pts = posDir * (exitPx - posEntry)
        if nTrades == 0
            firstT := time
        nTrades  += 1
        nWins    += pts > 0 ? 1 : 0
        sumPts   += pts
        bestPts  := math.max(bestPts,  pts)
        worstPts := math.min(worstPts, pts)
        peakEq   := math.max(peakEq, sumPts)
        maxDD    := math.max(maxDD, peakEq - sumPts)
        if posDir > 0
            nLong   += 1
            ptsLong += pts
        else
            nShort   += 1
            ptsShort += pts
        if exitWhy == "stop"
            nStop += 1
        else if exitWhy == "trail"
            nTrail += 1
        else if exitWhy == "stall"
            nStall += 1
        else
            nAged += 1

        if showBoxes
            won = pts > 0
            box.new(posBar, math.max(posEntry, exitPx), bar_index, math.min(posEntry, exitPx),
                 border_color = color.new(won ? cBuy : cSell, 40), border_width = 1,
                 bgcolor = color.new(won ? cBuy : cSell, 88))
            label.new(bar_index, posDir > 0 ? math.max(posEntry, exitPx) : math.min(posEntry, exitPx),
                 f_num(pts, "0.0") + " pt  " + exitWhy,
                 style = posDir > 0 ? label.style_label_lower_left : label.style_label_upper_left,
                 color = color.new(chart.bg_color, 100),
                 textcolor = color.new(won ? cBuy : cSell, 0), size = size.tiny)

        posDir   := 0
        posEntry := na
        posStop  := na
        posBar   := na
        closedNow := true

// ---- entries, after the exit block so a flip can close and reopen ----------
takeBuy  = posDir == 0 and buySig
takeSell = posDir == 0 and sellSig
if takeBuy or takeSell
    posDir   := takeBuy ? 1 : -1
    posEntry := close
    posStop  := takeBuy ? close - stopAtr * atr : close + stopAtr * atr
    initStop := posStop
    posBar   := bar_index
    posPeak  := close
    stallBar := bar_index

// ---------------------------------------------------------------- drawing --
bandCol = color.new(bull ? cBuy : cSell, 35)
plot(showBand ? stLine : na, "SuperTrend", color = bandCol, linewidth = 2,
     style = plot.style_linebr)
plot(showDema ? dema : na, "DEMA", color = color.new(#8FA3B8, 55), linewidth = 1)

plotshape(takeBuy,  "BUY",  shape.labelup,   location.belowbar, color = cBuy,
     text = "BUY",  textcolor = color.white, size = size.tiny)
plotshape(takeSell, "SELL", shape.labeldown, location.abovebar, color = cSell,
     text = "SELL", textcolor = color.white, size = size.tiny)
// a flip the DEMA gate refused. Small, hollow, so it never competes with a real
// signal - but visible, because "what did the gate cost me" is the live version
// of the -3.1 control se above.
plotshape(flipUp   and not gateBuy,  "gate refused (buy)",  shape.circle,
     location.belowbar, color = color.new(cBuy, 65),  size = size.tiny)
plotshape(flipDown and not gateSell, "gate refused (sell)", shape.circle,
     location.abovebar, color = color.new(cSell, 65), size = size.tiny)

plot(posDir != 0 ? posStop : na, "Live stop",
     color = color.new(posDir > 0 ? cSell : cBuy, 20), style = plot.style_linebr, linewidth = 2)

bgTop = posDir != 0 ? math.max(posEntry, close) : na
bgBot = posDir != 0 ? math.min(posEntry, close) : na
pA = plot(bgTop, "", color = color.new(color.gray, 100), display = display.none)
pB = plot(bgBot, "", color = color.new(color.gray, 100), display = display.none)
livePts = posDir != 0 ? posDir * (close - posEntry) : na
fill(pA, pB, color = color.new(nz(livePts) >= 0 ? cBuy : cSell, 90), title = "Open position")

// ============================== THE PROFIT BOX =============================
var table tp = na

f_row(r, a, b, c, col) =>
    table.cell(tp, 0, r, a, text_color = color.new(#8FA3B8, 0), text_size = size.small,
         text_halign = text.align_left)
    table.cell(tp, 1, r, b, text_color = col, text_size = size.small,
         text_halign = text.align_right)
    table.cell(tp, 2, r, c, text_color = color.new(#8FA3B8, 25), text_size = size.tiny,
         text_halign = text.align_right)

if barstate.islast and showPanel
    if not na(tp)
        table.delete(tp)
    pos = panelPos == "Top right" ? position.top_right :
          panelPos == "Bottom left" ? position.bottom_left : position.bottom_right
    tp := table.new(pos, 3, 13, border_width = 1,
         bgcolor = color.new(#0E1621, 8), border_color = color.new(#2A3A4D, 40),
         frame_color = color.new(#2A3A4D, 20), frame_width = 1)

    cVal  = color.new(#E6EDF5, 0)
    cPos  = color.new(cBuy, 0)
    cNeg  = color.new(cSell, 0)
    winPc = nTrades > 0 ? 100.0 * nWins / nTrades : 0.0
    money = sumPts * gbpPoint * lots / 0.01
    avg   = nTrades > 0 ? sumPts / nTrades : 0.0
    days  = nTrades > 0 ? math.max(1.0, (time - firstT) / 86400000.0) : 1.0

    table.cell(tp, 0, 0, "SUPERTREND 4.0", text_color = cVal, text_size = size.small,
         text_halign = text.align_left)
    table.cell(tp, 1, 0, "", text_color = cVal)
    table.cell(tp, 2, 0, posDir == 0 ? (bull ? "bull · flat" : "bear · flat") :
         posDir > 0 ? "LONG" : "SHORT",
         text_color = posDir == 0 ? color.new(#8FA3B8, 0) : posDir > 0 ? cPos : cNeg,
         text_size = size.tiny, text_halign = text.align_right)

    f_row(1, "points",    f_num(sumPts, "0.0"),
             f_num(money, "0.00") + " GBP", sumPts >= 0 ? cPos : cNeg)
    f_row(2, "trades",    str.tostring(nTrades),
             str.tostring(nTrades / days, "0.0") + "/day", cVal)
    f_row(3, "win rate",  str.tostring(winPc, "0.0") + "%",
             str.tostring(nWins) + "W " + str.tostring(nTrades - nWins) + "L", cVal)
    f_row(4, "avg trade", f_num(avg, "0.000"), "points", avg >= 0 ? cPos : cNeg)

    table.cell(tp, 0, 5, "── is the exit paying? ──", text_color = color.new(#5C7089, 0),
         text_size = size.tiny, text_halign = text.align_left)
    table.cell(tp, 1, 5, "", text_color = cVal)
    table.cell(tp, 2, 5, "", text_color = cVal)

    f_row(6, "SYSTEM",       f_num(sumPts, "0.0"), "stop/trail/stall", sumPts >= 0 ? cPos : cNeg)
    f_row(7, "FLIP & HOLD",  f_num(shPts,  "0.0"), "flip to flip",     shPts  >= 0 ? cPos : cNeg)
    f_row(8, "exit adds",    f_num(sumPts - shPts, "0.0"), "points",
             sumPts - shPts >= 0 ? cPos : cNeg)

    table.cell(tp, 0, 9, "── how trades ended ──", text_color = color.new(#5C7089, 0),
         text_size = size.tiny, text_halign = text.align_left)
    table.cell(tp, 1, 9, "", text_color = cVal)
    table.cell(tp, 2, 9, "", text_color = cVal)

    f_row(10, "stop / trail", str.tostring(nStop) + " / " + str.tostring(nTrail), "", cVal)
    f_row(11, "stall / time", str.tostring(nStall) + " / " + str.tostring(nAged), "", cVal)
    f_row(12, "max drawdown", f_num(-maxDD, "0.0"),
              str.tostring(-maxDD * gbpPoint * lots / 0.01, "0.00") + " GBP", cNeg)

plot(posDir, "Position (1 long, -1 short)", display = display.status_line)
plot(posDir != 0 ? posEntry : na, "Entry",  display = display.status_line)
plot(livePts, "Open points",                display = display.status_line)
plot(bull ? 1 : -1, "SuperTrend (1 bull)",  display = display.status_line)
plot(dema, "DEMA",                          display = display.status_line)
plot(atr,  "ATR(14)",                       display = display.status_line)

alertcondition(takeBuy,   "ST BUY",   "SuperTrend 4.0 BUY")
alertcondition(takeSell,  "ST SELL",  "SuperTrend 4.0 SELL")
alertcondition(closedNow, "ST CLOSE", "SuperTrend 4.0 trade closed")
