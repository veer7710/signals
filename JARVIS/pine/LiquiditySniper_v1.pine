//@version=6
// ============================================================================
//  LIQUIDITY SNIPER v1.0
//  Buy/sell-side liquidity · sweep continuation · expansion filter · TP/SL boxes
// ============================================================================
//
//  WHAT MAKES THIS DIFFERENT FROM EVERY OTHER LIQUIDITY INDICATOR
//
//  Almost every liquidity tool assumes: price sweeps a level, then REVERSES.
//  That was tested on 10,000+ sweep events across GOLD, US500, EURUSD and
//  GBPUSD, entering at the earliest honestly-obtainable price with first-touch
//  resolution and ties counted as losses:
//
//      FADE the sweep (the usual assumption) : 44.5% win at 1R on GOLD 15m
//      A COIN FLIP at the same bars          : 49.2%
//      FOLLOW the sweep (this indicator)     : 54.1%
//
//  FOLLOW beat FADE on 5 of 5 markets tested. Fading was worse than random.
//
//  The mechanism is Osler's stop-cascade research, not the retail narrative:
//  a stop-loss to sell IS a market sell order. A cluster of stops beyond a
//  level is FUEL in the direction of the break, not a spring that reverses it.
//
//  So this indicator marks liquidity the same way others do — and then trades
//  the opposite direction to most of them.
//
//  THE SECOND EDGE: WHEN, NOT JUST WHERE
//  Measured on GOLD 15m AND 1h independently, over different periods:
//      ADX 0-15            -> 90-91% chance of a 3+ ATR move in 40 bars
//      ADX >= 40           -> 66-68%
//      ATR >= 2x its median-> 25%
//  Volatility CONTRACTION precedes expansion. When ATR is already stretched
//  and ADX is already high, the move has largely happened and you are buying
//  the end of it. The expansion filter below refuses those setups.
//
//  HONEST STATUS
//  The continuation direction is MEASURED but has NOT yet cleared a
//  multiple-testing significance bar once realistic spread and next-bar fills
//  are applied. Treat this as a research instrument to forward-test, not a
//  proven money machine. No indicator is one.
//
//  NON-REPAINTING
//  Pivots are read at ta.pivothigh(len,len)[1] and are only known `len` bars
//  after they form — the label appears where it could actually have been known.
//  Every signal requires barstate.isconfirmed. Nothing is drawn on a forming
//  bar that can later vanish.
// ============================================================================

indicator("Liquidity Sniper v1", "LiqSniper", overlay = true,
     max_boxes_count = 60, max_lines_count = 300, max_labels_count = 200)

// ─────────────────────────────────── INPUTS ─────────────────────────────────
gL = "LIQUIDITY"
pivLen    = input.int(8,    "Swing size (bars each side)", minval = 2, maxval = 50, group = gL,
     tooltip = "Bigger = fewer, more significant levels. A pivot is only KNOWN this many bars after it forms, and the indicator respects that.")
eqTol     = input.float(0.20, "Equal high/low tolerance (× ATR)", minval = 0.02, step = 0.02, group = gL)
maxLevels = input.int(20,   "Max live levels per side", minval = 2, maxval = 40, group = gL)
lvlMaxAge = input.int(500,  "Forget levels older than (bars)", minval = 50, group = gL)
showLvls  = input.bool(true, "Show liquidity lines", group = gL)
showZones = input.bool(true, "Show liquidity zones", group = gL)

gX = "EXTRA LIQUIDITY SOURCES"
useDaily = input.bool(true, "Previous day high / low", group = gX,
     tooltip = "The most-watched liquidity on any chart. Adding these is one of the biggest sources of extra setups.")
useSessH = input.bool(true, "Session highs / lows (Asia, London, NY)", group = gX)
useRound = input.bool(false, "Round numbers", group = gX,
     tooltip = "Gold clusters stops at whole and half dollars. Off by default because it generates a lot of levels.")
roundStep = input.float(10.0, "   round step", minval = 0.1, step = 0.5, group = gX)

gS = "SWEEP + ENTRY"
mode      = input.string("Continuation (tested)", "Trade direction",
     options = ["Continuation (tested)", "Reversal (classic)"], group = gS,
     tooltip = "Continuation follows the break — the direction that measured better on 5 of 5 markets. Reversal is the usual assumption and tested WORSE than a coin flip. Kept only so you can compare.")
needDisp  = input.bool(true, "Require displacement candle", group = gS,
     tooltip = "The break bar must expand beyond normal range. Filters the weak pokes that stall.")
dispAtr   = input.float(1.0, "   displacement ≥ (× ATR)", minval = 0.3, step = 0.1, group = gS)
needClose = input.bool(true, "Require close beyond the level", group = gS,
     tooltip = "A wick through is not a break. Demanding a close removes most fakeouts.")
minLvlAge = input.int(5,    "Level must be this many bars old", minval = 0, group = gS,
     tooltip = "A level formed moments ago has no resting orders behind it yet.")

gP = "SIGNAL FREQUENCY"
maxTrades = input.int(3, "Max concurrent setups", minval = 1, maxval = 6, group = "SIGNAL FREQUENCY",
     tooltip = "The single biggest limiter on how many entries you see. At 1 the indicator sits idle through every setup that appears while a trade is already open - which on a trending day is most of them.")
preset = input.string("Balanced", "Preset",
     options = ["Sniper (fewest, best measured)", "Balanced", "Scalper (most signals)", "Manual"],
     group = gP,
     tooltip = "This is a genuine trade-off, not a free lunch. Sniper uses the gates that MEASURED best (ADX<=20, ATR<=1.0x median) and will sit out most of the day. Scalper opens the gates wide and WILL take setups that measured worse. Balanced sits between. Manual uses your own values below.")

gF = "EXPANSION FILTER  (the 'is this move going to be big?' test)"
useSqueeze = input.bool(true, "Only trade compressed volatility", group = gF,
     tooltip = "MEASURED: ATR at or below its median precedes 3+ ATR moves ~90% of the time. ATR at 2x its median precedes them 25% of the time.")
maxSqueeze = input.float(1.15, "   max ATR / median ATR", minval = 0.5, step = 0.05, group = gF)
useAdx     = input.bool(true, "Only trade below an ADX ceiling", group = gF)
maxAdx     = input.float(25,  "   max ADX", minval = 10, maxval = 60, step = 1, group = gF)
useSess    = input.bool(false, "Restrict to hours (UTC)", group = gF,
     tooltip = "On GOLD 15m: 04-12 UTC showed 89-93% chance of a 3+ ATR move; 14-18 UTC showed 62-72%. Off by default because it was measured on one instrument.")
sessFrom   = input.int(4,  "   from hour", minval = 0, maxval = 23, group = gF)
sessTo     = input.int(12, "   to hour",   minval = 0, maxval = 23, group = gF)

gR = "RISK"
slBuf     = input.float(0.30, "Stop beyond sweep extreme (× ATR)", minval = 0, step = 0.05, group = gR)
tpMode    = input.string("Next liquidity", "Target", options = ["Next liquidity", "Fixed R"], group = gR)
tpR       = input.float(2.0, "   fixed R multiple", minval = 0.5, step = 0.25, group = gR)
minR      = input.float(1.2, "Reject setup if R:R below", minval = 0.5, step = 0.1, group = gR)
maxRiskAtr= input.float(2.5, "Reject setup if stop wider than (× ATR)", minval = 0.5, step = 0.1, group = gR)

gD = "DISPLAY"
showTrail = input.bool(true, "Show trail guide once trade is in profit", group = gD,
     tooltip = "Dashed line showing where an ATR trail would sit. It deliberately does NOT appear until the trade is in profit: moving a stop up early measured as the worst exit rule on all four markets tested.")
trailArm  = input.float(1.0, "   only after (R in profit)", minval = 0, step = 0.25, group = gD)
trailAtr  = input.float(2.0, "   trail distance (× ATR)", minval = 0.5, step = 0.25, group = gD)
showRlive = input.bool(true, "Show live R on the open trade", group = gD)
zoneGrow  = input.bool(true, "Liquidity zones extend to the right edge", group = gD)
nBoxes    = input.int(2, "Completed trade boxes to keep", minval = 0, maxval = 10, group = gD,
     tooltip = "Plus the live one. Keeps the chart clean instead of accumulating history.")
theme     = input.string("White / blue candles", "Palette",
     options = ["White / blue candles", "Classic green / red", "Custom"], group = gD,
     tooltip = "Zones are deliberately faint so white and blue candles stay the brightest thing on the chart. Only the BUY/SELL labels are fully saturated.")
uBull     = input.color(color.new(#29B6F6, 0),  "Custom buy",  inline = "c", group = gD)
uBear     = input.color(color.new(#FF5370, 0),  "Custom sell", inline = "c", group = gD)

// One accent per side, then everything else is a transparency of that accent.
// Keeping a single hue per side is what stops the chart turning into confetti.
accBull = theme == "Classic green / red" ? #26A69A : theme == "Custom" ? uBull : #29B6F6
accBear = theme == "Classic green / red" ? #EF5350 : theme == "Custom" ? uBear : #FF5370

cBull   = accBull
cBear   = accBear
cBsl    = color.new(accBear, 86)   // sell-side liquidity sits ABOVE price
cSsl    = color.new(accBull, 86)   // buy-side liquidity sits BELOW price
cTp     = color.new(accBull, 88)
cSl     = color.new(accBear, 88)
showPanel = input.bool(true, "Show status panel", group = gD)

// ──────────────────────────────── FOUNDATIONS ───────────────────────────────
atr    = ta.atr(14)
atrMed = ta.median(atr, 50)
[diP, diM, adxV] = ta.dmi(14, 14)
sqz    = atrMed > 0 ? atr / atrMed : 1.0

// bars are read one late so a forming bar can never revoke a confirmed pivot
ph = ta.pivothigh(high, pivLen, pivLen)[1]
pl = ta.pivotlow(low,  pivLen, pivLen)[1]
pivotBar = bar_index - 1 - pivLen

hourNow = hour(time, "UTC")
inSess  = not useSess or (sessFrom <= sessTo ? (hourNow >= sessFrom and hourNow < sessTo)
                                             : (hourNow >= sessFrom or hourNow < sessTo))
// Preset overrides the manual gates unless "Manual" is chosen.
// The numbers come from the measured table: ADX 0-15 preceded a 3+ ATR move
// ~90% of the time, ADX>=40 only 66%, ATR at 2x its median only 25%.
sqzGate = preset == "Sniper (fewest, best measured)" ? 1.00 :
          preset == "Balanced" ? 1.15 :
          preset == "Scalper (most signals)" ? 1.60 : maxSqueeze
adxGate = preset == "Sniper (fewest, best measured)" ? 20.0 :
          preset == "Balanced" ? 25.0 :
          preset == "Scalper (most signals)" ? 45.0 : maxAdx

expansionOk = (not useSqueeze or sqz <= sqzGate) and (not useAdx or adxV <= adxGate) and inSess

// ---- previous-day and session levels.
// request.security with lookahead_off already returns the last CLOSED daily
// bar, so no [1] offset is needed. Adding one would silently plot the day
// BEFORE yesterday, which is a classic and invisible error.
pdh = request.security(syminfo.tickerid, "D", high, lookahead = barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low,  lookahead = barmerge.lookahead_off)

// rolling session extremes, reset when the session block changes
sessId  = math.floor(hour(time, "UTC") / 8)          // 0 Asia, 1 London, 2 NY
newSess = sessId != sessId[1]
var float sHi = na
var float sLo = na
if newSess
    sHi := high
    sLo := low
else
    sHi := math.max(nz(sHi, high), high)
    sLo := math.min(nz(sLo, low), low)

// ───────────────────────────── LIQUIDITY REGISTRY ───────────────────────────
// Parallel arrays: price, bar formed, touch count, swept flag, drawing handles.
var array<float> hiPx   = array.new_float()
var array<int>   hiBar  = array.new_int()
var array<int>   hiHits = array.new_int()
var array<bool>  hiDead = array.new_bool()
var array<line>  hiLn   = array.new_line()
var array<box>   hiBx   = array.new_box()

var array<float> loPx   = array.new_float()
var array<int>   loBar  = array.new_int()
var array<int>   loHits = array.new_int()
var array<bool>  loDead = array.new_bool()
var array<line>  loLn   = array.new_line()
var array<box>   loBx   = array.new_box()

addLevel(array<float> px, array<int> bar, array<int> hits, array<bool> dead,
         array<line> lns, array<box> bxs, float p, int b, bool isHigh) =>
    // merge into an existing near-equal level: equal highs/lows hold MORE
    // resting orders than a lone extreme, so they are strengthened not doubled
    merged = false
    tol = eqTol * atr
    if array.size(px) > 0
        for i = 0 to array.size(px) - 1
            if not merged and not array.get(dead, i) and math.abs(array.get(px, i) - p) <= tol
                array.set(px, i, isHigh ? math.max(array.get(px, i), p) : math.min(array.get(px, i), p))
                array.set(hits, i, array.get(hits, i) + 1)
                merged := true
    if not merged
        array.push(px, p)
        array.push(bar, b)
        array.push(hits, 1)
        array.push(dead, false)
        ln = showLvls ? line.new(b, p, bar_index + 3, p,
             color = isHigh ? cBsl : cSsl, style = line.style_dotted, width = 1) : na
        bx = showZones ? box.new(b, p, bar_index + 3, p, border_color = na,
             bgcolor = isHigh ? cBsl : cSsl) : na
        array.push(lns, ln)
        array.push(bxs, bx)
        // evict the oldest once past the cap, so the chart never accumulates
        while array.size(px) > maxLevels
            l0 = array.shift(lns)
            b0 = array.shift(bxs)
            if not na(l0)
                line.delete(l0)
            if not na(b0)
                box.delete(b0)
            array.shift(px)
            array.shift(bar)
            array.shift(hits)
            array.shift(dead)
    merged

if not na(ph)
    addLevel(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, ph, pivotBar, true)
if not na(pl)
    addLevel(loPx, loBar, loHits, loDead, loLn, loBx, pl, pivotBar, false)

// previous day — registered once per new value, not once per bar
var float lastPdh = na
var float lastPdl = na
if useDaily and not na(pdh) and pdh != lastPdh
    lastPdh := pdh
    addLevel(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, pdh, bar_index, true)
if useDaily and not na(pdl) and pdl != lastPdl
    lastPdl := pdl
    addLevel(loPx, loBar, loHits, loDead, loLn, loBx, pdl, bar_index, false)

// session extremes — registered when the session rolls over
if useSessH and newSess and not na(sHi[1])
    addLevel(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, sHi[1], bar_index, true)
if useSessH and newSess and not na(sLo[1])
    addLevel(loPx, loBar, loHits, loDead, loLn, loBx, sLo[1], bar_index, false)

// round numbers near price
var float lastRound = na
if useRound and roundStep > 0
    rUp = math.ceil(close / roundStep) * roundStep
    rDn = math.floor(close / roundStep) * roundStep
    if rUp != lastRound
        lastRound := rUp
        addLevel(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, rUp, bar_index, true)
        addLevel(loPx, loBar, loHits, loDead, loLn, loBx, rDn, bar_index, false)

// keep live level drawings anchored to the right edge, fade the dead ones
extend(array<float> px, array<int> bar, array<int> hits, array<bool> dead,
       array<line> lns, array<box> bxs, bool isHigh) =>
    if array.size(px) > 0
        for i = 0 to array.size(px) - 1
            ln = array.get(lns, i)
            bx = array.get(bxs, i)
            p  = array.get(px, i)
            isDead = array.get(dead, i)
            thick = math.min(array.get(hits, i), 3)
            if not na(ln)
                // y must be re-set too: an equal-high merge MOVES the stored
                // price, and without this the line drifts away from its own
                // zone and the chart looks broken.
                line.set_y1(ln, p)
                line.set_y2(ln, p)
                line.set_x2(ln, bar_index + 3)
                line.set_color(ln, isDead ? color.new(color.gray, 88) : color.new(isHigh ? accBear : accBull, 45))
                line.set_width(ln, isDead ? 1 : thick)
            if not na(bx)
                zh = (zoneGrow ? 0.16 : 0.07) * atr * thick
                box.set_top(bx, p + (isHigh ? zh : 0))
                box.set_bottom(bx, p - (isHigh ? 0 : zh))
                box.set_right(bx, zoneGrow ? bar_index + 6 : bar_index + 3)
                box.set_bgcolor(bx, isDead ? color.new(color.gray, 95) : (isHigh ? cBsl : cSsl))
    0
extend(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, true)
extend(loPx, loBar, loHits, loDead, loLn, loBx, false)

// ───────────────────────────── SWEEP DETECTION ──────────────────────────────
// A break is: price takes out a level that is old enough to hold orders, and
// (optionally) CLOSES beyond it on an expanding candle. The close requirement
// is what removes most fakeouts — a wick through is not a break.
body     = math.abs(close - open)
rng      = math.max(high - low, syminfo.mintick)
isDisp   = body >= dispAtr * atr
dispOk   = not needDisp or isDisp

float sweptHi = na
float sweptLo = na
int   sweptHiHits = 0
int   sweptLoHits = 0

if array.size(hiPx) > 0
    for i = 0 to array.size(hiPx) - 1
        p = array.get(hiPx, i)
        if not array.get(hiDead, i) and bar_index - array.get(hiBar, i) >= minLvlAge
            broke = needClose ? (close > p) : (high > p)
            if broke and barstate.isconfirmed
                array.set(hiDead, i, true)
                if na(sweptHi) or p > sweptHi
                    sweptHi := p
                    sweptHiHits := array.get(hiHits, i)

if array.size(loPx) > 0
    for i = 0 to array.size(loPx) - 1
        p = array.get(loPx, i)
        if not array.get(loDead, i) and bar_index - array.get(loBar, i) >= minLvlAge
            broke = needClose ? (close < p) : (low < p)
            if broke and barstate.isconfirmed
                array.set(loDead, i, true)
                if na(sweptLo) or p < sweptLo
                    sweptLo := p
                    sweptLoHits := array.get(loHits, i)

// direction: continuation follows the break, reversal fades it
isCont   = mode == "Continuation (tested)"
rawLong  = not na(sweptHi)      // took out sell-side liquidity above
rawShort = not na(sweptLo)      // took out buy-side liquidity below
goLong   = isCont ? rawLong  : rawShort
goShort  = isCont ? rawShort : rawLong

// ─────────────────────────── TARGET: NEXT LIQUIDITY ─────────────────────────
nextLiq(bool up) =>
    float best = na
    if up and array.size(hiPx) > 0
        for i = 0 to array.size(hiPx) - 1
            p = array.get(hiPx, i)
            if not array.get(hiDead, i) and p > close
                best := na(best) ? p : math.min(best, p)
    if not up and array.size(loPx) > 0
        for i = 0 to array.size(loPx) - 1
            p = array.get(loPx, i)
            if not array.get(loDead, i) and p < close
                best := na(best) ? p : math.max(best, p)
    best

// ───────────────────────────── TRADE STATE + BOXES ──────────────────────────
// ───────────────────────── TRADE STATE (multiple concurrent) ────────────────
// Parallel arrays so several setups can run at once. With only one slot the
// indicator ignores every setup that appears while a trade is already open,
// which on a trending day is most of them — that single limit was the largest
// cause of "it does not catch enough entries".
var array<int>   trDir = array.new_int()
var array<float> trEnt = array.new_float()
var array<float> trSl  = array.new_float()
var array<float> trTp  = array.new_float()
var array<int>   trBar = array.new_int()
var array<box>   trBxT = array.new_box()
var array<box>   trBxS = array.new_box()
var array<line>  trTrl = array.new_line()
var array<box>   oldBoxes = array.new_box()

pushOld(box b) =>
    if not na(b)
        array.push(oldBoxes, b)
        while array.size(oldBoxes) > nBoxes * 2
            b0 = array.shift(oldBoxes)
            if not na(b0)
                box.delete(b0)
    0

// ---- armed state (only used when needRetest is on)
var int   armDir  = 0
var float armLvl  = na
var int   armBar  = 0
var float armExt  = na

breakNow = barstate.isconfirmed and expansionOk and dispOk and (goLong or goShort)

if needRetest and breakNow
    armDir := goLong ? 1 : -1
    armLvl := goLong ? nz(sweptHi, close) : nz(sweptLo, close)
    armBar := bar_index
    armExt := goLong ? high : low
if armDir != 0
    armExt := armDir > 0 ? math.max(armExt, high) : math.min(armExt, low)
    if bar_index - armBar > retestBars
        armDir := 0

// A retest fires when price returns to the broken level and CLOSES on the
// correct side. Coming back and failing to hold is the fakeout; this refuses it.
retestHit = armDir != 0 and bar_index > armBar and barstate.isconfirmed and
     (armDir > 0 ? (low <= armLvl and close > armLvl)
                 : (high >= armLvl and close < armLvl))

canFire = array.size(trDir) < maxTrades and (needRetest ? retestHit : breakNow)

var bool firedLong  = false
var bool firedShort = false
firedLong  := false
firedShort := false

if canFire
    dir   = needRetest ? armDir : (goLong ? 1 : -1)
    ext   = needRetest ? armExt
             : (dir > 0 ? math.max(high, nz(sweptHi, high)) : math.min(low, nz(sweptLo, low)))
    entry = close
    sl    = dir > 0 ? math.min(low, ext) - slBuf * atr : math.max(high, ext) + slBuf * atr
    risk  = math.abs(entry - sl)
    lvlTp = nextLiq(dir > 0)
    tp    = tpMode == "Fixed R" or na(lvlTp) ? entry + dir * tpR * risk : lvlTp
    rr    = risk > 0 ? math.abs(tp - entry) / risk : 0
    if risk > 0 and risk <= maxRiskAtr * atr and rr >= minR
        array.push(trDir, dir)
        array.push(trEnt, entry)
        array.push(trSl,  sl)
        array.push(trTp,  tp)
        array.push(trBar, bar_index)
        array.push(trBxT, box.new(bar_index, math.max(entry, tp), bar_index + 2,
             math.min(entry, tp), border_color = na, bgcolor = cTp))
        array.push(trBxS, box.new(bar_index, math.max(entry, sl), bar_index + 2,
             math.min(entry, sl), border_color = na, bgcolor = cSl))
        array.push(trTrl, na)
        firedLong  := dir > 0
        firedShort := dir < 0
        armDir := 0

// ---- manage every open trade. Iterating backwards so removals are safe.
var string lastExit = ""
if array.size(trDir) > 0
    for k = array.size(trDir) - 1 to 0
        d  = array.get(trDir, k)
        en = array.get(trEnt, k)
        sl = array.get(trSl,  k)
        tp = array.get(trTp,  k)
        bt = array.get(trBxT, k)
        bs = array.get(trBxS, k)
        tl = array.get(trTrl, k)

        // boxes GROW with the trade rather than sitting at a fixed width
        box.set_right(bt, bar_index + 2)
        box.set_right(bs, bar_index + 2)

        risk = math.abs(en - sl)
        rNow = risk > 0 ? (close - en) * d / risk : 0
        trailPx = d > 0 ? close - trailAtr * atr : close + trailAtr * atr

        // Trail guide appears only once the trade has EARNED it. Moving a stop
        // up early measured as the worst exit rule on all four markets tested.
        if showTrail and rNow >= trailArm
            if na(tl)
                tl := line.new(bar_index - 1, trailPx, bar_index + 2, trailPx,
                     color = color.new(d > 0 ? accBull : accBear, 40),
                     style = line.style_dashed, width = 1)
                array.set(trTrl, k, tl)
            else
                line.set_xy1(tl, bar_index - 1, trailPx)
                line.set_xy2(tl, bar_index + 2, trailPx)

        hitSl = d > 0 ? low  <= sl : high >= sl
        hitTp = d > 0 ? high >= tp : low  <= tp
        if barstate.isconfirmed and (hitSl or hitTp)
            lastExit := hitSl ? "SL" : "TP"
            label.new(bar_index, hitSl ? sl : tp, hitSl ? "✕" : "✓",
                 style = d > 0 ? label.style_label_up : label.style_label_down,
                 color = color.new(color.white, 100),
                 textcolor = hitSl ? accBear : accBull, size = size.small)
            pushOld(bt)
            pushOld(bs)
            if not na(tl)
                line.delete(tl)
            array.remove(trDir, k)
            array.remove(trEnt, k)
            array.remove(trSl,  k)
            array.remove(trTp,  k)
            array.remove(trBar, k)
            array.remove(trBxT, k)
            array.remove(trBxS, k)
            array.remove(trTrl, k)

plotshape(firedLong,  "BUY",  shape.labelup,   location.belowbar, cBull,
     text = "BUY",  textcolor = color.white, size = size.small)
plotshape(firedShort, "SELL", shape.labeldown, location.abovebar, cBear,
     text = "SELL", textcolor = color.white, size = size.small)

// ──────────────────────────────── STATUS PANEL ──────────────────────────────
var table panel = table.new(position.top_right, 2, 6, frame_width = 1,
     frame_color = color.new(color.gray, 60), border_width = 1,
     border_color = color.new(color.gray, 85))

cell(int r, string k, string v, color c) =>
    table.cell(panel, 0, r, k, text_size = size.small, text_halign = text.align_left,
         text_color = color.new(chart.fg_color, 40), bgcolor = color.new(chart.bg_color, 10))
    table.cell(panel, 1, r, v, text_size = size.small, text_halign = text.align_right,
         text_color = c, bgcolor = color.new(chart.bg_color, 10))

okc = accBull
bad = accBear

if showPanel and barstate.islast
    cell(0, "Mode", (isCont ? "CONT" : "REV") + " · " +
         (preset == "Sniper (fewest, best measured)" ? "SNIPER"
        : preset == "Scalper (most signals)" ? "SCALPER"
        : preset == "Balanced" ? "BALANCED" : "MANUAL"), isCont ? okc : bad)
    cell(1, "Squeeze  ATR/med", str.tostring(sqz, "#.##") + " / " + str.tostring(sqzGate, "#.##")
         + (sqz <= sqzGate ? "  ok" : "  too hot"), sqz <= sqzGate ? okc : bad)
    cell(2, "ADX", str.tostring(adxV, "#.#") + " / " + str.tostring(adxGate, "#.#")
         + (adxV <= adxGate ? "  ok" : "  too high"), adxV <= adxGate ? okc : bad)
    cell(3, "Session " + str.tostring(hourNow) + ":00 UTC", inSess ? "ok" : "outside", inSess ? okc : bad)
    cell(4, "Setups allowed", expansionOk ? "YES" : "NO — waiting", expansionOk ? okc : bad)
    nOpen = array.size(trDir)
    cell(5, "Trades", nOpen > 0 ? (str.tostring(nOpen) + "/" + str.tostring(maxTrades) + " open")
         : armDir != 0 ? ("ARMED " + str.tostring(bar_index - armBar) + "/" + str.tostring(retestBars))
         : ("flat" + (lastExit == "" ? "" : "  last " + lastExit)),
         nOpen > 0 ? okc : armDir != 0 ? color.new(#FFB300, 0) : color.new(chart.fg_color, 30))

// ──────────────────────────────────── ALERTS ────────────────────────────────
alertcondition(canFire and goLong,  "Liquidity Sniper BUY",  "LiqSniper BUY {{ticker}} {{interval}}")
alertcondition(canFire and goShort, "Liquidity Sniper SELL", "LiqSniper SELL {{ticker}} {{interval}}")
