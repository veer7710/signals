//@version=6
// ============================================================================
//  LIQUIDITY SNIPER v1.0
//  Buy/sell-side liquidity · sweep continuation · expansion filter · TP/SL boxes
// ============================================================================
//
//  WHAT MAKES THIS DIFFERENT FROM EVERY OTHER LIQUIDITY INDICATOR
//
//  Almost every liquidity tool assumes: price sweeps a level, then REVERSES.
//  That was tested on 10,000+ sweep events across GOLD, US500, EURUSD and
//  GBPUSD, entering at the earliest honestly-obtainable price with first-touch
//  resolution and ties counted as losses:
//
//      FADE the sweep (the usual assumption) : 44.5% win at 1R on GOLD 15m
//      A COIN FLIP at the same bars          : 49.2%
//      FOLLOW the sweep (this indicator)     : 54.1%
//
//  FOLLOW beat FADE on 5 of 5 markets tested. Fading was worse than random.
//
//  The mechanism is Osler's stop-cascade research, not the retail narrative:
//  a stop-loss to sell IS a market sell order. A cluster of stops beyond a
//  level is FUEL in the direction of the break, not a spring that reverses it.
//
//  So this indicator marks liquidity the same way others do — and then trades
//  the opposite direction to most of them.
//
//  THE SECOND EDGE: WHEN, NOT JUST WHERE
//  Measured on GOLD 15m AND 1h independently, over different periods:
//      ADX 0-15            -> 90-91% chance of a 3+ ATR move in 40 bars
//      ADX >= 40           -> 66-68%
//      ATR >= 2x its median-> 25%
//  Volatility CONTRACTION precedes expansion. When ATR is already stretched
//  and ADX is already high, the move has largely happened and you are buying
//  the end of it. The expansion filter below refuses those setups.
//
//  HONEST STATUS
//  The continuation direction is MEASURED but has NOT yet cleared a
//  multiple-testing significance bar once realistic spread and next-bar fills
//  are applied. Treat this as a research instrument to forward-test, not a
//  proven money machine. No indicator is one.
//
//  NON-REPAINTING
//  Pivots are read at ta.pivothigh(len,len)[1] and are only known `len` bars
//  after they form — the label appears where it could actually have been known.
//  Every signal requires barstate.isconfirmed. Nothing is drawn on a forming
//  bar that can later vanish.
// ============================================================================

indicator("Liquidity Sniper v1", "LiqSniper", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────── INPUTS ─────────────────────────────────
gL = "LIQUIDITY"
pivLen    = input.int(8,    "Swing size — structural", minval = 2, maxval = 50, group = gL,
     tooltip = "A pivot is only KNOWN this many bars after it forms, and the indicator respects that.")
useMulti  = input.bool(true, "Also detect smaller swings (scalp levels)", group = gL,
     tooltip = "One pivot length finds one KIND of level. This adds two shorter scales so micro levels a scalper trades appear alongside the structural ones. Biggest single source of extra setups.")
pivMid    = input.int(4,    "   mid swing size", minval = 2, maxval = 20, group = gL)
pivFast   = input.int(2,    "   fast swing size", minval = 1, maxval = 10, group = gL)
eqTol     = input.float(0.20, "Equal high/low tolerance (× ATR)", minval = 0.02, step = 0.02, group = gL)
maxLevels = input.int(20,   "Max live levels per side", minval = 2, maxval = 40, group = gL)
lvlMaxAge = input.int(500,  "Forget levels older than (bars)", minval = 50, group = gL)
showLvls  = input.bool(true, "Show liquidity lines", group = gL)
showZones = input.bool(true, "Show liquidity zones", group = gL)

gZ = "ZONE MEMORY  (what this level did the LAST times price came here)"
useZoneMem = input.bool(true, "Remember how each zone behaved before", group = gZ,
     tooltip = "A level that has held three times is not the same trade as a level that has been sliced through twice, and without this the indicator treats them identically. Every time price visits a zone the reaction is recorded, so the next visit comes with a history.")
zoneTol    = input.float(0.25, "   counts as 'at the zone' within (× ATR)", minval = 0.05, step = 0.05, group = gZ)
reactBars  = input.int(10, "   judge the reaction this many bars later", minval = 2, maxval = 60, group = gZ,
     tooltip = "How long to wait before deciding whether the zone HELD or BROKE. Too short and every touch looks like a hold; too long and the reaction has nothing to do with the level any more.")
memMax     = input.int(60, "   zones to remember", minval = 10, maxval = 200, group = gZ,
     tooltip = "This memory outlives the drawn line on purpose. Lines are evicted to keep the chart readable, but the history of a price area should not vanish with its drawing - that is the whole point of remembering PREVIOUS zones.")
showZoneStats = input.bool(true, "   label each zone with its record", group = gZ)
useZoneFilter = input.bool(false, "   only trade zones with a matching history", group = gZ,
     tooltip = "Bounce setups only where the zone has HELD more often than it broke, break setups only where it has BROKEN more often. Off by default: it is a real filter, it will cut your signal count, and it has not been measured yet.")

gX = "EXTRA LIQUIDITY SOURCES"
useDaily = input.bool(true, "Previous day high / low", group = gX,
     tooltip = "The most-watched liquidity on any chart. Adding these is one of the biggest sources of extra setups.")
useSessH = input.bool(true, "Session highs / lows (Asia, London, NY)", group = gX)
useRound = input.bool(false, "Round numbers", group = gX,
     tooltip = "Gold clusters stops at whole and half dollars. Off by default because it generates a lot of levels.")
roundStep = input.float(10.0, "   round step", minval = 0.1, step = 0.5, group = gX)

gB = "SETUP TYPES"
useBreak  = input.bool(true, "BREAK setups (price takes the level out)", group = gB,
     tooltip = "The original behaviour: liquidity is taken and price continues. Measured 54.1% on gold against 44.5% for fading it.")
useBounce = input.bool(true, "BOUNCE setups (price tests the level and holds)", group = gB,
     tooltip = "The setup class that was missing entirely. Price comes back to a level, rejects it and turns away. This is most of what happens at support and resistance, and ignoring it was the single biggest source of missed entries.")
bounceWick = input.float(0.30, "   bounce needs rejection wick ≥ (of bar range)", minval = 0.0, maxval = 0.9, step = 0.05, group = gB,
     tooltip = "How decisively price must reject the level. 0 accepts any touch-and-close; 0.5 demands a long tail.")
bounceTol  = input.float(0.25, "   how close counts as a test (× ATR)", minval = 0.05, step = 0.05, group = gB)

gS = "SWEEP + ENTRY"
mode      = input.string("Continuation (tested)", "Trade direction",
     options = ["Continuation (tested)", "Reversal (classic)"], group = gS,
     tooltip = "Continuation follows the break — the direction that measured better on 5 of 5 markets. Reversal is the usual assumption and tested WORSE than a coin flip. Kept only so you can compare.")
needDisp  = input.bool(true, "Require displacement candle", group = gS,
     tooltip = "The break bar must expand beyond normal range. Filters the weak pokes that stall.")
dispAtr   = input.float(1.0, "   displacement ≥ (× ATR)", minval = 0.3, step = 0.1, group = gS)
needClose = input.bool(true, "Require close beyond the level", group = gS,
     tooltip = "A wick through is not a break. Demanding a close removes most fakeouts.")
minLvlAge = input.int(5,    "Level must be this many bars old", minval = 0, group = gS,
     tooltip = "A level formed moments ago has no resting orders behind it yet.")
needRetest = input.bool(false, "Wait for a retest of the broken level", group = gS,
     tooltip = "THE FAKEOUT FIX. Instead of entering on the break candle, wait for price to come back and HOLD the level it just broke. Far fewer fakeouts and a much better entry price - but you will miss the breaks that never look back. Turn this on if you are being faked out.")
retestBars = input.int(8,   "   retest must happen within (bars)", minval = 1, maxval = 30, group = gS)

gP = "SIGNAL FREQUENCY"
maxTrades = input.int(3, "Max concurrent setups", minval = 1, maxval = 6, group = "SIGNAL FREQUENCY",
     tooltip = "The single biggest limiter on how many entries you see. At 1 the indicator sits idle through every setup that appears while a trade is already open - which on a trending day is most of them.")
preset = input.string("Balanced", "Preset",
     options = ["Sniper (fewest, best measured)", "Balanced", "Scalper (most signals)", "Manual"],
     group = gP,
     tooltip = "This is a genuine trade-off, not a free lunch. Sniper uses the gates that MEASURED best (ADX<=20, ATR<=1.0x median) and will sit out most of the day. Scalper opens the gates wide and WILL take setups that measured worse. Balanced sits between. Manual uses your own values below.")

gF = "EXPANSION FILTER  (the 'is this move going to be big?' test)"
useSqueeze = input.bool(true, "Only trade compressed volatility", group = gF,
     tooltip = "MEASURED: ATR at or below its median precedes 3+ ATR moves ~90% of the time. ATR at 2x its median precedes them 25% of the time.")
maxSqueeze = input.float(1.15, "   max ATR / median ATR", minval = 0.5, step = 0.05, group = gF)
useAdx     = input.bool(true, "Only trade below an ADX ceiling", group = gF)
maxAdx     = input.float(25,  "   max ADX", minval = 10, maxval = 60, step = 1, group = gF)
useSess    = input.bool(false, "Restrict to hours (UTC)", group = gF,
     tooltip = "On GOLD 15m: 04-12 UTC showed 89-93% chance of a 3+ ATR move; 14-18 UTC showed 62-72%. Off by default because it was measured on one instrument.")
sessFrom   = input.int(4,  "   from hour", minval = 0, maxval = 23, group = gF)
sessTo     = input.int(12, "   to hour",   minval = 0, maxval = 23, group = gF)

gR = "RISK"
slBuf     = input.float(0.30, "Stop beyond sweep extreme (× ATR)", minval = 0, step = 0.05, group = gR)
tpMode    = input.string("Next liquidity", "Target", options = ["Next liquidity", "Fixed R"], group = gR)
tpR       = input.float(2.0, "   fixed R multiple", minval = 0.5, step = 0.25, group = gR)
minR      = input.float(1.2, "Reject setup if R:R below", minval = 0.5, step = 0.1, group = gR)
maxRiskAtr= input.float(2.5, "Reject setup if stop wider than (× ATR)", minval = 0.5, step = 0.1, group = gR)

gT = "LIVE TRADING (manual)"
lotSize    = input.float(0.01, "Your lot size", minval = 0.01, step = 0.01, group = gT,
     tooltip = "Used only to convert points into money on the panel. Change it and every P/L figure rescales.")
ccyPerPt   = input.float(1.00, "Account currency per 1.0 price move, per 0.01 lot", minval = 0.01, step = 0.01, group = gT,
     tooltip = "XAUUSD at 0.01 lots is normally 1.00 of account currency per 1.00 of price (a 100 oz contract at 0.01 = 1 oz). Check your broker's contract size and adjust if it differs.")
entryDelay = input.int(1, "Bars between signal and your actual entry", minval = 0, maxval = 10, group = gT,
     tooltip = "THE HONESTY SETTING. A signal prints at a bar close; you see it, then you enter. Set this to how many bars that realistically takes you. Everything tracked - entry price, P/L, the whole record - uses THAT price, not the signal price. At 0 the numbers flatter you.")
trackFrom  = input.string("My real entry", "Track profit from", options = ["My real entry", "Signal price"], group = gT)
showHist   = input.int(10, "Completed trades to keep on chart", minval = 0, maxval = 20, group = gT,
     tooltip = "Past position boxes stay on the chart, drained of colour, so you can see how the last N setups actually played out instead of only the live one. The record table below shows up to 11 of them.")
showTable  = input.bool(true, "Show trade record table", group = gT)

gE = "CLOSING EARLY  (not every trade reaches TP)"
useTrailExit = input.bool(true, "Close when the ATR trail is hit", group = gE,
     tooltip = "The trail only arms once the trade is in profit, and once armed it only ever moves in your favour. Hitting it closes the trade for whatever it is worth at that moment - which is usually less than TP and much more than nothing. Marked TRL in the record.")
useTimeExit  = input.bool(true, "Close a trade that stalls", group = gE,
     tooltip = "A setup that has not resolved in this many bars has stopped being the setup you entered. Closing it frees the slot for one that is working. Marked TIME.")
maxHoldBars  = input.int(40, "   stalled after (bars)", minval = 5, maxval = 300, group = gE)
useFlipExit  = input.bool(false, "Close on an opposite signal", group = gE,
     tooltip = "If a fresh signal fires the other way, the reason you are in the trade has gone. Off by default: on a choppy chart this closes good trades early. Marked FLIP.")

gD = "DISPLAY"
showTrail = input.bool(true, "Show trail guide once trade is in profit", group = gD,
     tooltip = "Dashed line showing where an ATR trail would sit. It deliberately does NOT appear until the trade is in profit: moving a stop up early measured as the worst exit rule on all four markets tested.")
trailArm  = input.float(1.0, "   only after (R in profit)", minval = 0, step = 0.25, group = gD)
trailAtr  = input.float(2.0, "   trail distance (× ATR)", minval = 0.5, step = 0.25, group = gD)
showRlive = input.bool(true, "Show live R on the open trade", group = gD)
zoneGrow  = input.bool(true, "Liquidity zones extend to the right edge", group = gD)
theme     = input.string("White / blue candles", "Palette",
     options = ["White / blue candles", "Classic green / red", "Custom"], group = gD,
     tooltip = "Zones are deliberately faint so white and blue candles stay the brightest thing on the chart. Only the BUY/SELL labels are fully saturated.")
uBull     = input.color(color.new(#29B6F6, 0),  "Custom buy",  inline = "c", group = gD)
uBear     = input.color(color.new(#FF5370, 0),  "Custom sell", inline = "c", group = gD)

// One accent per side, then everything else is a transparency of that accent.
// Keeping a single hue per side is what stops the chart turning into confetti.
accBull = theme == "Classic green / red" ? #26A69A : theme == "Custom" ? uBull : #29B6F6
accBear = theme == "Classic green / red" ? #EF5350 : theme == "Custom" ? uBear : #FF5370

cBull   = accBull
cBear   = accBear
cBsl    = color.new(accBear, 86)   // sell-side liquidity sits ABOVE price
cSsl    = color.new(accBull, 86)   // buy-side liquidity sits BELOW price
// Fully transparent. Drawings are created unconditionally and hidden with
// this, never by putting a *.new() call inside a ternary.
HIDDEN  = color.new(color.gray, 100)
cTp     = color.new(accBull, 88)
cSl     = color.new(accBear, 88)
showPanel = input.bool(true, "Show status panel", group = gD)

// ──────────────────────────────── FOUNDATIONS ───────────────────────────────
atr    = ta.atr(14)
atrMed = ta.median(atr, 50)
[diP, diM, adxV] = ta.dmi(14, 14)
sqz    = atrMed > 0 ? atr / atrMed : 1.0

// bars are read one late so a forming bar can never revoke a confirmed pivot
ph = ta.pivothigh(high, pivLen, pivLen)[1]
pl = ta.pivotlow(low,  pivLen, pivLen)[1]
pivotBar = bar_index - 1 - pivLen

// Two shorter scales. Each is read [1] and confirmed its own length late, so
// the shorter ones are known SOONER — which is the point: a scalper's level
// exists long before an 8-bar pivot confirms it.
ph2 = useMulti ? ta.pivothigh(high, pivMid, pivMid)[1] : na
pl2 = useMulti ? ta.pivotlow(low,  pivMid, pivMid)[1] : na
ph3 = useMulti ? ta.pivothigh(high, pivFast, pivFast)[1] : na
pl3 = useMulti ? ta.pivotlow(low,  pivFast, pivFast)[1] : na
pivotBar2 = bar_index - 1 - pivMid
pivotBar3 = bar_index - 1 - pivFast

hourNow = hour(time, "UTC")
inSess  = not useSess or (sessFrom <= sessTo ? (hourNow >= sessFrom and hourNow < sessTo)
                                             : (hourNow >= sessFrom or hourNow < sessTo))
// Preset overrides the manual gates unless "Manual" is chosen.
// The numbers come from the measured table: ADX 0-15 preceded a 3+ ATR move
// ~90% of the time, ADX>=40 only 66%, ATR at 2x its median only 25%.
sqzGate = preset == "Sniper (fewest, best measured)" ? 1.00 :
          preset == "Balanced" ? 1.15 :
          preset == "Scalper (most signals)" ? 1.60 : maxSqueeze
adxGate = preset == "Sniper (fewest, best measured)" ? 20.0 :
          preset == "Balanced" ? 25.0 :
          preset == "Scalper (most signals)" ? 45.0 : maxAdx

expansionOk = (not useSqueeze or sqz <= sqzGate) and (not useAdx or adxV <= adxGate) and inSess

// ---- previous-day and session levels.
// request.security with lookahead_off already returns the last CLOSED daily
// bar, so no [1] offset is needed. Adding one would silently plot the day
// BEFORE yesterday, which is a classic and invisible error.
pdh = request.security(syminfo.tickerid, "D", high, lookahead = barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low,  lookahead = barmerge.lookahead_off)

// rolling session extremes, reset when the session block changes
sessId  = math.floor(hour(time, "UTC") / 8)          // 0 Asia, 1 London, 2 NY
newSess = sessId != sessId[1]
var float sHi = na
var float sLo = na
if newSess
    sHi := high
    sLo := low
else
    sHi := math.max(nz(sHi, high), high)
    sLo := math.min(nz(sLo, low), low)

// ───────────────────────────── LIQUIDITY REGISTRY ───────────────────────────
// Parallel arrays: price, bar formed, touch count, swept flag, drawing handles.
var array<float> hiPx   = array.new_float()
var array<int>   hiBar  = array.new_int()
var array<int>   hiHits = array.new_int()
var array<bool>  hiDead = array.new_bool()
var array<line>  hiLn   = array.new_line()
var array<box>   hiBx   = array.new_box()

var array<float> loPx   = array.new_float()
var array<int>   loBar  = array.new_int()
var array<int>   loHits = array.new_int()
var array<bool>  loDead = array.new_bool()
var array<line>  loLn   = array.new_line()
var array<box>   loBx   = array.new_box()

// ───────────────── ZONE MEMORY — how this level behaved before ──────────────
// The question: when price comes back to a zone, what did it DO the last times
// it was here? This memory is deliberately SEPARATE from the drawn levels.
// Drawings get evicted to keep the chart readable, but the history of a price
// area should outlive its line - that is the "previous zones" part.
var array<float> memPx    = array.new_float()
var array<int>   memTouch = array.new_int()
var array<int>   memHold  = array.new_int()
var array<int>   memBreak = array.new_int()
var array<float> memMove  = array.new_float()
var array<int>   memLast  = array.new_int()

// touches whose reaction is not yet known
var array<float> pnPx  = array.new_float()
var array<int>   pnBar = array.new_int()
var array<bool>  pnHi  = array.new_bool()

memFind(float p) =>
    idx = -1
    tol = zoneTol * atr
    if array.size(memPx) > 0
        for i = 0 to array.size(memPx) - 1
            if idx == -1 and math.abs(array.get(memPx, i) - p) <= tol
                idx := i
    idx

memAdd(float p) =>
    array.push(memPx, p)
    array.push(memTouch, 0)
    array.push(memHold, 0)
    array.push(memBreak, 0)
    array.push(memMove, 0.0)
    array.push(memLast, bar_index)
    while array.size(memPx) > memMax
        array.shift(memPx)
        array.shift(memTouch)
        array.shift(memHold)
        array.shift(memBreak)
        array.shift(memMove)
        array.shift(memLast)
    array.size(memPx) - 1

regTouch(float p, bool isHigh) =>
    i = memFind(p)
    if i == -1
        i := memAdd(p)
    array.set(memTouch, i, array.get(memTouch, i) + 1)
    array.set(memLast,  i, bar_index)
    array.push(pnPx,  p)
    array.push(pnBar, bar_index)
    array.push(pnHi,  isHigh)
    0

// Record a visit to any live level. Re-registering the same zone every bar of
// a long consolidation would turn one visit into forty, so a zone is only
// re-registered once its previous visit has been resolved.
touchScan(array<float> px, array<bool> dead, bool isHigh) =>
    if useZoneMem and barstate.isconfirmed and array.size(px) > 0
        tol = zoneTol * atr
        for i = 0 to array.size(px) - 1
            if not array.get(dead, i)
                p = array.get(px, i)
                if low <= p + tol and high >= p - tol
                    m = memFind(p)
                    if m == -1 or (bar_index - array.get(memLast, m)) > reactBars
                        regTouch(p, isHigh)
    0

addLevel(array<float> px, array<int> bar, array<int> hits, array<bool> dead,
         array<line> lns, array<box> bxs, float p, int b, bool isHigh) =>
    // merge into an existing near-equal level: equal highs/lows hold MORE
    // resting orders than a lone extreme, so they are strengthened not doubled
    merged = false
    tol = eqTol * atr
    if array.size(px) > 0
        for i = 0 to array.size(px) - 1
            if not merged and not array.get(dead, i) and math.abs(array.get(px, i) - p) <= tol
                array.set(px, i, isHigh ? math.max(array.get(px, i), p) : math.min(array.get(px, i), p))
                array.set(hits, i, array.get(hits, i) + 1)
                merged := true
    if not merged
        array.push(px, p)
        array.push(bar, b)
        array.push(hits, 1)
        array.push(dead, false)
        ln = line.new(b, p, bar_index + 3, p, style = line.style_dotted, width = 1,
             color = showLvls ? (isHigh ? cBsl : cSsl) : HIDDEN)
        bx = box.new(b, p, bar_index + 3, p, border_color = na,
             bgcolor = showZones ? (isHigh ? cBsl : cSsl) : HIDDEN)
        array.push(lns, ln)
        array.push(bxs, bx)
        // evict the oldest once past the cap, so the chart never accumulates
        while array.size(px) > maxLevels
            l0 = array.shift(lns)
            b0 = array.shift(bxs)
            if not na(l0)
                line.delete(l0)
            if not na(b0)
                box.delete(b0)
            array.shift(px)
            array.shift(bar)
            array.shift(hits)
            array.shift(dead)
    merged

if not na(ph)
    addLevel(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, ph, pivotBar, true)
if not na(pl)
    addLevel(loPx, loBar, loHits, loDead, loLn, loBx, pl, pivotBar, false)
if not na(ph2)
    addLevel(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, ph2, pivotBar2, true)
if not na(pl2)
    addLevel(loPx, loBar, loHits, loDead, loLn, loBx, pl2, pivotBar2, false)
if not na(ph3)
    addLevel(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, ph3, pivotBar3, true)
if not na(pl3)
    addLevel(loPx, loBar, loHits, loDead, loLn, loBx, pl3, pivotBar3, false)

// previous day — registered once per new value, not once per bar
var float lastPdh = na
var float lastPdl = na
if useDaily and not na(pdh) and pdh != lastPdh
    lastPdh := pdh
    addLevel(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, pdh, bar_index, true)
if useDaily and not na(pdl) and pdl != lastPdl
    lastPdl := pdl
    addLevel(loPx, loBar, loHits, loDead, loLn, loBx, pdl, bar_index, false)

// session extremes — registered when the session rolls over
if useSessH and newSess and not na(sHi[1])
    addLevel(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, sHi[1], bar_index, true)
if useSessH and newSess and not na(sLo[1])
    addLevel(loPx, loBar, loHits, loDead, loLn, loBx, sLo[1], bar_index, false)

// round numbers near price
var float lastRound = na
if useRound and roundStep > 0
    rUp = math.ceil(close / roundStep) * roundStep
    rDn = math.floor(close / roundStep) * roundStep
    if rUp != lastRound
        lastRound := rUp
        addLevel(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, rUp, bar_index, true)
        addLevel(loPx, loBar, loHits, loDead, loLn, loBx, rDn, bar_index, false)

// keep live level drawings anchored to the right edge, fade the dead ones
extend(array<float> px, array<int> bar, array<int> hits, array<bool> dead,
       array<line> lns, array<box> bxs, bool isHigh) =>
    if array.size(px) > 0
        for i = 0 to array.size(px) - 1
            ln = array.get(lns, i)
            bx = array.get(bxs, i)
            p  = array.get(px, i)
            isDead = array.get(dead, i)
            thick = math.min(array.get(hits, i), 3)
            if not na(ln)
                // y must be re-set too: an equal-high merge MOVES the stored
                // price, and without this the line drifts away from its own
                // zone and the chart looks broken.
                line.set_y1(ln, p)
                line.set_y2(ln, p)
                line.set_x2(ln, bar_index + 3)
                line.set_color(ln, not showLvls ? HIDDEN
                     : isDead ? color.new(color.gray, 88)
                     : color.new(isHigh ? accBear : accBull, 45))
                line.set_width(ln, isDead ? 1 : thick)
            if not na(bx)
                zh = (zoneGrow ? 0.16 : 0.07) * atr * thick
                box.set_top(bx, p + (isHigh ? zh : 0))
                box.set_bottom(bx, p - (isHigh ? 0 : zh))
                box.set_right(bx, zoneGrow ? bar_index + 6 : bar_index + 3)
                box.set_bgcolor(bx, not showZones ? HIDDEN
                     : isDead ? color.new(color.gray, 95)
                     : (isHigh ? cBsl : cSsl))
    0
extend(hiPx, hiBar, hiHits, hiDead, hiLn, hiBx, true)
extend(loPx, loBar, loHits, loDead, loLn, loBx, false)

// ---- record visits, then judge them `reactBars` later
touchScan(hiPx, hiDead, true)
touchScan(loPx, loDead, false)

if array.size(pnPx) > 0
    for q = array.size(pnPx) - 1 to 0
        if bar_index - array.get(pnBar, q) >= reactBars
            lp   = array.get(pnPx, q)
            isHi = array.get(pnHi, q)
            m    = memFind(lp)
            if m != -1
                thr   = zoneTol * atr
                moved = close - lp
                // a resistance HELD if price is now below it; a support HELD if
                // price is now above it. Anything inside the tolerance is
                // neither - it is still sitting on the level, so it is not counted.
                held  = isHi ? (moved < -thr) : (moved >  thr)
                broke = isHi ? (moved >  thr) : (moved < -thr)
                if held
                    array.set(memHold, m, array.get(memHold, m) + 1)
                    array.set(memMove, m, array.get(memMove, m) + math.abs(moved))
                else if broke
                    array.set(memBreak, m, array.get(memBreak, m) + 1)
                    array.set(memMove, m, array.get(memMove, m) + math.abs(moved))
            array.remove(pnPx,  q)
            array.remove(pnBar, q)
            array.remove(pnHi,  q)

// ---- what the nearest zone's record says about what price may do here
zoneHold(float p) =>
    m = memFind(p)
    m == -1 ? -1.0 : (array.get(memHold, m) + array.get(memBreak, m) == 0 ? -1.0
         : 100.0 * array.get(memHold, m)
           / (array.get(memHold, m) + array.get(memBreak, m)))

zoneText(float p) =>
    m = memFind(p)
    string t = ""
    if m != -1
        h = array.get(memHold, m)
        b = array.get(memBreak, m)
        n = h + b
        avg = n > 0 ? array.get(memMove, m) / n : 0.0
        t := n == 0 ? "new"
             : str.tostring(h) + " held / " + str.tostring(b) + " broke  ~"
               + str.tostring(avg, "#.#") + "pt"
    t

// ───────────────────────────── SWEEP DETECTION ──────────────────────────────
// A break is: price takes out a level that is old enough to hold orders, and
// (optionally) CLOSES beyond it on an expanding candle. The close requirement
// is what removes most fakeouts — a wick through is not a break.
body     = math.abs(close - open)
rng      = math.max(high - low, syminfo.mintick)
isDisp   = body >= dispAtr * atr
dispOk   = not needDisp or isDisp

float sweptHi = na
float sweptLo = na
int   sweptHiHits = 0
int   sweptLoHits = 0

if array.size(hiPx) > 0
    for i = 0 to array.size(hiPx) - 1
        p = array.get(hiPx, i)
        if not array.get(hiDead, i) and bar_index - array.get(hiBar, i) >= minLvlAge
            broke = needClose ? (close > p) : (high > p)
            if broke and barstate.isconfirmed
                array.set(hiDead, i, true)
                if na(sweptHi) or p > sweptHi
                    sweptHi := p
                    sweptHiHits := array.get(hiHits, i)

if array.size(loPx) > 0
    for i = 0 to array.size(loPx) - 1
        p = array.get(loPx, i)
        if not array.get(loDead, i) and bar_index - array.get(loBar, i) >= minLvlAge
            broke = needClose ? (close < p) : (low < p)
            if broke and barstate.isconfirmed
                array.set(loDead, i, true)
                if na(sweptLo) or p < sweptLo
                    sweptLo := p
                    sweptLoHits := array.get(loHits, i)

// ---- BOUNCE: price TESTS a level and holds it.
// This is the setup class that was missing. A break is one thing that can
// happen at a level; holding is the other, and at support/resistance it is
// the more common one. Ignoring it was the largest source of missed entries.
rngB  = math.max(high - low, syminfo.mintick)
upWk  = high - math.max(open, close)
dnWk  = math.min(open, close) - low
tolB  = bounceTol * atr

float bounceUpLvl = na       // held support -> buy
float bounceDnLvl = na       // held resistance -> sell

if useBounce and barstate.isconfirmed and array.size(loPx) > 0
    for i = 0 to array.size(loPx) - 1
        p = array.get(loPx, i)
        if not array.get(loDead, i) and bar_index - array.get(loBar, i) >= minLvlAge
            tested = low <= p + tolB and low >= p - tolB * 3
            held   = close > p
            reject = (dnWk / rngB) >= bounceWick
            if tested and held and reject and (na(bounceUpLvl) or p > bounceUpLvl)
                bounceUpLvl := p

if useBounce and barstate.isconfirmed and array.size(hiPx) > 0
    for i = 0 to array.size(hiPx) - 1
        p = array.get(hiPx, i)
        if not array.get(hiDead, i) and bar_index - array.get(hiBar, i) >= minLvlAge
            tested = high >= p - tolB and high <= p + tolB * 3
            held   = close < p
            reject = (upWk / rngB) >= bounceWick
            if tested and held and reject and (na(bounceDnLvl) or p < bounceDnLvl)
                bounceDnLvl := p

// direction: continuation follows the break, reversal fades it
isCont   = mode == "Continuation (tested)"
rawLong  = not na(sweptHi)      // took out sell-side liquidity above
rawShort = not na(sweptLo)      // took out buy-side liquidity below
brkLong  = useBreak and (isCont ? rawLong  : rawShort)
brkShort = useBreak and (isCont ? rawShort : rawLong)

// A bounce off support is a BUY regardless of the continuation/reversal
// setting — that setting governs how a BREAK is traded, not a hold.
bncLong  = useBounce and not na(bounceUpLvl)
bncShort = useBounce and not na(bounceDnLvl)

// ---- ZONE HISTORY FILTER.
// A bounce is a bet that the level HOLDS, so take it where this zone has held
// more often than it broke. A break is the opposite bet, so take it where the
// zone has actually been broken before. A zone with no record (-1) is allowed
// through either way - absence of history is not evidence against the trade.
bncHold  = bncLong  ? zoneHold(bounceUpLvl) : bncShort ? zoneHold(bounceDnLvl) : -1.0
brkHold  = brkLong  ? zoneHold(nz(sweptHi, close)) : brkShort ? zoneHold(nz(sweptLo, close)) : -1.0
bncOk    = not useZoneFilter or bncHold < 0 or bncHold >= 50.0
brkOk    = not useZoneFilter or brkHold < 0 or brkHold <  50.0

goLong   = (brkLong  and brkOk) or (bncLong  and bncOk)
goShort  = (brkShort and brkOk) or (bncShort and bncOk)
setupIsBounce = (bncLong or bncShort) and not (brkLong or brkShort)

// ─────────────────────────── TARGET: NEXT LIQUIDITY ─────────────────────────
nextLiq(bool up) =>
    float best = na
    if up and array.size(hiPx) > 0
        for i = 0 to array.size(hiPx) - 1
            p = array.get(hiPx, i)
            if not array.get(hiDead, i) and p > close
                best := na(best) ? p : math.min(best, p)
    if not up and array.size(loPx) > 0
        for i = 0 to array.size(loPx) - 1
            p = array.get(loPx, i)
            if not array.get(loDead, i) and p < close
                best := na(best) ? p : math.max(best, p)
    best

// ───────────────────────────── TRADE STATE + BOXES ──────────────────────────
// ───────────────────────── TRADE STATE (multiple concurrent) ────────────────
// Parallel arrays so several setups can run at once. With only one slot the
// indicator ignores every setup that appears while a trade is already open,
// which on a trending day is most of them — that single limit was the largest
// cause of "it does not catch enough entries".
var array<int>   trDir = array.new_int()
var array<float> trEnt = array.new_float()
var array<float> trSl  = array.new_float()
var array<float> trTp  = array.new_float()
var array<int>   trBar = array.new_int()
var array<box>   trBxT = array.new_box()
var array<box>   trBxS = array.new_box()
var array<line>  trTrl = array.new_line()
var array<line>  trEnl = array.new_line()   // the line from your real fill
var array<float> trTrs = array.new_float()  // ratcheting trail stop, per trade
var array<float> trMfe = array.new_float()  // best price the trade ever saw
var array<box>   oldBoxes = array.new_box()
var array<line>  oldLines = array.new_line()

// ---- PENDING QUEUE.
// A signal prints at a bar close. You see it, then you enter. Those are not
// the same price and pretending they are is how a chart flatters itself.
// A fired signal sits here for `entryDelay` bars and is then filled at that
// bar's OPEN — the first price actually obtainable.
var array<int>   pdDir  = array.new_int()
var array<int>   pdBar  = array.new_int()
var array<float> pdRisk = array.new_float()
var array<float> pdRR   = array.new_float()
var array<float> pdSig  = array.new_float()   // the signal price, for comparison

// ---- completed trade record, newest last
var array<int>   hDir = array.new_int()
var array<float> hEnt = array.new_float()
var array<float> hExt = array.new_float()
var array<float> hR   = array.new_float()
var array<float>  hMfe = array.new_float()   // the best it was EVER worth, in R
var array<float>  hRsk = array.new_float()   // risk in price, to price the gap
var array<string> hWhy = array.new_string()

// Completed trades do not vanish. Their boxes stay, drained of colour, so the
// last `showHist` trades read as history rather than competing with the live one.
pushOld(box b, bool won) =>
    if not na(b)
        box.set_bgcolor(b, color.new(won ? accBull : accBear, 93))
        array.push(oldBoxes, b)
        while array.size(oldBoxes) > math.max(showHist, 1) * 2
            b0 = array.shift(oldBoxes)
            if not na(b0)
                box.delete(b0)
    0

pushOldLine(line l) =>
    if not na(l)
        line.set_color(l, color.new(color.gray, 55))
        line.set_width(l, 1)
        array.push(oldLines, l)
        while array.size(oldLines) > math.max(showHist, 1)
            l0 = array.shift(oldLines)
            if not na(l0)
                line.delete(l0)
    0

// One place where a trade is opened, so a delayed fill and an immediate fill
// cannot drift apart.
openTrade(int d, float en, float sl, float tp) =>
    array.push(trDir, d)
    array.push(trEnt, en)
    array.push(trSl,  sl)
    array.push(trTp,  tp)
    array.push(trBar, bar_index)
    array.push(trTrs, float(na))
    array.push(trMfe, 0.0)
    array.push(trTrl, line(na))
    array.push(trBxT, box.new(bar_index, math.max(en, tp), bar_index + 2,
         math.min(en, tp), border_color = na, bgcolor = cTp))
    array.push(trBxS, box.new(bar_index, math.max(en, sl), bar_index + 2,
         math.min(en, sl), border_color = na, bgcolor = cSl))
    // the line the user asked for: drawn at the price actually obtainable,
    // and extended every bar so the trade is trackable from entry to close
    array.push(trEnl, line.new(bar_index, en, bar_index + 2, en, width = 2,
         color = color.new(d > 0 ? accBull : accBear, 10)))
    0

// ---- armed state (only used when needRetest is on)
var int   armDir  = 0
var float armLvl  = na
var int   armBar  = 0
var float armExt  = na

// Displacement is a BREAK requirement. Demanding an expansion candle on a
// bounce would reject the very thing a bounce is: a rejection wick.
breakNow = barstate.isconfirmed and expansionOk and (goLong or goShort) and
     (setupIsBounce ? true : dispOk)

if needRetest and breakNow
    armDir := goLong ? 1 : -1
    armLvl := goLong ? nz(sweptHi, close) : nz(sweptLo, close)
    armBar := bar_index
    armExt := goLong ? high : low
if armDir != 0
    armExt := armDir > 0 ? math.max(armExt, high) : math.min(armExt, low)
    if bar_index - armBar > retestBars
        armDir := 0

// A retest fires when price returns to the broken level and CLOSES on the
// correct side. Coming back and failing to hold is the fakeout; this refuses it.
retestHit = armDir != 0 and bar_index > armBar and barstate.isconfirmed and
     (armDir > 0 ? (low <= armLvl and close > armLvl)
                 : (high >= armLvl and close < armLvl))

canFire = array.size(trDir) < maxTrades and (needRetest ? retestHit : breakNow)

var bool firedLong   = false
var bool firedShort  = false
var bool firedBounce = false
firedLong   := false
firedShort  := false
firedBounce := false

if canFire
    dir   = needRetest ? armDir : (goLong ? 1 : -1)
    // a bounce is invalidated if the level FAILS, so its stop sits just beyond
    // the wick that tested it — normally much tighter than a break stop
    ext   = setupIsBounce ? (dir > 0 ? low : high)
             : needRetest ? armExt
             : (dir > 0 ? math.max(high, nz(sweptHi, high)) : math.min(low, nz(sweptLo, low)))
    entry = close
    sl    = dir > 0 ? math.min(low, ext) - slBuf * atr : math.max(high, ext) + slBuf * atr
    risk  = math.abs(entry - sl)
    lvlTp = nextLiq(dir > 0)
    tp    = tpMode == "Fixed R" or na(lvlTp) ? entry + dir * tpR * risk : lvlTp
    rr    = risk > 0 ? math.abs(tp - entry) / risk : 0
    if risk > 0 and risk <= maxRiskAtr * atr and rr >= minR
        // The signal is real now; the FILL is not. Queue it and let the fill
        // happen at a price this bar cannot know. At entryDelay 0 it opens
        // immediately, which is the flattering case, not the realistic one.
        array.push(pdDir,  dir)
        array.push(pdBar,  bar_index)
        array.push(pdRisk, risk)
        array.push(pdRR,   rr)
        array.push(pdSig,  entry)
        firedLong   := dir > 0
        firedShort  := dir < 0
        firedBounce := setupIsBounce
        armDir := 0

// ---- fill anything whose delay has elapsed, at THIS bar's open
var float lastSlip = na
if array.size(pdDir) > 0
    for q = array.size(pdDir) - 1 to 0
        aged = bar_index - array.get(pdBar, q)
        if aged >= entryDelay and array.size(trDir) < maxTrades
            d2   = array.get(pdDir,  q)
            rk   = array.get(pdRisk, q)
            rrq  = array.get(pdRR,   q)
            sig  = array.get(pdSig,  q)
            // THE realistic price: this bar's open, the first thing you could
            // actually have been filled at after seeing the signal.
            fill = trackFrom == "Signal price" ? sig : open
            sl2  = fill - d2 * rk
            tp2  = fill + d2 * rrq * rk
            lastSlip := (sig - fill) * d2      // + means the delay cost you
            openTrade(d2, fill, sl2, tp2)
            array.remove(pdDir, q)
            array.remove(pdBar, q)
            array.remove(pdRisk, q)
            array.remove(pdRR, q)
            array.remove(pdSig, q)
        else if aged > entryDelay + 3
            array.remove(pdDir, q)
            array.remove(pdBar, q)
            array.remove(pdRisk, q)
            array.remove(pdRR, q)
            array.remove(pdSig, q)

// ---- manage every open trade. Iterating backwards so removals are safe.
var string lastExit = ""
if array.size(trDir) > 0
    for k = array.size(trDir) - 1 to 0
        d  = array.get(trDir, k)
        en = array.get(trEnt, k)
        sl = array.get(trSl,  k)
        tp = array.get(trTp,  k)
        bt = array.get(trBxT, k)
        bs = array.get(trBxS, k)
        tl = array.get(trTrl, k)
        el = array.get(trEnl, k)
        held = bar_index - array.get(trBar, k)

        // boxes and the entry line GROW with the trade instead of sitting at a
        // fixed width, so an open position is trackable from fill to close
        box.set_right(bt, bar_index + 2)
        box.set_right(bs, bar_index + 2)
        if not na(el)
            line.set_x2(el, bar_index + 2)

        risk = math.abs(en - sl)
        rNow = risk > 0 ? (close - en) * d / risk : 0

        // ---- PEAK. The best this trade was EVER worth, in R. This is the
        // execution number: the gap between it and the R actually banked is
        // exactly "it went into profit and we did not close in that profit",
        // and until it is measured per trade it can only be argued about.
        favNow = ((d > 0 ? high : low) - en) * d
        mfe    = math.max(array.get(trMfe, k), favNow)
        array.set(trMfe, k, mfe)
        peakR  = risk > 0 ? mfe / risk : 0.0

        // ---- TRAIL. Arms only once the trade has EARNED it (moving a stop up
        // early measured as the worst exit rule on all four markets tested),
        // and once armed it RATCHETS - it never gives ground back.
        trs = array.get(trTrs, k)
        if rNow >= trailArm
            cand = d > 0 ? close - trailAtr * atr : close + trailAtr * atr
            trs := na(trs) ? cand : (d > 0 ? math.max(trs, cand) : math.min(trs, cand))
            array.set(trTrs, k, trs)

        if showTrail and not na(trs)
            if na(tl)
                tl := line.new(bar_index - 1, trs, bar_index + 2, trs,
                     color = color.new(d > 0 ? accBull : accBear, 40),
                     style = line.style_dashed, width = 1)
                array.set(trTrl, k, tl)
            else
                line.set_xy1(tl, bar_index - 1, trs)
                line.set_xy2(tl, bar_index + 2, trs)

        // live money at YOUR lot size, not abstract R
        moneyNow = (close - en) * d * ccyPerPt * (lotSize / 0.01)
        if showRlive and barstate.islast
            label.new(bar_index + 2, close,
                 str.tostring(rNow, "#.#") + "R  " +
                 (moneyNow >= 0 ? "+" : "") + str.tostring(moneyNow, "#.##"),
                 style = label.style_label_left,
                 color = color.new(color.white, 100),
                 textcolor = moneyNow >= 0 ? accBull : accBear, size = size.small)

        // ---- EXITS. Not every trade reaches TP and pretending otherwise is
        // how a chart lies. The effective stop is whichever of the hard stop
        // and the trail price would be reached FIRST, so there is no ambiguity
        // about which one fired on a bar that touched both.
        useTrl = useTrailExit and not na(trs)
        eStop  = useTrl ? (d > 0 ? math.max(sl, trs) : math.min(sl, trs)) : sl
        byTrl  = useTrl and (d > 0 ? trs > sl : trs < sl)
        hitStp = d > 0 ? low  <= eStop : high >= eStop
        hitTp  = d > 0 ? high >= tp    : low  <= tp
        hitFlp = useFlipExit and (d > 0 ? firedShort : firedLong)
        hitTim = useTimeExit and held >= maxHoldBars

        // ties lose: the stop is checked before the target
        exPx  = hitStp ? eStop : hitTp ? tp : close
        exWhy = hitStp ? (byTrl ? "TRL" : "SL") : hitTp ? "TP" : hitFlp ? "FLIP" : "TIME"
        gone  = hitStp or hitTp or hitFlp or hitTim

        if barstate.isconfirmed and gone
            lastExit := exWhy
            rFinal = risk > 0 ? (exPx - en) * d / risk : 0.0
            won    = rFinal >= 0
            label.new(bar_index, exPx,
                 exWhy == "TP" ? "✓" : exWhy == "SL" ? "✕" : exWhy,
                 style = d > 0 ? label.style_label_up : label.style_label_down,
                 color = color.new(color.white, 100),
                 textcolor = won ? accBull : accBear, size = size.small)
            array.push(hDir, d)
            array.push(hEnt, en)
            array.push(hExt, exPx)
            array.push(hR,   rFinal)
            array.push(hMfe, peakR)
            array.push(hRsk, risk)
            array.push(hWhy, exWhy)
            while array.size(hDir) > 30
                array.shift(hDir)
                array.shift(hEnt)
                array.shift(hExt)
                array.shift(hR)
                array.shift(hMfe)
                array.shift(hRsk)
                array.shift(hWhy)
            pushOld(bt, won)
            pushOld(bs, won)
            pushOldLine(el)
            if not na(tl)
                line.delete(tl)
            array.remove(trDir, k)
            array.remove(trEnt, k)
            array.remove(trSl,  k)
            array.remove(trTp,  k)
            array.remove(trBar, k)
            array.remove(trBxT, k)
            array.remove(trBxS, k)
            array.remove(trTrl, k)
            array.remove(trEnl, k)
            array.remove(trTrs, k)
            array.remove(trMfe, k)

plotshape(firedLong  and not firedBounce, "BUY break",  shape.labelup,
     location.belowbar, cBull, text = "BUY",  textcolor = color.white, size = size.small)
plotshape(firedShort and not firedBounce, "SELL break", shape.labeldown,
     location.abovebar, cBear, text = "SELL", textcolor = color.white, size = size.small)
// Bounce setups get their own mark. They are a different trade with a
// different invalidation, and blending them into one label would hide which
// kind is actually working for you.
plotshape(firedLong  and firedBounce, "BUY bounce",  shape.triangleup,
     location.belowbar, cBull, size = size.tiny)
plotshape(firedShort and firedBounce, "SELL bounce", shape.triangledown,
     location.abovebar, cBear, size = size.tiny)

// ──────────────── ZONE RECORD LABELS — the history, on the chart ────────────
// Drawn only on the last bar so they cost one label per level, not one per bar.
var array<label> zLabs = array.new_label()

drawZoneLabels(array<float> px, array<bool> dead, bool isHigh) =>
    if showZoneStats and useZoneMem and barstate.islast and array.size(px) > 0
        for i = 0 to array.size(px) - 1
            if not array.get(dead, i)
                p = array.get(px, i)
                t = zoneText(p)
                if t != ""
                    hp = zoneHold(p)
                    col = hp < 0 ? color.new(chart.fg_color, 45)
                         : hp >= 60 ? accBull : hp <= 40 ? accBear
                         : color.new(#FFB300, 0)
                    array.push(zLabs, label.new(bar_index + 4, p, t,
                         style = label.style_label_left, size = size.tiny,
                         color = color.new(color.white, 100), textcolor = col))
    0

// labels are redrawn each time the last bar updates, so clear the previous set
if barstate.islast and array.size(zLabs) > 0
    while array.size(zLabs) > 0
        l0 = array.shift(zLabs)
        if not na(l0)
            label.delete(l0)
drawZoneLabels(hiPx, hiDead, true)
drawZoneLabels(loPx, loDead, false)

// ──────────────────────────────── STATUS PANEL ──────────────────────────────
var table panel = table.new(position.top_right, 2, 9, frame_width = 1,
     frame_color = color.new(color.gray, 60), border_width = 1,
     border_color = color.new(color.gray, 85))

cell(int r, string k, string v, color c) =>
    table.cell(panel, 0, r, k, text_size = size.small, text_halign = text.align_left,
         text_color = color.new(chart.fg_color, 40), bgcolor = color.new(chart.bg_color, 10))
    table.cell(panel, 1, r, v, text_size = size.small, text_halign = text.align_right,
         text_color = c, bgcolor = color.new(chart.bg_color, 10))

okc = accBull
bad = accBear
dim = color.new(chart.fg_color, 35)

if showPanel and barstate.islast
    cell(0, "Mode", (isCont ? "CONT" : "REV") + " · " +
         (preset == "Sniper (fewest, best measured)" ? "SNIPER"
        : preset == "Scalper (most signals)" ? "SCALPER"
        : preset == "Balanced" ? "BALANCED" : "MANUAL"), isCont ? okc : bad)
    cell(1, "Squeeze  ATR/med", str.tostring(sqz, "#.##") + " / " + str.tostring(sqzGate, "#.##")
         + (sqz <= sqzGate ? "  ok" : "  too hot"), sqz <= sqzGate ? okc : bad)
    cell(2, "ADX", str.tostring(adxV, "#.#") + " / " + str.tostring(adxGate, "#.#")
         + (adxV <= adxGate ? "  ok" : "  too high"), adxV <= adxGate ? okc : bad)
    cell(3, "Session " + str.tostring(hourNow) + ":00 UTC", inSess ? "ok" : "outside", inSess ? okc : bad)
    cell(4, "Setups on", (useBreak ? "break " : "") + (useBounce ? "bounce" : "") +
         (useBreak or useBounce ? "" : "NONE"), (useBreak or useBounce) ? okc : bad)
    cell(5, "Setups allowed", expansionOk ? "YES" : "NO — waiting", expansionOk ? okc : bad)
    nOpen = array.size(trDir)
    nPend = array.size(pdDir)
    cell(6, "Trades", nOpen > 0 ? (str.tostring(nOpen) + "/" + str.tostring(maxTrades) + " open")
         : nPend > 0 ? ("ENTER NOW × " + str.tostring(nPend))
         : armDir != 0 ? ("ARMED " + str.tostring(bar_index - armBar) + "/" + str.tostring(retestBars))
         : ("flat" + (lastExit == "" ? "" : "  last " + lastExit)),
         nOpen > 0 ? okc : nPend > 0 ? color.new(#FFB300, 0)
         : armDir != 0 ? color.new(#FFB300, 0) : color.new(chart.fg_color, 30))
    // What the delay between signal and click actually cost, in price. This is
    // the number most indicators hide by pretending you filled at the signal.
    // The nearest zone's own record, so you know what price did here before.
    nearHi = nextLiq(true)
    nearLo = nextLiq(false)
    nearP  = na(nearHi) ? nearLo : na(nearLo) ? nearHi
             : (math.abs(nearHi - close) < math.abs(close - nearLo) ? nearHi : nearLo)
    zt = na(nearP) ? "" : zoneText(nearP)
    zh = na(nearP) ? -1.0 : zoneHold(nearP)
    cell(7, "Nearest zone " + (na(nearP) ? "" : str.tostring(nearP, format.mintick)),
         zt == "" ? "no record yet" : zt,
         zh < 0 ? dim : zh >= 60 ? okc : zh <= 40 ? bad : color.new(#FFB300, 0))
    cell(8, "Delay " + str.tostring(entryDelay) + " bar" + (entryDelay == 1 ? "" : "s"),
         na(lastSlip) ? "no fills yet"
         : ((lastSlip >= 0 ? "cost " : "gained ") + str.tostring(math.abs(lastSlip), "#.##")),
         na(lastSlip) ? color.new(chart.fg_color, 30) : lastSlip > 0 ? bad : okc)

// ───────────────────────────── TRADE RECORD TABLE ───────────────────────────
// What actually happened, in money, at your lot size. Every figure uses the
// DELAYED fill price, so this is the record of trades you could really have
// taken - not the record the signal price would have produced.
var table rec = table.new(position.bottom_right, 6, 15, frame_width = 1,
     frame_color = color.new(color.gray, 60), border_width = 1,
     border_color = color.new(color.gray, 85))

recCell(int c, int r, string txt, color col, bool head) =>
    table.cell(rec, c, r, txt, text_size = size.tiny,
         text_halign = c == 0 ? text.align_left : text.align_right,
         text_color = head ? color.new(chart.fg_color, 30) : col,
         bgcolor = color.new(chart.bg_color, 5))

if showTable and barstate.islast and array.size(hDir) > 0
    recCell(0, 0, "#",    chart.fg_color, true)
    recCell(1, 0, "dir",  chart.fg_color, true)
    recCell(2, 0, "got",  chart.fg_color, true)
    recCell(3, 0, "peak", chart.fg_color, true)
    recCell(4, 0, str.tostring(lotSize) + " lot", chart.fg_color, true)
    recCell(5, 0, "exit", chart.fg_color, true)
    n     = array.size(hDir)
    shown = math.min(showHist, math.min(n, 11))
    totR  = 0.0
    totM  = 0.0
    wins  = 0
    nTp   = 0
    nErl  = 0
    nSl   = 0
    totPk = 0.0          // total R that was AVAILABLE at each trade's best
    totLeft = 0.0        // the give-back, in account money
    wentGreen = 0        // trades that were ever in profit at all
    for j = 0 to n - 1
        rr_ = array.get(hR, j)
        wy_ = array.get(hWhy, j)
        pk_ = array.get(hMfe, j)
        totPk += pk_
        totLeft += (pk_ - rr_) * array.get(hRsk, j) * ccyPerPt * (lotSize / 0.01)
        wentGreen += pk_ > 0 ? 1 : 0
        totR += rr_
        totM += (array.get(hExt, j) - array.get(hEnt, j)) * array.get(hDir, j)
                * ccyPerPt * (lotSize / 0.01)
        wins += rr_ > 0 ? 1 : 0
        nTp  += wy_ == "TP" ? 1 : 0
        nSl  += wy_ == "SL" ? 1 : 0
        nErl += (wy_ == "TRL" or wy_ == "TIME" or wy_ == "FLIP") ? 1 : 0
    for k = 0 to shown - 1
        j  = n - 1 - k
        d_ = array.get(hDir, j)
        r_ = array.get(hR, j)
        m_ = (array.get(hExt, j) - array.get(hEnt, j)) * d_ * ccyPerPt * (lotSize / 0.01)
        col = r_ >= 0 ? accBull : accBear
        pkr = array.get(hMfe, j)
        recCell(0, k + 1, str.tostring(n - k), color.new(chart.fg_color, 45), false)
        recCell(1, k + 1, d_ > 0 ? "L" : "S", col, false)
        recCell(2, k + 1, str.tostring(r_, "#.##"), col, false)
        // amber when the trade gave back most of its best: an execution
        // problem, not a signal problem
        recCell(3, k + 1, str.tostring(pkr, "#.##"),
             pkr > 0 and r_ < pkr * 0.5 ? color.new(#FFB300, 0)
             : color.new(chart.fg_color, 45), false)
        recCell(4, k + 1, (m_ >= 0 ? "+" : "") + str.tostring(m_, "#.##"), col, false)
        recCell(5, k + 1, array.get(hWhy, j), col, false)
    totRow = shown + 1
    recCell(0, totRow, "TOTAL " + str.tostring(n), chart.fg_color, true)
    recCell(1, totRow, str.tostring(math.round(100.0 * wins / n)) + "%", chart.fg_color, true)
    recCell(2, totRow, str.tostring(totR, "#.#"), totR >= 0 ? accBull : accBear, false)
    recCell(3, totRow, str.tostring(totPk, "#.#"), color.new(chart.fg_color, 45), false)
    recCell(4, totRow, (totM >= 0 ? "+" : "") + str.tostring(totM, "#.##"),
         totM >= 0 ? accBull : accBear, false)
    recCell(5, totRow, "avg " + str.tostring(totR / n, "#.##") + "R",
         chart.fg_color, true)
    // How the trades actually ENDED. If "early" dominates, your target is too
    // far away for this market; if SL dominates, your stop is too close.
    mixRow = totRow + 1
    recCell(0, mixRow, "how they ended", chart.fg_color, true)
    recCell(1, mixRow, "TP " + str.tostring(nTp), accBull, false)
    recCell(2, mixRow, "early " + str.tostring(nErl), color.new(#FFB300, 0), false)
    recCell(3, mixRow, "SL " + str.tostring(nSl), accBear, false)
    recCell(4, mixRow, str.tostring(entryDelay) + "-bar fill", chart.fg_color, true)
    recCell(5, mixRow, "", chart.fg_color, true)

    // ---- THE EXECUTION ROW.
    // "kept" is what was actually banked as a share of what the trades were
    // worth at their best. It separates a signal problem from an execution
    // problem: if most trades go green and "kept" is low, the entries are
    // fine and the exits are throwing the money away.
    exRow = mixRow + 1
    capture = totPk > 0 ? 100.0 * totR / totPk : 0.0
    recCell(0, exRow, "EXECUTION", chart.fg_color, true)
    recCell(1, exRow, str.tostring(math.round(100.0 * wentGreen / n)) + "% green",
         wentGreen > n / 2 ? accBull : color.new(chart.fg_color, 45), false)
    recCell(2, exRow, "kept " + str.tostring(capture, "#") + "%",
         capture >= 50 ? accBull : capture >= 25 ? color.new(#FFB300, 0) : accBear, false)
    recCell(3, exRow, "left " + str.tostring(totPk - totR, "#.#") + "R",
         color.new(#FFB300, 0), false)
    recCell(4, exRow, "-" + str.tostring(totLeft, "#.##"),
         color.new(#FFB300, 0), false)
    recCell(5, exRow, "left behind", chart.fg_color, true)

// ──────────────────────────────────── ALERTS ────────────────────────────────
// Alerts fire on firedLong/firedShort - the direction actually TAKEN - not on
// canFire and goLong. With "wait for a retest" on, the trade direction comes
// from the armed setup, which can differ from goLong on the retest bar: the
// old condition could alert BUY on a bar the indicator went short.
alertcondition(firedLong,  "Liquidity Sniper BUY",
     "LiqSniper BUY {{ticker}} {{interval}} at {{close}}")
alertcondition(firedShort, "Liquidity Sniper SELL",
     "LiqSniper SELL {{ticker}} {{interval}} at {{close}}")
alertcondition(firedLong or firedShort, "Liquidity Sniper ANY",
     "LiqSniper signal {{ticker}} {{interval}} at {{close}}")
