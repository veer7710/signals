//@version=6
// ============================================================================
//  LIQUIDITY SNIPER v2  —  reaction memory
//  Levels · clustered zones · sweep vs break · "price has been here before"
// ============================================================================
//
//  WHAT THIS ANSWERS
//  Veer: "we can be able to react to previous levels we need to see if price
//  is near a price where it previously reacted too".
//
//  Almost every liquidity indicator draws a line at a swing and forgets it.
//  This one keeps a MEMORY of what happened at each price: how many times
//  price arrived there, how many of those arrivals produced a real move away,
//  how big that move was, and whether the level has since been cut through.
//  A price that has turned the market three times is a different object from
//  a random swing high, and only one of them deserves a line on the chart.
//
//  WHAT IT INHERITS FROM THE TWO LUXALGO SCRIPTS
//   - "Buyside & Sellside Liquidity": a zone is only drawn where SEVERAL
//     pivots cluster together, and it is drawn with WIDTH rather than as a
//     line. Price reacts near a level, not on it.
//   - "Liquidity Sweeps": a WICK through a level (pierced, closed back) and a
//     CLOSE through it are different events and are tracked separately.
//  Both are CC BY-NC-SA 4.0, (c) LuxAlgo. The ideas are theirs; the code here
//  is written from scratch and the reaction memory is not in either of them.
//
//  WHAT IS MEASURED AND WHAT IS NOT — read before trusting a signal
//  Already measured in this project, on 10,000+ sweep events across GOLD,
//  US500, EURUSD and GBPUSD, first-touch resolution, ties counted as losses:
//      FADE the sweep (the retail assumption) : 44.5% win at 1R, GOLD 15m
//      a coin flip at the same bars           : 49.2%
//      FOLLOW the sweep                       : 54.1%
//  FOLLOW beat FADE on 5 of 5 markets. Fading was WORSE THAN RANDOM. That is
//  why this script defaults to follow-the-break and treats a rejection as the
//  weaker of the two signals rather than the headline.
//
//  NOT yet measured: whether the reaction memory below actually predicts
//  anything. Reaction counts, cluster sizes and level ages are being tested
//  as this ships. Until those numbers exist the scoring here is a HYPOTHESIS
//  drawn on the chart, not a finding. It is labelled UNPROVEN in the panel
//  and it should stay labelled that way until the numbers say otherwise.
// ============================================================================

// max_bars_back MUST be declared. A level can be born 1500 bars ago and its
// line is drawn from there, and without this Pine kills the script at runtime:
// "The requested historical offset (1500) is beyond the historical buffer's
// limit (1499)". That is why the indicator kept turning itself off.
indicator("Liquidity Sniper v2", "LIQ v2", overlay = true,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500,
     max_bars_back = 5000)

// ---------------------------------------------------------------- inputs ---
gL = "LEVELS"
swing    = input.int(5, "Swing size (bars either side)", minval = 1, maxval = 50, group = gL,
     tooltip = "A pivot needs this many bars on both sides. It therefore CONFIRMS this many bars late, which is not a delay that can be removed - it is what makes the pivot real rather than provisional.")
maxLv    = input.int(40, "Most levels to keep", minval = 5, maxval = 120, group = gL)
tolAtr   = input.float(0.25, "Near a level means within (x ATR)", minval = 0.02, maxval = 3.0, step = 0.01, group = gL,
     tooltip = "Price reacts NEAR a level, not on it. An exact-touch rule fires almost never and misses the reaction it was built to catch.")
brkAtr   = input.float(0.20, "Broken once closed this far past (x ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = gL)
ageBars  = input.int(1500, "Forget a level after this many bars", minval = 50, maxval = 20000, group = gL,
     tooltip = "In BARS, deliberately. Flip and pivot density are per-bar properties; converting this to minutes made an equivalent setting meaningless on M1 once already.")

gR = "REACTION MEMORY"
reactAtr = input.float(1.0, "A reaction is a move away of (x ATR)", minval = 0.2, maxval = 6.0, step = 0.1, group = gR)
reactWin = input.int(12, "   ...within this many bars of the touch", minval = 2, maxval = 100, group = gR)
touchCool= input.int(6, "Bars before the same level can be touched again", minval = 1, maxval = 100, group = gR,
     tooltip = "Without this, one slow approach across eight bars is counted as eight separate touches and the memory becomes meaningless.")
minReact = input.int(1, "Only draw levels with at least this many reactions", minval = 0, maxval = 10, group = gR)

gZ = "ZONES  (the LuxAlgo clustering idea)"
useZone  = input.bool(true, "Merge nearby levels into a zone", group = gZ)
clustAtr = input.float(0.35, "   merge when within (x ATR)", minval = 0.05, maxval = 3.0, step = 0.05, group = gZ)
minClust = input.int(3, "   a zone needs at least this many pivots", minval = 1, maxval = 10, group = gZ,
     tooltip = "LuxAlgo's Buyside & Sellside Liquidity requires three (count > 2). Whether the third pivot actually earns its place is being measured; until then this is adjustable and defaults to two.")

gM = "HIGHER TIMEFRAMES  (M15 -> M5 -> M1)"
useMtf   = input.bool(true, "Pull levels from higher timeframes", group = gM,
     tooltip = "Veer's cascade: M15 finds the liquidity, M5 frames the setup, M1 times the entry. On an M1 chart this adds M5 and M15 pivots to the same memory, tagged by origin.")
tf1      = input.timeframe("5",  "   timeframe A", group = gM)
tf2      = input.timeframe("15", "   timeframe B", group = gM)

gS = "SIGNALS"
showSig  = input.bool(true, "BUY / SELL markers", group = gS)
sigMode  = input.string("Both", "On a level, act by", options = ["Follow the break", "Fade the rejection", "Both"], group = gS,
     tooltip = "BOTH by default now, because Veer asked for a signal when price REACTS at a zone, not only when it breaks one - a zone hit three times and rejected should mark three times. Read the evidence row in the panel before sizing them the same: measured on 10,000+ sweeps, FOLLOWING the break won on 5 of 5 markets (54.1%) and FADING was worse than a coin flip (44.5% against 49.2%). Both are drawn; they are not equally good.")
minScore = input.int(2, "Only signal at levels scoring at least", minval = 0, maxval = 10, group = gS)
sigCool  = input.int(10, "Bars between signals", minval = 1, maxval = 200, group = gS)

gB = "BREAK, RETEST, CONTINUE"
useRetest= input.bool(false, "Wait for the retest before continuing", group = gB,
     tooltip = "OFF by default, deliberately. This chart's job is to catch the WHOLE move; the retest is a SECOND entry into a move already identified, and that belongs in the EA where it can be sized and managed. Turn it on only to see where those entries would have been.")
retestWin= input.int(40, "   retest must come within (bars)", minval = 3, maxval = 500, group = gB)
retestGo = input.float(0.15, "   confirm when price moves this far away (x ATR)", minval = 0.02, step = 0.05, group = gB)

gK = "SCALPS INSIDE THE MOVE"
useScalp = input.bool(true, "Also signal the smaller zones inside a run", group = gK,
     tooltip = "The big move is one trade. The pullbacks inside it are others. A zone that scores below the BUY/SELL threshold but is still real gets a small marker rather than nothing - so the scalps are visible without pretending they are the same quality as the main entry.")
scalpMin = input.int(1, "   a scalp needs a score of at least", minval = 0, maxval = 10, group = gK)

gX = "EXITS"
useExit  = input.bool(true, "Mark where the trade runs into the next zone", group = gX,
     tooltip = "Price ARRIVING at an opposing zone is one event. Sitting inside it for forty bars is still one event. The first version marked every bar and covered the chart in crosses; this marks the arrival only.")
exitMinScore = input.int(2, "   only for zones scoring at least", minval = 0, maxval = 10, group = gX)
exitCool = input.int(15, "   and not again for (bars)", minval = 1, maxval = 200, group = gX)

gF = "SMC  —  displacement, fair value gaps, order blocks"
useSmc   = input.bool(true, "Require SMC confluence for the main signal", group = gF,
     tooltip = "A level breaking is common. A level breaking on a DISPLACEMENT candle that leaves a fair value gap behind is the thing worth trading, and it is what turns a break into a sniper entry: the gap gives you a price to come back to, so the entry is a limit rather than a chase.")
dispAtr  = input.float(1.5, "   displacement bar is at least (x ATR)", minval = 0.5, step = 0.1, group = gF)
useFvg   = input.bool(true, "   require a fair value gap", group = gF)
showFvg  = input.bool(true, "   draw the gaps", group = gF)
useIfvg  = input.bool(true, "   treat a filled gap as an inverse FVG", group = gF)
showOb   = input.bool(true, "   draw the order block behind the move", group = gF)

gP = "POSITION BOX"
showPos  = input.bool(true, "Track the live signal", group = gP)
posLots  = input.float(0.01, "   lots, for the P/L figure", minval = 0.01, step = 0.01, group = gP)
posCcy   = input.string("GBP", "   label", group = gP)
posRate  = input.float(0.79, "   account currency per USD", minval = 0.01, step = 0.01, group = gP,
     tooltip = "Gold is quoted in USD. 0.01 lots is 1 ounce, so a $1 move is $1. This converts that to your account currency for the box.")

gV = "LOOK"
// ONLY WHAT THE LUXALGO SCRIPTS DRAW.
// The first version drew a line for every remembered price - forty of them -
// and Veer's chart disappeared under them. LuxAlgo's Buyside & Sellside
// Liquidity draws a zone ONLY where three or more pivots cluster, and nothing
// else. That is the default here now: zones on, bare level lines OFF.
showZone = input.bool(true, "Liquidity zones (3+ pivots clustered)", group = gV)
showLine = input.bool(false, "Every remembered level (noisy - off)", group = gV)
showLab  = input.bool(true, "Zone labels", group = gV)
showNear = input.bool(true, "Warn when price is near a remembered level", group = gV)
showPan  = input.bool(true, "Panel", group = gV)
cSup     = input.color(color.new(#089981, 0), "Support", group = gV)
cRes     = input.color(color.new(#f23645, 0), "Resistance", group = gV)
cDead    = input.color(color.new(#787b86, 60), "Broken", group = gV)

// ------------------------------------------------------------------ core ---
atr = ta.atr(14)
tol = atr * tolAtr
n   = bar_index

// --------------------------------------------------------------- the type ---
// One remembered price. `reacts` is the field the whole script exists for:
// how many times price arrived here and was actually turned away.
type Lvl
    float px
    int   born
    int   dir        // +1 from a high (resistance), -1 from a low (support)
    int   src        // 0 chart, 1 timeframe A, 2 timeframe B
    int   members    // pivots merged into this level
    int   touches
    int   reacts
    float best       // biggest move it ever produced, in ATR
    bool  swept      // wicked through and closed back
    bool  broken     // closed through
    int   brokeBar   // when it broke, -1 if it has not
    bool  retested   // price came back to it and left again, in the break direction
    int   backBar    // when price returned to it, -1 if not currently back
    int   lastTouch
    int   pendBar    // bar the current approach started, -1 if none
    float pendExt    // extreme reached during that approach
    line  ln
    box   bz
    label lb

var array<Lvl> LV = array.new<Lvl>()

// ------------------------------------------------------------- functions ---
// Pine is single pass: every function must be defined before it is called.

// How good is this remembered price? Deliberately simple and deliberately
// additive - a score built from three readings that can each be checked
// against the chart by eye, rather than a weighting nobody can audit.
scoreOf(int reacts, int members, float best, bool broken) =>
    int sc = 0
    sc := sc + math.min(reacts, 3)
    sc := sc + (members >= minClust ? 1 : 0)
    sc := sc + (best >= reactAtr * 2 ? 1 : 0)
    broken ? 0 : sc

colOf(int dir, bool broken) =>
    broken ? cDead : (dir > 0 ? cRes : cSup)

// Merge a newly confirmed pivot into an existing level if it lands within
// clustAtr of one, otherwise return -1. This is the clustering idea from
// LuxAlgo's Buyside & Sellside Liquidity, done incrementally as pivots
// arrive instead of by rescanning a fixed history every bar.
findNear(float px, int dir) =>
    int hit = -1
    if array.size(LV) > 0
        for i = 0 to array.size(LV) - 1
            Lvl L = array.get(LV, i)
            if hit == -1 and L.dir == dir and not L.broken
                if math.abs(L.px - px) <= atr * clustAtr
                    hit := i
    hit

// ---------------------------------------------------------------- SMC ------
// DISPLACEMENT, FAIR VALUE GAP, ORDER BLOCK.
//
// A level breaking is common and mostly meaningless. A level breaking on a
// DISPLACEMENT candle that leaves a FAIR VALUE GAP behind is the event worth
// trading, and it is what turns a break into a sniper entry rather than a
// chase: the gap is a price the market has shown it will come back to, so the
// entry can be a LIMIT sitting there instead of a market order at the worst
// price of the move.
//
// A fair value gap is three bars where the middle one moved so hard that bar
// 1's high never met bar 3's low. Nothing traded in between. That untraded
// band is the gap.
//
// An INVERSE fair value gap is one that has since been closed THROUGH. It
// stops being support and starts being resistance, which is why it is tracked
// rather than deleted.
//
// NONE OF THIS IS MEASURED YET. Displacement, FVGs and order blocks are not in
// any experiment in this project. They are here because Veer asked for them
// and because they give the entry a defined price; the panel says UNPROVEN and
// it should keep saying that until the numbers exist.

// bullish gap: this bar's low is above the high of two bars back
fvgUp   = low > high[2] and close > open
fvgDn   = high < low[2] and close < open
fvgUpTop = low
fvgUpBot = high[2]
fvgDnTop = low[2]
fvgDnBot = high

isDisp  = atr > 0 and (high - low) >= dispAtr * atr

// the ORDER BLOCK behind a move: the last candle of the opposite colour
// before the displacement. It is where the move was actually loaded.
obUpTop = high[1]
obUpBot = low[1]
obIsUp  = isDisp and close > open and close[1] < open[1]
obIsDn  = isDisp and close < open and close[1] > open[1]

var box  fvgBox = na
var box  obBox  = na
var float lastFvgMid = na
var int   lastFvgDir = 0
var int   lastFvgBar = -9999

if useFvg and (fvgUp or fvgDn)
    lastFvgDir := fvgUp ? 1 : -1
    lastFvgMid := fvgUp ? math.avg(fvgUpTop, fvgUpBot) : math.avg(fvgDnTop, fvgDnBot)
    lastFvgBar := n
    if showFvg
        top = fvgUp ? fvgUpTop : fvgDnTop
        bot = fvgUp ? fvgUpBot : fvgDnBot
        col = fvgUp ? cSup : cRes
        fvgBox := box.new(n - 2, top, n + 12, bot,
             border_color = color.new(col, 80), bgcolor = color.new(col, 90))

// INVERSE FVG: the gap has been closed through, so it now works the other way
ifvgFlip = useIfvg and lastFvgDir != 0 and not na(lastFvgMid)
     and (lastFvgDir == 1 ? close < lastFvgMid : close > lastFvgMid)

if showOb and (obIsUp or obIsDn)
    obBox := box.new(n - 1, obUpTop, n + 6, obUpBot,
         border_color = color.new(obIsUp ? cSup : cRes, 60),
         bgcolor = color.new(obIsUp ? cSup : cRes, 92))

// ------------------------------------------------------------ new pivots ---
ph = ta.pivothigh(swing, swing)
pl = ta.pivotlow(swing, swing)

// The move a pivot produced in the bars immediately after it. Available at
// confirmation time because those bars have already closed - the pivot is
// confirmed `swing` bars late, and this reads exactly those `swing` bars.
hiRun = ta.highest(high, swing)
loRun = ta.lowest(low, swing)

f_mtf() =>
    [ta.pivothigh(swing, swing), ta.pivotlow(swing, swing), ta.atr(14)]

[ph1, pl1, a1] = request.security(syminfo.tickerid, tf1, f_mtf(), lookahead = barmerge.lookahead_off)
[ph2, pl2, a2] = request.security(syminfo.tickerid, tf2, f_mtf(), lookahead = barmerge.lookahead_off)

addLevel(float px, int dir, int src, float strength) =>
    int at = findNear(px, dir)
    if at >= 0
        Lvl L = array.get(LV, at)
        L.members := L.members + 1
        L.px := (L.px * (L.members - 1) + px) / L.members
        L.best := math.max(L.best, strength)
    else
        array.unshift(LV, Lvl.new(px, n, dir, src, 1, 0, 0, strength,
             false, false, -1, false, -1, -9999, -1, na, na, na, na))
    true

// A pivot high's strength is how far price fell away from it in the bars that
// confirmed it; a pivot low's is how far it rose. Divided by ATR so the number
// means the same thing on M1 as on M15.
strHi = atr > 0 ? (ph - loRun) / atr : 0.0
strLo = atr > 0 ? (hiRun - pl) / atr : 0.0

if not na(ph)
    addLevel(ph, 1, 0, strHi)
if not na(pl)
    addLevel(pl, -1, 0, strLo)

if useMtf
    if not na(ph1) and ph1 != ph1[1]
        addLevel(ph1, 1, 1, 0.0)
    if not na(pl1) and pl1 != pl1[1]
        addLevel(pl1, -1, 1, 0.0)
    if not na(ph2) and ph2 != ph2[1]
        addLevel(ph2, 1, 2, 0.0)
    if not na(pl2) and pl2 != pl2[1]
        addLevel(pl2, -1, 2, 0.0)

// -------------------------------------------------- the state machine ------
// Every level, every bar: has price arrived, has it been turned away, has it
// been cut through. All three are decided on bars that have already closed.
var int  lastSigBar = -9999
var int  lastExitBar = -9999
var bool sigBuy  = false
var bool sigSell = false
var bool retBuy  = false
var bool retSell = false
var bool scpBuy  = false
var bool scpSell = false
var bool exitUp  = false
var bool exitDn  = false
var int  nearCount = 0
var float nearPx = na
var int  nearScore = 0

sigBuy := false
sigSell := false
retBuy := false
retSell := false
scpBuy := false
scpSell := false
exitUp := false
exitDn := false
nearCount := 0
nearPx := na
nearScore := 0

if array.size(LV) > 0
    for i = array.size(LV) - 1 to 0
        Lvl L = array.get(LV, i)

        // ---- retire: too old, or too far behind price to matter
        bool stale = (n - L.born) > ageBars
        if stale
            if not na(L.ln)
                line.delete(L.ln)
            if not na(L.bz)
                box.delete(L.bz)
            if not na(L.lb)
                label.delete(L.lb)
            array.remove(LV, i)
            continue

        // ---- BROKEN: a CLOSE through it, by more than noise
        bool closedThru = L.dir > 0 ? (close > L.px + atr * brkAtr) : (close < L.px - atr * brkAtr)
        if closedThru and not L.broken
            L.broken := true
            L.brokeBar := n
            L.pendBar := -1
            // FOLLOW the break, WITH CONFLUENCE. A break on an ordinary bar
            // is just a break; a break on a DISPLACEMENT candle that leaves a
            // fair value gap behind is the entry. Requiring both is what turns
            // forty signals a day into the handful that are the actual move -
            // which is what Veer asked for: catch the whole move, not every
            // wobble that crosses a line.
            bool smcOk = not useSmc or (isDisp and (not useFvg
             or (lastFvgBar >= n - 3 and lastFvgDir == L.dir)))
            if showSig and (sigMode != "Fade the rejection") and smcOk
                if scoreOf(L.reacts, L.members, L.best, false) >= minScore
                 and n - lastSigBar >= sigCool
                    if L.dir > 0
                        sigBuy := true
                    else
                        sigSell := true
                    lastSigBar := n

        // ---- SWEPT: a WICK through it that closed back on the original side
        bool wickThru = L.dir > 0 ? (high > L.px and close < L.px) : (low < L.px and close > L.px)
        if wickThru and not L.broken
            L.swept := true

        // ---- TOUCH: price entered the tolerance band, not too soon after
        //      the last time it did. Without the cooldown one slow approach
        //      across eight bars counts as eight touches.
        bool inBand = (high >= L.px - tol) and (low <= L.px + tol)
        if inBand and not L.broken and (n - L.lastTouch) >= touchCool
            L.touches := L.touches + 1
            L.lastTouch := n
            L.pendBar := n
            L.pendExt := L.dir > 0 ? high : low

        // ---- REACTION: did that touch actually turn price away?
        if L.pendBar >= 0 and not L.broken
            L.pendExt := L.dir > 0 ? math.max(L.pendExt, high) : math.min(L.pendExt, low)
            float away = L.dir > 0 ? (L.px - low) : (high - L.px)
            if atr > 0 and away >= reactAtr * atr
                L.reacts := L.reacts + 1
                L.best := math.max(L.best, away / atr)
                L.pendBar := -1
                // FADE the rejection. Off by default: fading measured WORSE
                // than a coin flip on every market tested. Present to be
                // tested, not because it is recommended.
                // NOTE: no SMC gate here on purpose. Displacement and a gap
                // describe a BREAK; a rejection is the opposite event and
                // requiring a displacement candle would silence exactly the
                // signal Veer is asking for - price arriving at a zone and
                // turning away from it.
                if showSig and (sigMode != "Follow the break")
                    if scoreOf(L.reacts, L.members, L.best, false) >= minScore
                     and n - lastSigBar >= sigCool
                        if L.dir > 0
                            sigSell := true
                        else
                            sigBuy := true
                        lastSigBar := n
            else if (n - L.pendBar) > reactWin
                L.pendBar := -1

        // ---- BREAK, RETEST, CONTINUE
        // The level broke. Price came back to it. If it leaves again in the
        // direction of the break, the level that was resistance is now
        // support and the original move has something to lean on. This is
        // the entry Veer described - break, wait for the retest, then
        // continue - and it is deliberately a SEPARATE signal from the break
        // itself so the two can be compared on the journal, not blended.
        if useRetest and L.broken and not L.retested and L.brokeBar > 0
            bool inWindow = (n - L.brokeBar) <= retestWin
            if inWindow
                bool cameBack = (low <= L.px + tol) and (high >= L.px - tol)
                if cameBack and L.backBar < 0
                    L.backBar := n
                if L.backBar >= 0
                    bool away = L.dir > 0 ? (close > L.px + atr * retestGo)
                     : (close < L.px - atr * retestGo)
                    if away
                        L.retested := true
                        L.backBar := -1
                        if showSig and n - lastSigBar >= sigCool
                            if scoreOf(L.reacts, L.members, L.best, false) >= minScore
                                if L.dir > 0
                                    retBuy := true
                                else
                                    retSell := true
                                lastSigBar := n
            else
                L.backBar := -1

        // ---- SCALPS INSIDE THE MOVE
        // A zone too weak to carry the main entry is still a place price
        // pauses. Marked small and separately, never dressed up as the same
        // trade.
        if useScalp and not L.broken
            int ssc = scoreOf(L.reacts, L.members, L.best, false)
            if ssc >= scalpMin and ssc < minScore
                if math.abs(close - L.px) <= tol and n - lastSigBar >= 2
                    if L.dir > 0
                        scpSell := true
                    else
                        scpBuy := true

        // ---- EXIT MARKERS. ARRIVAL ONLY.
        // The first version tested "is price inside the zone" on every bar, so
        // a forty-bar consolidation inside one zone drew forty crosses and the
        // chart filled up. Veer, exactly: "it keeps producing random ass x
        // signs". It is ONE event - the arrival - and only worth marking at a
        // zone strong enough to be worth banking into.
        if useExit and not L.broken and L.reacts >= minReact
            bool inNow  = math.abs(close - L.px) <= tol * 1.5
            bool inPrev = math.abs(close[1] - L.px) <= tol * 1.5
            if inNow and not inPrev and n - lastExitBar >= exitCool
                if scoreOf(L.reacts, L.members, L.best, false) >= exitMinScore
                    if L.dir > 0
                        exitUp := true
                    else
                        exitDn := true
                    lastExitBar := n

        // ---- is price near a remembered price RIGHT NOW?
        int sc = scoreOf(L.reacts, L.members, L.best, L.broken)
        if not L.broken and L.reacts >= minReact
            if math.abs(close - L.px) <= tol
                nearCount := nearCount + 1
                if sc > nearScore
                    nearScore := sc
                    nearPx := L.px

        array.set(LV, i, L)

// ------------------------------------------------------------- trimming ----
// Keep the best, not the newest. A level that has turned price three times is
// worth more chart space than one that confirmed twenty bars ago.
if array.size(LV) > maxLv
    int worstAt = 0
    int worstSc = 99
    for i = 0 to array.size(LV) - 1
        Lvl L = array.get(LV, i)
        int sc = scoreOf(L.reacts, L.members, L.best, L.broken)
        if sc < worstSc
            worstSc := sc
            worstAt := i
    Lvl W = array.get(LV, worstAt)
    if not na(W.ln)
        line.delete(W.ln)
    if not na(W.bz)
        box.delete(W.bz)
    if not na(W.lb)
        label.delete(W.lb)
    array.remove(LV, worstAt)

// ------------------------------------------------------------- drawing -----
// Drawings are created and then MUTATED, never created inside a ternary:
// Pine evaluates both branches of a ternary, so a drawing in one leaks an
// object every bar. That bug has already been fixed once in this project.
if barstate.islast and array.size(LV) > 0
    for i = 0 to array.size(LV) - 1
        Lvl L = array.get(LV, i)
        int sc = scoreOf(L.reacts, L.members, L.best, L.broken)
        bool worth = sc >= 0 and L.reacts >= minReact
        color c = colOf(L.dir, L.broken)

        if showLine and worth
            int x1 = math.max(L.born, n - 4800)   // never past the buffer
            if na(L.ln)
                L.ln := line.new(x1, L.px, n + 6, L.px, color = c, width = 1)
            else
                line.set_xy1(L.ln, x1, L.px)
                line.set_xy2(L.ln, n + 6, L.px)
                line.set_color(L.ln, c)
                line.set_width(L.ln, sc >= 3 ? 2 : 1)

        if showZone and useZone and worth and L.members >= minClust
            float top = L.px + tol
            float bot = L.px - tol
            int bx1 = math.max(L.born, n - 4800)
            if na(L.bz)
                L.bz := box.new(bx1, top, n + 6, bot,
                     border_color = color.new(c, 70), bgcolor = color.new(c, 88))
            else
                box.set_lefttop(L.bz, bx1, top)
                box.set_rightbottom(L.bz, n + 6, bot)
                box.set_bgcolor(L.bz, color.new(c, L.broken ? 94 : 88))
                box.set_border_color(L.bz, color.new(c, 70))

        if showLab and worth and sc >= 2
            string txt = str.tostring(L.reacts) + "x"
                 + (L.members >= minClust ? " z" + str.tostring(L.members) : "")
                 + (L.src == 1 ? " " + tf1 : (L.src == 2 ? " " + tf2 : ""))
                 + (L.swept and not L.broken ? " swept" : "")
            if na(L.lb)
                L.lb := label.new(n + 6, L.px, txt, style = label.style_label_left,
                     color = color.new(c, 85), textcolor = c, size = size.tiny)
            else
                label.set_xy(L.lb, n + 6, L.px)
                label.set_text(L.lb, txt)
                label.set_textcolor(L.lb, c)
                label.set_color(L.lb, color.new(c, 85))

        array.set(LV, i, L)

// -------------------------------------------------------------- signals ----
plotshape(showSig and sigBuy, "BUY", shape.labelup, location.belowbar,
     color.new(cSup, 0), text = "BUY", textcolor = color.white, size = size.small)
plotshape(showSig and sigSell, "SELL", shape.labeldown, location.abovebar,
     color.new(cRes, 0), text = "SELL", textcolor = color.white, size = size.small)

// A quiet marker, not an arrow: price is sitting on a price it has been
// turned away from before. It is information, not an instruction.
plotshape(showNear and nearCount > 0 and not sigBuy and not sigSell,
     "at a remembered level", shape.circle, location.absolute,
     color.new(color.orange, 40), size = size.tiny)

plotshape(showSig and retBuy, "BUY retest", shape.labelup, location.belowbar,
     color.new(cSup, 20), text = "RETEST", textcolor = color.white, size = size.tiny)
plotshape(showSig and retSell, "SELL retest", shape.labeldown, location.abovebar,
     color.new(cRes, 20), text = "RETEST", textcolor = color.white, size = size.tiny)

// scalps: visible, and visibly smaller than the main entry
plotshape(showSig and scpBuy and not sigBuy and not retBuy, "scalp buy",
     shape.triangleup, location.belowbar, color.new(cSup, 45), size = size.tiny)
plotshape(showSig and scpSell and not sigSell and not retSell, "scalp sell",
     shape.triangledown, location.abovebar, color.new(cRes, 45), size = size.tiny)

// not a reversal signal - a reason to bank something
plotshape(useExit and exitUp, "into resistance", shape.xcross, location.abovebar,
     color.new(color.orange, 25), size = size.tiny)
plotshape(useExit and exitDn, "into support", shape.xcross, location.belowbar,
     color.new(color.orange, 25), size = size.tiny)

// ------------------------------------------------------- POSITION BOX ------
// What the signal is actually WORTH, live, in the currency Veer thinks in.
// Not a backtest and not a scoreboard - the trade that is on right now: where
// it entered, what it is worth, the best it has been, and how much of that
// best has already gone. That last row is the whole problem this project has
// been chasing, and until now it has only ever been visible after the fact.
//
// GOLD is quoted in USD and 0.01 lots is one ounce, so a $1 move is $1.
// posRate converts that to the account currency for display only.
var bool  pActive = false
var int   pDir    = 0
var float pEntry  = na
var int   pBar    = 0
var float pPeak   = 0.0
var float pWorst  = 0.0
var float pLimit  = na

if showPos and (sigBuy or sigSell or retBuy or retSell)
    pActive := true
    pDir    := (sigBuy or retBuy) ? 1 : -1
    pEntry  := close
    pBar    := n
    pPeak   := 0.0
    pWorst  := 0.0
    // the SNIPER price: where a limit would sit, at the gap the move left
    pLimit  := (lastFvgBar >= n - 4 and not na(lastFvgMid)) ? lastFvgMid : na

if pActive and not na(pEntry)
    fav = (pDir == 1 ? high - pEntry : pEntry - low)
    adv = (pDir == 1 ? pEntry - low : high - pEntry)
    pPeak  := math.max(pPeak, fav)
    pWorst := math.max(pWorst, adv)

pNow   = pActive and not na(pEntry) ? (pDir == 1 ? close - pEntry : pEntry - close) : 0.0
oz     = posLots * 100.0
pMoney = pNow * oz * posRate
pBest  = pPeak * oz * posRate
pBack  = (pPeak - pNow) * oz * posRate
pKept  = pPeak > 0 ? 100.0 * pNow / pPeak : 0.0

// SOLID and READABLE. The first version used transparent cells and tiny text
// and Veer could not read it off the screen: "that position box is so blurry",
// "the profit box is see thru and not good". A panel you have to squint at is
// a panel that does not exist.
var table B = table.new(position.bottom_left, 2, 8, border_width = 1,
     bgcolor = #0d1117, frame_color = color.new(color.teal, 20),
     frame_width = 2, border_color = #30363d)

f_b(int r, string a, string b, color c) =>
    table.cell(B, 0, r, a, text_color = #8b949e, text_size = size.normal,
         text_halign = text.align_left, bgcolor = #0d1117)
    table.cell(B, 1, r, b, text_color = c, text_size = size.normal,
         text_halign = text.align_right, bgcolor = #0d1117)

if showPos and barstate.islast
    table.cell(B, 0, 0, "POSITION", text_color = color.white,
         bgcolor = #1f6feb, text_size = size.normal)
    table.cell(B, 1, 0, pActive ? (pDir == 1 ? "LONG" : "SHORT") : "flat",
         text_color = color.white, bgcolor = #1f6feb, text_size = size.normal)

    f_b(1, "entry", pActive ? str.tostring(pEntry, format.mintick) : "-",
         color.white)
    f_b(2, "now", pActive ? str.tostring(pMoney, "#.##") + " " + posCcy : "-",
         pMoney >= 0 ? cSup : cRes)
    f_b(3, "peak", pActive ? str.tostring(pBest, "#.##") + " " + posCcy : "-",
         color.white)
    f_b(4, "given back", pActive ? str.tostring(pBack, "#.##") + " " + posCcy : "-",
         pBack > 0 ? color.orange : color.silver)
    f_b(5, "kept of peak", pActive and pPeak > 0
         ? str.tostring(pKept, "#") + "%" : "-",
         pKept >= 60 ? cSup : (pKept >= 30 ? color.orange : cRes))
    f_b(6, "bars held", pActive ? str.tostring(n - pBar) : "-", color.silver)
    f_b(7, "limit / gap", not na(pLimit)
         ? str.tostring(pLimit, format.mintick) : "no gap left behind",
         not na(pLimit) ? color.yellow : color.silver)

alertcondition(retBuy, "LIQ v2 RETEST BUY", "Liquidity Sniper v2: retest BUY")
alertcondition(retSell, "LIQ v2 RETEST SELL", "Liquidity Sniper v2: retest SELL")
alertcondition(exitUp or exitDn, "LIQ v2 into a zone",
     "Price has reached an opposing zone - consider banking")
alertcondition(sigBuy, "LIQ v2 BUY", "Liquidity Sniper v2: BUY")
alertcondition(sigSell, "LIQ v2 SELL", "Liquidity Sniper v2: SELL")
alertcondition(nearCount > 0, "LIQ v2 near a remembered level",
     "Price is at a level it has reacted to before")

// ---------------------------------------------------------------- panel ----
var table P = table.new(position.top_right, 2, 8, border_width = 1,
     bgcolor = #0d1117, frame_color = #30363d, frame_width = 1,
     border_color = #30363d)

if showPan and barstate.islast
    int nLv = array.size(LV)
    int nZone = 0
    int nStrong = 0
    if nLv > 0
        for i = 0 to nLv - 1
            Lvl L = array.get(LV, i)
            if L.members >= minClust and not L.broken
                nZone := nZone + 1
            if scoreOf(L.reacts, L.members, L.best, L.broken) >= 3
                nStrong := nStrong + 1

    table.cell(P, 0, 0, "LIQUIDITY SNIPER v2", text_color = color.white,
         bgcolor = color.new(color.blue, 40), text_size = size.small)
    table.cell(P, 1, 0, timeframe.period, text_color = color.white,
         bgcolor = color.new(color.blue, 40), text_size = size.small)

    table.cell(P, 0, 1, "levels remembered", text_color = color.silver, text_size = size.tiny)
    table.cell(P, 1, 1, str.tostring(nLv), text_color = color.white, text_size = size.tiny)

    table.cell(P, 0, 2, "clustered zones", text_color = color.silver, text_size = size.tiny)
    table.cell(P, 1, 2, str.tostring(nZone), text_color = color.white, text_size = size.tiny)

    table.cell(P, 0, 3, "scoring 3+", text_color = color.silver, text_size = size.tiny)
    table.cell(P, 1, 3, str.tostring(nStrong),
         text_color = nStrong > 0 ? color.lime : color.silver, text_size = size.tiny)

    table.cell(P, 0, 4, "price at a known level", text_color = color.silver, text_size = size.tiny)
    table.cell(P, 1, 4, nearCount > 0 ? str.tostring(nearCount) + " (score "
         + str.tostring(nearScore) + ")" : "no",
         text_color = nearCount > 0 ? color.orange : color.silver, text_size = size.tiny)

    table.cell(P, 0, 5, "acting by", text_color = color.silver, text_size = size.tiny)
    table.cell(P, 1, 5, sigMode, text_color = color.white, text_size = size.tiny)

    table.cell(P, 0, 6, "evidence", text_color = color.silver, text_size = size.tiny)
    table.cell(P, 1, 6, "follow 54.1% vs fade 44.5%", text_color = color.white, text_size = size.tiny)

    table.cell(P, 0, 7, "reaction scoring", text_color = color.silver, text_size = size.tiny)
    table.cell(P, 1, 7, "UNPROVEN - being tested", text_color = color.orange, text_size = size.tiny)
