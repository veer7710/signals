//@version=6
// IF LINE 1 ABOVE SHOWS ONE SLASH, YOUR PASTE DROPPED A CHARACTER.
// It must read exactly:  //@version=6
// ---------------------------------------------------------------------------
//  The "3 candles" ORDER BLOCK rule is from "Order Block Finder" by wugamlo,
//  licensed under the Mozilla Public License 2.0 - https://mozilla.org/MPL/2.0/
//  MPL-2.0 permits commercial use, modification and redistribution provided
//  this notice is kept.
//
//  The "volume pivot" ORDER BLOCK rule is adapted from "Order Block Detector"
//  by LuxAlgo, licensed CC BY-NC-SA 4.0 -
//  https://creativecommons.org/licenses/by-nc-sa/4.0/
//  Attribution: LuxAlgo. If this script is ever PUBLISHED, the NonCommercial
//  and ShareAlike terms apply to it; private use is not distribution.
//
//  ZONES vs SIGNALS, and the difference is the whole point:
//    A SIGNAL - a BUY or SELL mark - can NEVER be removed. Every one is drawn
//    with plotshape on a confirmed bar, which cannot be deleted or moved
//    afterwards. That is the guarantee Veer asked for: "make sure like signals
//    dont disappear some indictors do that to scam u". It holds absolutely.
//    A ZONE is live context, not history. A block price has traded through is
//    finished, so it comes off the chart to keep it clean - which is what Veer
//    asked for: "i dont want all blocks drawn, on screen i want a clean chart".
//    Switch on "Keep dead zones" if you want to study them instead.
// ---------------------------------------------------------------------------
// ===========================================================================
//  LIQUIDITY SNIPER 2.0
//
//  THREE SIGNALS. Every one measured on 157,051 real M1 bars built from
//  18,816,940 bid/ask ticks, each bar charged its own spread, each against a
//  control that keeps the geometry and destroys only the timing.
//
//  =========================================================================
//  E-165, 2026-09-06: THE SWEEP IS DISPROVEN. READ THIS FIRST.
//
//  The backtest behind every number in this file was booking the ENTRY at the
//  level, on bars that had already OPENED past it. The sweep bar is REQUIRED to
//  be a wick - it pokes through the level and closes back - so on 75% of setups
//  the next bar opens on the far side and no order could still be resting at
//  the level. The fill is the open, and it is worse, every time.
//
//    M1  as shipped  n=2955  +254.8 pts  +0.0862/trade  t +14.59  win 55.8%
//        HONEST      n=2955   -30.4 pts  -0.0103/trade  t  -1.85  win 45.7%
//    M5  as shipped  n= 642  +133.1 pts  +0.2073/trade  t  +6.89  win 57.8%
//        HONEST      n= 643   -31.2 pts  -0.0485/trade  t  -1.78  win 47.6%
//
//  The proof it is the accounting and not the market: the same code extracted
//  +0.0226 a trade at t = 5 from a DRIFTLESS RANDOM WALK, on every seed tried.
//  Nothing real does that. With honest fills the random walk pays -0.039 - the
//  spread - which is exactly what a null should pay.
//
//  This is the same defect as E-151 (which killed the other three signals) one
//  step earlier in the same trade: E-151 fixed the EXIT fill and nobody thought
//  to look at the ENTRY.
//
//  THE SIGNALS ON THIS CHART ARE STILL DRAWN AND STILL CORRECT - a sweep is a
//  sweep, and the marks do not repaint. What is withdrawn is the claim that
//  trading them mechanically makes money. THE PANEL'S PROFIT FIGURE IS NOT
//  EVIDENCE OF AN EDGE. Read this chart, do not obey it.
//  =========================================================================
//
//    1  SWEEP          the level is taken by a WICK and price comes back
//                      WITHDRAWN BY E-165 - see the block above. The figures
//                      that stood here (+288.6 pts, +0.0713/trade, t 14.3,
//                      65 control se, 6 of 6 cells) were all computed with the
//                      impossible entry fill, and every one of them goes with
//                      it. Corrected: -0.0103 a trade on M1, t -1.85.
//                      >>> THE RULES ARE UNCHANGED. Veer: "dont change signals
//                      that already exist they are good". The engine below is
//                      lifted from 1.0 line for line.
//                      >>> THE NUMBERS ARE NOT. This block used to read "2579
//                      trades 65.1% win +309.5 pts", which was the output of
//                      the E-151 trail leak - a backtest filling at prices no
//                      order could rest at. It overstated the win rate by 11.8
//                      points and the per-trade edge by 68%. The signal is the
//                      same signal; the old figures were measurement, not
//                      strategy, and they were wrong.
//
//    2  BREAK+RETEST   the level is DISRESPECTED - a bar CLOSES through it -
//                      then price comes back, holds, and resumes
//                      OFF BY DEFAULT (E-151). The +97.3 pts once claimed
//                      here came from a broken trail. Under fills that could
//                      actually happen: -0.0095 a trade on M1, -0.0671 on M5,
//                      and negative in 5 of 6 off-XAU cells. It trades WITH
//                      the break, where the sweep fades it - a real and
//                      opposite idea that does not clear the spread.
//
//    3  ORDER BLOCK    price returns to the last opposing candle before a run
//                      OFF BY DEFAULT (E-151), same story: -0.0089 a trade at
//                      detection and -0.0319 on the return, negative in 6 of 6
//                      off-XAU cells. It is NOT noise - it beats a random
//                      entry (-0.048) - the structure is real, the margin is
//                      not. It stays on the chart as DRAWING.
//
//  They share ONE position at a time, first come first served, and the panel
//  keeps a SEPARATE BOOK for each so you can see which is carrying you.
//
//  SIGNALS NEVER DISAPPEAR. Every one fires only on a CONFIRMED bar and is
//  drawn with plotshape, which cannot be deleted or moved afterwards. Zones
//  fade when price invalidates them - that is the zone dying, not a signal
//  vanishing - and "Keep dead zones" turns even that off.
//
//  WHAT IS ON THE CHART, complete list:
//     BUY / SELL labels           the sweep signal
//     B+R triangles               break and retest
//     OB diamonds                 order block return
//     order block zones           the boxes
//     the two live levels         one per side, thin
//     BOS / CHoCH                 small text, the structure that matters
//     the live position           entry, stop and target, priced in money
//     one panel, bottom right
//  Removed since 1.0 because Veer said the zones looked horrible: fair value
//  gap boxes, sweep-area boxes, structure lines, the classic-sweep markers.
//
//  RISK, and this is what makes it survivable rather than clever (E-138):
//     stop beyond the setup's own invalidation + 0.30 ATR
//     REFUSE the setup outright if that stop is wider than 1.2 ATR. Uncapped,
//     one trade took 57% of a GBP60 account. Capped: worst -GBP4.63.
//     exit gives back 25% of the best excursion. No fixed target - every
//     fixed target measured worse (E-137). The give-back value barely matters
//     once the fill model is honest (E-151); what matters is that there is
//     no fixed target.
//
//  THE SWEEP, measured under fills that could actually be got (E-151):
//     M1  +288.6 pts  n=4039  +0.0715/trade  t=14.3
//     M5  +171.4 pts  n=898   +0.1908/trade  t=7.7
//     65 standard errors above a time-shifted control which itself LOSES 193
//     points - so the money is in the level, not in the trail.
//     Positive in 6 of 6 instrument/timeframe cells off XAUUSD 2018.
//
//  NEVER FORWARD TESTED. SUPPORTED, not proven. Nothing here has met a
//  real spread, a real fill or a real Sunday gap.
// ===========================================================================
indicator("LIQUIDITY SNIPER 2.1", overlay = true, max_labels_count = 500,
     max_lines_count = 500, max_boxes_count = 500, max_bars_back = 1000)

// ------------------------------------------------------------------ inputs --
gX = "1 · WHICH SIGNALS"
// E-151 SUPERSEDES E-149. E-149 measured all four signals sharing one position
// and concluded "on M5 run all four". That conclusion was built on a broken
// exit model and is WITHDRAWN.
//
// The break: the give-back trail was computed from a bar's own high, then the
// next bar was allowed to fill at it. For a long that is a sell-stop ABOVE the
// market - an order that cannot be placed - so the backtest was quietly paying
// itself the previous bar's high. The tell was that "best give-back" ran to the
// tightest value in every range tested, on all four signals and both clocks.
// A parameter that is monotone to the edge of what you tried is not an
// optimum, it is a leak. Clamp the trail to the bar's close and it reverses:
//
//   ACHIEVABLE FILLS, g=0.25       n      points    per trade    win%
//     M1 SWEEP                   4045     +288.6     +0.0713    53.3%
//     M1 break+retest            2023      -19.3     -0.0095    43.7%
//     M1 order block detect      2675      -23.7     -0.0089    42.1%
//     M1 order block return      6142     -195.9     -0.0319    40.8%
//     M5 SWEEP                    907     +171.3     +0.1888    55.6%
//     M5 break+retest             369      -24.8     -0.0671    41.7%
//     M5 order block detect       607      -18.1     -0.0299    44.6%
//     M5 order block return      1273      -80.5     -0.0632    45.8%
//
// The sweep is the only one that survives, and it survives hard: t = 14.3, and
// 65 standard errors above a time-shifted control which itself LOSES 193
// points. The control losing is the important half - it says the trail is not
// what makes the money, the level is.
//
// The other three are not noise either: at -0.009 and -0.032 a trade they beat
// a random entry (-0.048), so the structure is real. It just does not clear the
// spread. So they are OFF by default and they still DRAW: you see the blocks
// and the breaks behind the trade without paying for them.
useSweep = input.bool(true, "SWEEP  — wick takes the level, price returns", group = gX,
     tooltip = "The only one of the three that survives an achievable-fill model (E-151): +0.0715/trade on M1 over 4039 trades, t=14.3, and 65 standard errors above a time-shifted control that itself LOSES 193 points. The trail does not make the money - the level does.")
useBR    = input.bool(false, "BREAK + RETEST — close through, then holds",   group = gX,
     tooltip = "OFF by default. E-151: its edge only existed while the backtest was booking trail fills at prices no order could have been resting at. Under achievable fills it is -0.0095/trade on M1 and -0.0671 on M5. Better than a random entry, but not enough to pay the spread. The signals still DRAW - switch it on to watch it, not to trade it.")
useOB    = input.bool(false, "ORDER BLOCK — the block, and the return to it", group = gX,
     tooltip = "OFF by default. E-151: same story as break+retest. Under achievable fills, detection is -0.0089/trade and the return is -0.0319 on M1. The order block finds real structure - it is genuinely better than a random entry - but the move it catches does not pay the spread on its own. The blocks still DRAW so you can see them behind the sweep.")

gLC = "1b · LEG CATCHER  (E-184 — the only thing measured to mark leg STARTS)"
useLegCatch = input.bool(true, "Leg catcher signals", group = gLC,
     tooltip = "E-184 scored every ICT/SMC concept on ONE question - does it mark the START of a leg (pivot to pivot, 2+ ATR)? - against a time-shifted copy of itself, on four samples including 157,051 M1 bars.\n\nWORST on every sample: FVG 0.34-0.37, displacement 0.45-0.57, BOS 0.55-0.61. An FVG marks a bar about THREE TIMES LESS likely to begin a leg than a random one. All three fire in the MIDDLE of a leg, once the move is already running - which is why they read as 'caught the pullback'.\n\nFLAT: the liquidity sweep, 0.93-1.04. It does not mark a leg start at all.\n\nBEST: stretched from the mean 1.23-1.34, premium/discount 1.14-1.23, equal highs/lows taken 1.30-1.42, rejection wick 1.07-1.19, volume 1.17. Stacked they compound: 1.23 -> 1.32 -> 1.53 -> 2.18 as more agree, and out of sample the ladder reproduces almost exactly (first half 1.22/1.33/1.48/1.94, second 1.22/1.31/1.50/2.19).\n\nThis marks where moves BEGIN. It is not a claim that it makes money - the stop, the target and the cost are separate questions and are not settled.")
lcNeed = input.int(3, "How many conditions must agree", group = gLC, minval = 1, maxval = 5,
     tooltip = "M1, out of sample: 1 -> 1.22x the base rate, 2 -> 1.31x, 3 -> 1.50x, 4 -> 2.19x. Higher is sharper and much rarer - at 4 it fired 330 times over 78,000 bars. 3 is the balance.")
lcEmaLen = input.int(50, "Mean to measure 'stretched' from", group = gLC)
lcStretch = input.float(1.5, "Stretched = this many ATR from the mean", group = gLC, step = 0.1)
lcVolX  = input.float(2.0, "Volume multiple vs the 50-bar median", group = gLC, step = 0.25)

gS = "2 · THE SWEEP  (measured; leave alone unless testing)"
pvLen    = input.int(3,    "Swing needs this many bars either side", group = gS, minval = 1,
     tooltip = "E-179, measured on 2024-2026 gold at a 2R target, ATR per trade: on 15m a 3-bar pivot returns +0.208 against +0.126 at 5; on 1h +0.050 against -0.005; and a 12-bar pivot is NEGATIVE on every clock tested. A smaller pivot is better the faster the clock, which is the sensible shape - a pivot should mark a similar amount of TIME, not a similar number of bars. Raise it to 8 on H4 and above. None of this is statistically significant, so it sets a default and nothing more.")
sweepAtr = input.float(0.10, "Sweep must clear the level by (ATR)", group = gS, step = 0.05)
wickCut  = input.float(0.646, "Sweep body / range must be under", group = gS, step = 0.01,
     tooltip = "THE FAKEOUT FILTER. A big-bodied sweep close is a real breakout, not a rejection - and a real breakout is what BREAK+RETEST trades instead.")
useDisp  = input.bool(false, "Require displacement on the return leg", group = gS,
     tooltip = "OFF, and the EA has it off too. It is evaluated at the FILL bar and an EA resting an order cannot know which bar will fill it.")
lifeBars = input.int(120,  "Give up on a setup after N bars", group = gS)

gB = "3 · BREAK + RETEST"
brAtr    = input.float(0.10, "A close this far through the level is a break (ATR)", group = gB, step = 0.05)
brTol    = input.float(0.20, "Retest must come this close (ATR)", group = gB, step = 0.05)
brWait   = input.int(60,   "Bars allowed for the break, the retest, the resume", group = gB)

gO = "4 · ORDER BLOCKS"
obLen    = input.int(3,    "Candles after the OB candle", group = gO, minval = 1, maxval = 10,
     tooltip = "3 measured best on M1 and M5. The original ships 5, which measured worse on every clock.")
obThr    = input.float(0.0,"Minimum % move to qualify", group = gO, step = 0.05)
obMode   = input.string("both", "Order block entry", group = gO,
     options = ["at detection", "on the return", "both"],
     tooltip = "BOTH is kept as the default so the two entries stay visible together, but under E-151 NEITHER of them makes money: at detection is -0.0089 a trade on M1 and on the return -0.0319, and the order block is negative in 6 of 6 cells off XAUUSD. The figures this tooltip used to quote (+0.0280 and +0.0163) came from the trail leak. This setting only does anything when ORDER BLOCK is switched on, which it is not by default, and switching it on costs money.")
maxOB    = input.int(3,    "Keep this many zones per side", group = gO, minval = 1, maxval = 10,
     tooltip = "Kept deliberately small. These are live context, not a history lesson - the newest few are the ones price is actually near.")
obRule   = input.string("volume pivot (LuxAlgo)", "How a block is found", group = gO,
     options = ["3 candles (wugamlo)", "volume pivot (LuxAlgo)", "both"],
     tooltip = "TWO DIFFERENT IDEAS about which candle becomes the block. '3 candles' takes a candle followed by a clean run the other way - it is the wugamlo rule and it is what everything in this repo was measured on. 'Volume pivot' takes the candle where PARTICIPATION peaked, which is the LuxAlgo idea and a genuinely different question. Neither has been shown to make money as a mechanical entry (E-151), and both are real structure worth seeing. Volume pivot needs your feed to actually carry volume - the panel says if it does not.")
volPush  = input.bool(true, "Mark volume pushes", group = gO,
     tooltip = "Veer: 'catch volume pushes asap'. A bar whose volume clears its own recent median by this multiple AND whose body is most of its range - participation arriving with direction, not just noise. Marked with a small triangle at the bar. CONTEXT ONLY: E-167 tested break-vs-pullback volume as a filter and it was the strongest feature there at t 1.68, which is nothing. It is on the chart because you asked to see it, not because it has been shown to pay.")
volPushX = input.float(2.5, "Volume push = this x the median", group = gO, step = 0.5, minval = 1.0)
volLen   = input.int(5,  "Volume pivot length", group = gO, minval = 1,
     tooltip = "How many bars either side the volume peak must beat. Like every pivot this only CONFIRMS this many bars later - that is the rule, not a flaw in the code, and it is why no order block of any kind is truly real-time.")
obRealtime = input.bool(true, "Show the block AS IT FORMS (dashed)", group = gO,
     tooltip = "The wugamlo rule needs a full run of candles after the block candle, so a CONFIRMED block is always that many bars late - that is the rule itself, not this code. This draws the block that is one candle short of confirming, dashed and fainter, one bar earlier. It is redrawn every bar and WILL disappear if the next candle breaks the pattern: that is a maybe that did not happen, and it is drawn to look like a maybe. Solid boxes have confirmed and are permanent. No BUY/SELL signal is affected by this in any way.")
keepDead = input.bool(false,"Keep dead zones on the chart", group = gO,
     tooltip = "Off: a zone is removed when price trades through it, because it is no longer a zone. Signals are never removed either way.")

gR = "5 · RISK"
stopBuf  = input.float(0.30, "Stop beyond the invalidation (ATR)", group = gR, step = 0.05)
maxRisk  = input.float(1.2, "REFUSE the setup if the stop is wider than (ATR)", group = gR, step = 0.1,
     tooltip = "E-138. Not an optimisation - uncapped, the worst single trade was 57% of a GBP60 account.")
giveBack = input.float(0.25, "Give back this much of the best excursion", group = gR, step = 0.05)
hiWin    = input.float(0.0, "HIGH WIN RATE: take a fixed target at (R)", group = gR,
     step = 0.25, minval = 0.0,
     tooltip = "0 = off, which is what every measurement in this repo used. Set it to 0.5 and you will see a high win rate; set it to 0.25 and a higher one still. THE ARITHMETIC, so you can judge it rather than take my word: at a 0.5R target you need 67% just to break even before costs, at 0.25R you need 80%. E-136 measured where the high win rate lives on this exact setup and found the SPREAD caps it around 81% - so an 80% win rate at a 0.25R target is roughly break-even, not a profit. Turn it on and watch the win rate AND the points together: the panel shows both, and they move in opposite directions. That is the trade-off, and it is yours to make."
     )
beAtR    = input.float(1.0, "Move the stop to breakeven at (R)", group = gR, step = 0.25, minval = 0.0,
     tooltip = "0 = never. It moves to the TRUE breakeven - entry plus the spread and both slippages - because a stop at the entry price still loses you the round trip. E-147 measured PARTIALS and they cost money; moving the stop costs nothing and is a different thing.")
trailAtR = input.float(1.0, "Arm the give-back trail at (R)", group = gR, step = 0.25, minval = 0.0,
     tooltip = "0 = trail from the first bar, which is what every measurement in this repo used. Veer: 'trail sl not too aggressively for liquidity sweeps' - a sweep needs room before the ratchet starts, so the default gives it 1R first. This has NOT been measured and it is a genuine change to the exit: watch the panel to see what it does to your own numbers.")
maxHold  = input.int(240,  "Time exit (bars)", group = gR)
tgtMode  = input.string("next liquidity level", "Reference line", group = gR,
     options = ["none", "next liquidity level", "N x risk"],
     tooltip = "WHERE THE MOVE IS RUNNING TO, drawn, never traded. 'Next liquidity level' is the nearest confirmed swing on the other side - for a long, the lowest swing high above your entry - which is the resting liquidity the move is actually aiming at. This is the answer to 'tp based of levels and analysis' as far as the evidence goes: E-153 tried to TRADE it and could not, because capping entries on it leaves 34 trades out of 1008 and that is not a sample. So you get it as a ruler to read the trade by. The EXIT is still the give-back trail, which is the only exit with evidence behind it (E-156: it beats every alternative at 28 out of 28 prop-firm cells).")
tgtR     = input.float(0.0, "  ... or N x risk, if that mode is picked", group = gR, step = 0.5,
     tooltip = "DRAWN ONLY. The exit is the give-back trail. Every fixed target measured worse (E-137), and PARTIALS at every level and size were measured too (E-147) - closing 33% or 50% at 0.5R, 1R, 1.5R or 2R all banked LESS than letting it run, and none of them reduced the drawdown or the worst trade either. Partials are not on this chart because they cost money and buy nothing measurable. This line is a ruler, not a target.")

gH = "5b · HIGHER TIMEFRAME BIAS"
// E-169 measured the sweep POOLED over both directions and every trend context
// and got a flat, slightly wrong-way result. A swept LOW in an uptrend and a
// swept HIGH in an uptrend are OPPOSITE trades, and averaging a trade with its
// own mirror image produces exactly that near-zero. Veer does not trade both:
// he takes the sweep that agrees with where price is going.
//
// So the chart now says which is which, and the panel keeps the two books
// apart. THIS IS NOT A PROVEN FILTER - it is the open question, put on the
// chart so your own live data answers it. Nothing is hidden either way: an
// against-trend signal still prints, just smaller and dimmer.
htfOn  = input.bool(true, "Show higher-timeframe bias", group = gH)
htfTf  = input.timeframe("15", "Bias timeframe", group = gH,
     tooltip = "The clock that decides 'with trend'. 15 or 60 on an M1 chart is the ICT/SMC convention: read the direction high, take the entry low.")
htfLen = input.int(50, "Bias EMA length", group = gH, minval = 2)
mtfOn  = input.bool(true, "Show the trend stack (M1 / M5 / M15 / H1)", group = gH,
     tooltip = "Trends NEST. An H1 downtrend is exactly where you look for the M15 buy - the lower clock makes the new trend before the higher one turns. So this shows all four directions at once instead of pretending there is one answer. Read it top down: where the clocks DISAGREE is where the turn is happening.")
htfDim = input.bool(false, "Dim the against-trend signals", group = gH,
     tooltip = "OFF by default, and deliberately. Against the higher clock is NOT the same as wrong: an H1 downtrend is where the M15 buy lives, because the lower timeframe makes the new trend first. Turn this on only if you specifically want to trade one direction. Either way a signal that has printed is permanent and is never removed.")

gT = "6 · SESSIONS"
showSess = input.bool(true, "Show sessions", group = gT)
tzSess   = input.string("Etc/UTC", "Timezone", group = gT)
sessA    = input.session("0000-0800", "Asia",     group = gT)
sessL    = input.session("0700-1600", "London",   group = gT)
sessN    = input.session("1200-2100", "New York", group = gT)

gK = "7 · COST — the panel was lying without this"
// THE PANEL USED TO BOOK GROSS POINTS: entry to exit, no spread, no slippage.
// Every backtest number quoted for this system is NET, so the panel flattered
// itself against its own evidence and there was no way to see it. Now every
// trade pays the round trip.
spreadPts = input.float(0.30, "Your spread, in points", group = gK, step = 0.05,
     tooltip = "One point = $1.00 of price. Veer's broker runs about 0.20-0.40 on XAUUSD. Charged once per trade: you buy the ask and sell the bid.")
slipPts   = input.float(0.02, "Slippage per side, in points", group = gK, step = 0.01,
     tooltip = "Entries and exits here are STOP orders, which fill at or worse than their level. E-129 broke the older system at 0.10. Charged twice - once in, once out.")

gM = "8 · MONEY"
lots     = input.float(0.01, "Lots", group = gM, step = 0.01, minval = 0.01)
gbpPoint = input.float(0.787,"Account currency per point at 0.01 lots", group = gM, step = 0.001,
     tooltip = "A point is 1.00 of price - one dollar. 0.01 lots is 1 ounce, so a $1 move is about 79p. The same unit you use when you say 3-4 points is 2-4 pound.")
ccy      = input.string("£", "Currency symbol", group = gM)
acctSize = input.float(10000, "Account size", group = gM, step = 500, minval = 1,
     tooltip = "Used only for the sizing row - what lot size the LIVE setup's stop distance allows at your chosen risk. Set it to the funded account you are running.")
riskPct  = input.float(0.25, "Risk per trade (%)", group = gM, step = 0.05, minval = 0.01,
     tooltip = "E-156 measured this: at 0.25% a trade the simulated funded pass rate was ~100% at FTMO, FundedNext, E8 Classic and The5ers. At 0.50% it was WORSE at EVERY single firm - prop rules charge for variance, not mean. This is the one number where going bigger reliably made things worse.")

gL = "8b · THE LEGS  (bottom to top, top to bottom)"
// Veer, repeatedly and correctly: "our signals aren't catching top to bottom or
// bottom to top". Every measurement in this repo scored ENTRIES; none of them
// ever measured the MOVE. So this measures the move.
//
// A leg runs from one confirmed swing to the next. Each completed leg is drawn
// with its size in points and money, and it is marked CAUGHT if any signal
// fired inside it in the leg's own direction, MISSED if none did. The panel
// totals both.
//
// This is not a filter and it changes no signal. It is the scoreboard for the
// complaint - so "we're missing the big moves" stops being an argument and
// becomes a number on the chart.
showLegs = input.bool(true, "Draw the legs and score them", group = gL)
legMin   = input.float(3.0, "Only draw legs bigger than (ATR)", group = gL,
     step = 0.5, minval = 0.0,
     tooltip = "Small legs are noise and there are hundreds of them. Raise this until only the moves you would actually want are drawn - that is the set the indicator is being judged against.")
legLbl   = input.bool(false, "Label each leg with its size", group = gL,
     tooltip = "OFF by default: a label on every leg is the busiest thing on the chart. The line already tells you - solid and coloured means a signal fired inside it, dotted grey means we missed it.")

gD = "9 · CHART"
cBuy   = input.color(#00B0FF, "Buy",  group = gD, inline = "c1")
cSell  = input.color(#FF3B5C, "Sell", group = gD, inline = "c1")
// ============================ CLEAN CHART ==================================
// Veer, looking at his own screenshot: "wtf why is my chart soo so messy random
// lines massive profit box and just overall aesthics is bad".
//
// He is right, and the cause is that every layer defaults ON: legs, BOS/CHoCH,
// order zones, swing levels, session shading, volume pushes, the forming block,
// the R-ladder, the breakeven line, the target line. Each was reasonable on its
// own and together they bury the price.
//
// ONE switch. On (the default) the chart shows only the four things he actually
// trades from: the BUY/SELL marks, the live levels, the order blocks, and the
// live position. Everything else is available by turning this off - nothing is
// deleted, and no SIGNAL is ever hidden by it.
cleanChart = input.bool(true, "CLEAN CHART — signals, levels, blocks and the live position only",
     group = gD,
     tooltip = "Turns off the layers that are useful for studying the system and noisy for trading it: the leg scoreboard lines, BOS/CHoCH labels, every-swing level marks, session shading, volume-push arrows, the forming order block, refused setups, finished-trade labels. Turn it OFF to get all of them back. It never hides a BUY or SELL mark - Veer's rule is that a signal, once printed, is never taken away.")
showLvl   = input.bool(true, "Live levels",   group = gD, inline = "s1")
showLevels = input.bool(true, "Mark out every swing level", group = gD,
     tooltip = "The SMC level layer: every confirmed swing drawn as a line and carried forward. A level price CLOSES through is not deleted - it turns dotted and stays, because a broken level is exactly what you watch for the pullback back into it. This is the analysis done for you; the entry is still your call.")
showBreak = input.bool(false, "Label a level when it breaks", group = gD,
     tooltip = "A small 'broken' tag the moment price closes through a level. Turn it off if the chart gets busy - the dotted line already tells you.")
maxLvl    = input.int(4, "Levels to keep per side", group = gD, minval = 1, maxval = 20)
showSmc   = input.bool(true, "BOS / CHoCH",   group = gD, inline = "s1")
showZones = input.bool(true, "Order zones",   group = gD, inline = "s1")
showLive  = input.bool(true, "Position box",  group = gD, inline = "s2")
showHist  = input.bool(false, "Finished trades", group = gD, inline = "s2",
     tooltip = "OFF by default. On M1 this is a P&L label on every closed trade - thousands of them, capped at the last 500 by TradingView - and it is the single biggest source of clutter on the chart. It is also the most misleading thing here now that E-165 has shown the edge is not proven. Switch it on to study the history, not to read the market.")
showPanel = input.bool(true, "Panel",         group = gD, inline = "s2")
minGrade = input.string("A  — every setup", "Only print signals graded",
     group = gX, options = ["A  — every setup", "A+ — 4 of 7 or better",
     "A++ — 6 of 7 or better"],
     tooltip = "Veer: 'print me banger signals'. This is the volume knob. A+ needs four of the seven confluences, A++ needs six. FEWER SIGNALS IS NOT AUTOMATICALLY BETTER SIGNALS - the panel's per-grade rows are there to tell you whether the higher grades actually did better on YOUR chart. Check them before you trust the gate. Note that raising this also raises the number of legs the chart marks MISSED, which is the honest cost of being fussier.")

showCheck = input.bool(true, "Confluence checklist and grade", group = gD,
     tooltip = "Seven things knowable at the signal bar: the sweep, an order block, a volume push, agreement with the higher-timeframe clock, the London/NY overlap, a clear opposing level to run at, and a stop under 0.70 ATR. THE GRADE IS A COUNT, NOT A CLAIM - not one of these has been shown to predict anything in this repo, and several were tested and rejected. So the panel counts them and then MEASURES what each grade actually did on your chart. If A++ does not beat A on your own data, it will say so. That is the point of building it this way rather than selling you the grade.")
showRefused = input.bool(false, "Mark refused setups", group = gD,
     tooltip = "OFF by default because it is chart noise. A refused setup is one where the stop would have been wider than the risk cap allows, so the trade was declined - there is nothing to act on and there are a lot of them. The count is still in the full panel under 'refused'.")
panelPos  = input.string("Top right", "Panel position", group = gD,
     options = ["Top right", "Bottom right", "Bottom left"])
panelBig  = input.bool(false, "Show the full panel", group = gD,
     tooltip = "Off: profit, trades, win rate, which signal is paying, and the enter-by price. On: adds the risk block and the session row.")

// The effective flags. Pine inputs are read-only, so the master switch is
// applied here once and every draw site reads the *Eff name below it.
showLegsEff   = showLegs   and not cleanChart
showSmcEff    = showSmc    and not cleanChart
showLevelsEff = showLevels and not cleanChart
showSessEff   = showSess   and not cleanChart
showBreakEff  = showBreak  and not cleanChart
showHistEff   = showHist   and not cleanChart
showRefEff    = showRefused and not cleanChart
volPushEff    = volPush    and not cleanChart
obRealtimeEff = obRealtime and not cleanChart
legLblEff     = legLbl     and not cleanChart

f_num(x, d) =>
    (x >= 0 ? "+" : "") + str.tostring(x, d)
f_ccy(v) =>
    (v >= 0 ? "+" : "-") + ccy + str.tostring(math.abs(v) * gbpPoint * lots / 0.01, "0.00")

atr = ta.atr(14)

// The bias, read WITHOUT look-ahead: request the PREVIOUS higher-timeframe
// value with lookahead_off, which is the only idiom that cannot repaint. A
// bias taken from the forming HTF bar would change under you and every signal
// on this chart would become a lie.
htfSrc  = request.security(syminfo.tickerid, htfTf, close[1],
     lookahead = barmerge.lookahead_off)
htfEma  = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfLen)[1],
     lookahead = barmerge.lookahead_off)
htfUp   = not na(htfSrc) and not na(htfEma) and htfSrc > htfEma
htfDn   = not na(htfSrc) and not na(htfEma) and htfSrc < htfEma
// The stack. Trends nest: M1 turns before M5, M5 before M15, M15 before H1, and
// the disagreement between them IS the turn. Read with lookahead_off on the
// PREVIOUS bar of each clock, the only idiom that cannot repaint.
b1  = request.security(syminfo.tickerid, "1",  (close > ta.ema(close, htfLen) ? 1 : -1)[1], lookahead = barmerge.lookahead_off)
b5  = request.security(syminfo.tickerid, "5",  (close > ta.ema(close, htfLen) ? 1 : -1)[1], lookahead = barmerge.lookahead_off)
b15 = request.security(syminfo.tickerid, "15", (close > ta.ema(close, htfLen) ? 1 : -1)[1], lookahead = barmerge.lookahead_off)
b60 = request.security(syminfo.tickerid, "60", (close > ta.ema(close, htfLen) ? 1 : -1)[1], lookahead = barmerge.lookahead_off)
f_arrow(bv) =>
    na(bv) ? "·" : bv > 0 ? "▲" : "▼"

plot(htfOn and not na(htfEma) ? htfEma : na, "HTF bias",
     color = htfUp ? color.new(cBuy, 55) : color.new(cSell, 55), linewidth = 2)
ph = ta.pivothigh(high, pvLen, pvLen)
pl = ta.pivotlow(low,  pvLen, pvLen)

// Confirmed swing levels, kept so the chart can show where the move is heading
// INTO rather than at some multiple of the stop. A pivot enters these arrays
// only on the bar it is confirmed, which is pvLen bars after it formed, so
// nothing here is knowable earlier than it was.
var array<float> lvHi = array.new_float()
var array<float> lvLo = array.new_float()
if not na(ph)
    array.push(lvHi, ph)
    if array.size(lvHi) > 300
        array.shift(lvHi)
if not na(pl)
    array.push(lvLo, pl)
    if array.size(lvLo) > 300
        array.shift(lvLo)

// ===================== THE LEVELS, MARKED OUT ==============================
// Veer, repeatedly: "we need clear levels like smc indicator marked out", and
// "say smc liquidity zone we should have on chart, if price disrespected them
// and goes above we should look for entry to buy or sell accordingly to
// direction, probably wait for small pullback or retest and get a sniper entry
// in".
//
// So this draws every confirmed swing as a live level, and when price CLOSES
// through one it does not delete it - it marks it BROKEN and keeps it, because
// a broken level is exactly the thing to watch for the pullback. That is the
// analysis, done for you; the entry is still your call.
//
// These are buy-side and sell-side liquidity. They are NOT labelled BSL/SSL on
// the chart - Veer asked for that to stay internal - they are just lines.
var array<line> lnHi = array.new_line()
var array<line> lnLo = array.new_line()
var array<line> lnBk = array.new_line()

f_trimLn(la, kp) =>
    while array.size(la) > kp
        line.delete(array.shift(la))

if showLevelsEff and not na(ph)
    array.push(lnHi, line.new(bar_index - pvLen, ph, bar_index, ph,
         color = color.new(cSell, 55), width = 1))
    f_trimLn(lnHi, maxLvl)
if showLevelsEff and not na(pl)
    array.push(lnLo, line.new(bar_index - pvLen, pl, bar_index, pl,
         color = color.new(cBuy, 55), width = 1))
    f_trimLn(lnLo, maxLvl)

// live levels follow price to the right; a CLOSE through one breaks it
if barstate.isconfirmed and array.size(lnHi) > 0
    for i = array.size(lnHi) - 1 to 0
        ln = array.get(lnHi, i)
        line.set_x2(ln, bar_index + 2)
        if close > line.get_y1(ln)
            line.set_color(ln, color.new(cSell, 78))
            line.set_style(ln, line.style_dotted)
            array.remove(lnHi, i)
            array.push(lnBk, ln)
            if showBreakEff
                label.new(bar_index, line.get_y1(ln), "broken",
                     style = label.style_label_down, size = size.tiny,
                     color = color.new(chart.bg_color, 100),
                     textcolor = color.new(cSell, 25))
if barstate.isconfirmed and array.size(lnLo) > 0
    for i = array.size(lnLo) - 1 to 0
        ln = array.get(lnLo, i)
        line.set_x2(ln, bar_index + 2)
        if close < line.get_y1(ln)
            line.set_color(ln, color.new(cBuy, 78))
            line.set_style(ln, line.style_dotted)
            array.remove(lnLo, i)
            array.push(lnBk, ln)
            if showBreakEff
                label.new(bar_index, line.get_y1(ln), "broken",
                     style = label.style_label_up, size = size.tiny,
                     color = color.new(chart.bg_color, 100),
                     textcolor = color.new(cBuy, 25))
if array.size(lnBk) > 0
    for i = array.size(lnBk) - 1 to 0
        line.set_x2(array.get(lnBk, i), bar_index + 2)
f_trimLn(lnBk, maxLvl)

// The nearest opposing level in the trade's favour: for a long, the lowest
// swing HIGH above entry - the resting sell-side liquidity the move is running
// at. E-153 tried to TRADE this and could not: capping the entry on it leaves
// 34 trades of 1008, which is not a sample. So it is DRAWN and not traded, and
// the label says so.
// E-165. Where an order resting at `trig` actually fills on this bar. If the
// bar has already OPENED past the trigger, no order can still be sitting there
// and the fill is the open - which is always the worse price. This mirrors
// engine.entry_fill() in the research exactly, and it is the single line that
// separates an honest panel from a salesman.
f_fill(trig, op, d) =>
    d * (op - trig) > 0 ? op : trig

f_nextLevel(d, px) =>
    float best = na
    arr = d > 0 ? lvHi : lvLo
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lv = array.get(arr, i)
            if d * (lv - px) > 0 and (na(best) or d * (lv - best) < 0)
                best := lv
    best

// ---------------------------------------------------------------- sessions --
// E-161/E-162 measured these properly for the first time. The London/New York
// OVERLAP is the best session on both clocks and it holds out of sample:
//
//   M1 per trade   1st half   unseen        M5 per trade   1st half   unseen
//     Asia          +0.0594  +0.0439          Asia          +0.0439  +0.1322
//     London        +0.0632  +0.0686          London        +0.0771  +0.1608
//     OVERLAP       +0.0977  +0.1088          OVERLAP       +0.3600  +0.4687
//     New York      +0.0700  +0.0721          New York      +0.1895  +0.1226
//     all           +0.0724  +0.0702          all           +0.1686  +0.2123
//
// And under slippage, total points, which is what decides it:
//
//   M1 session      0.00    0.02    0.05    0.10   |  M5      0.00    0.05    0.10
//     Asia          54.5    33.6     2.3   -49.9   |         22.0     9.2    -3.5
//     OVERLAP       79.5    64.1    40.9    +2.4   |         77.1    67.7    58.3
//     all          288.6   207.7    86.3  -115.9   |        171.3   125.9    80.6
//
// So the filter is OFF by default and it is not a close call either way: at the
// slippage you probably have (0.02-0.05) taking every session banks MORE money,
// and only past about 0.10 does the overlap alone win. It is here as a DIAL for
// after the demo run tells you which world you are in. E-074: per-trade quality
// and money are not the same thing, and the overlap wins the first, not always
// the second.
//
// CAVEAT, and it was already in this file: this feed is missing the 00:00 UTC
// hour every day, so the "Asia" figures above cover 01:00-07:00, not 00:00.
// The overlap window is unaffected.
sessFilter = input.bool(false, "Trade the London/New York overlap only",
     group = gT,
     tooltip = "OFF by default. The overlap is the best session per trade on both clocks and it holds out of sample, but taking every session still banks more TOTAL money at realistic slippage. Switch this on only if your demo run shows fills slipping about 0.10 points or worse - at that point the overlap is the only M1 session still making money.")

// Detection is separate from drawing: hiding the session shading must not
// silently switch a trading filter off. That exact coupling was a live bug in
// the order block code.
inASess = not na(time(timeframe.period, sessA, tzSess))
inLSess = not na(time(timeframe.period, sessL, tzSess))
inNSess = not na(time(timeframe.period, sessN, tzSess))
inA = showSessEff and inASess
inL = showSessEff and inLSess
inN = showSessEff and inNSess
sessOk = not sessFilter or (inLSess and inNSess)
sessTint = inN ? color.new(#F5A623, 95) : inL ? color.new(#4A90D9, 96) : inA ? color.new(#7B68EE, 97) : na
bgcolor(sessTint, title = "Sessions")

// ---------------------------------------------------------- setup state ----
// One live setup per side. A swing HIGH is sell-side liquidity: the sweep runs
// UP through it and the trade is SHORT back through the level.
// Pine has no comma-separated declarations - one name per line.
var float lvlS  = na                    // the level price (sell side)
var float lvlB  = na
var float atrS  = na                    // the ATR at its confirmation
var float atrB  = na
var int   bornS = na
var int   bornB = na
var int   swS   = na                    // the bar the sweep happened
var int   swB   = na
var float extS  = na                    // the sweep's running extreme
var float extB  = na
var float dispS = na                    // the sweep bar's body / range
var float dispB = na

var int   posDir   = 0
var float posEntry = na
var float posStop  = na
var float posInit  = na
var float posPeak  = na
var int   posBar   = na

var int   nTrades = 0
var int   nWins   = 0
var float sumPts  = 0.0
var float bestPts = 0.0
var float worstPts= 0.0
var float peakEq  = 0.0
var float maxDD   = 0.0
var int   nLong   = 0
var int   nShort  = 0
var float ptsLong = 0.0
var float ptsShort= 0.0
var int   nRefused= 0                   // setups the risk cap turned down
var int   firstT  = 0

// ------------------------------------------------------------- TODAY ONLY --
// Veer: "make sure it's for the day only so from 12 am till live". The panel
// used to total every bar TradingView had loaded - roughly a fortnight on M1 -
// which is a different question from "how is today going". Everything above
// resets at the session day boundary, so the panel always reads midnight to
// now, in the timezone chosen for the sessions.
//
// The boundary is the DATE in `tzSess`, not `dayofmonth`, because the chart's
// own timezone and the session timezone are not the same thing and using the
// wrong one silently shifts the reset by hours.
todayKey = str.format_time(time, "yyyyMMdd", tzSess)
newDay   = todayKey != todayKey[1]
if newDay
    nTrades  := 0
    nWins    := 0
    sumPts   := 0.0
    bestPts  := 0.0
    worstPts := 0.0
    peakEq   := 0.0
    maxDD    := 0.0
    nLong    := 0
    nShort   := 0
    ptsLong  := 0.0
    ptsShort := 0.0
    nRefused := 0
    firstT   := 0

// a new confirmed pivot replaces any unfilled setup on that side
if not na(ph)
    lvlS := ph
    atrS := atr
    bornS := bar_index
    swS := na
    extS := na
if not na(pl)
    lvlB := pl
    atrB := atr
    bornB := bar_index
    swB := na
    extB := na

// ---- the sweep --------------------------------------------------------------
if not na(lvlS) and na(swS) and high >= lvlS + sweepAtr * atrS and barstate.isconfirmed
    swS := bar_index
    extS := high
    r = high - low
    dispS := r > 0 ? math.abs(close - open) / r : 1.0
if not na(lvlB) and na(swB) and low <= lvlB - sweepAtr * atrB and barstate.isconfirmed
    swB := bar_index
    extB := low
    r = high - low
    dispB := r > 0 ? math.abs(close - open) / r : 1.0

// After a sweep the run can keep extending, and the stop goes with it. The
// `posDir == 0` that used to be here froze the extreme for as long as a
// simulated trade was open, so a setup that filled later got a stop measured
// from a stale extreme. It also disagreed with the research, which extends the
// extreme right up to the bar before the fill.
if not na(swS) and bar_index > swS
    extS := math.max(extS, high)
if not na(swB) and bar_index > swB
    extB := math.min(extB, low)

// a setup that never came back is not a signal
if not na(bornS) and bar_index - bornS > lifeBars
    lvlS := na
    swS := na
if not na(bornB) and bar_index - bornB > lifeBars
    lvlB := na
    swB := na

// ---- the return, the filters, and the fill ---------------------------------
// displacement on the return leg, exactly as measured: bar j against bar j-2
dispOkB = not useDisp or (low - high[2]) / atr >= -1.4909
dispOkS = not useDisp or (low[2] - high) / atr >= -1.4909

// THE GATE THAT SURVIVED THE FIX BELOW. The sig*/take* split at line ~1013
// was supposed to stop the simulated book deleting signals off the chart, and
// it did - one layer too late. `posDir == 0` was ALSO sitting here, upstream of
// everything: with it, readyS was false while a trade was open, so fillS was
// false, so sigSweepS was false, so nothing was drawn. Since useSweep is the
// only signal ON by default, that meant the sweep marks - the ones Veer kept
// telling me were missing - were still being suppressed after the fix that was
// supposed to stop exactly that.
//
// The book's one-position rule lives in take* and NOWHERE ELSE. Anything that
// decides what is DRAWN must be blind to whether a simulated trade is open.
readyS = not na(swS) and bar_index > swS and low <= lvlS
     and dispS <= wickCut and dispOkS and barstate.isconfirmed
readyB = not na(swB) and bar_index > swB and high >= lvlB
     and dispB <= wickCut and dispOkB and barstate.isconfirmed

// THE RISK CAP. A stop wider than maxRisk ATR is refused outright - 0.01 lots
// is the floor (E-081), so a stop too wide to afford cannot be sized down.
// PARITY. The research stops extending the sweep's extreme at the bar BEFORE
// the return fills, and this file was extending it ON the fill bar - so the
// chart's stop sat further away than the stop every measured number was
// computed with. A wider stop is not a harmless difference: it is hit less
// often, which flatters, and it breaches the risk cap more often, which
// refuses trades the research took. Use the extreme as it stood at the close
// of the previous bar, which is what was actually knowable.
extSf = nz(extS[1], extS)
extBf = nz(extB[1], extB)
riskS = readyS ? math.abs(lvlS - (extSf + stopBuf * atrS)) : na
riskB = readyB ? math.abs(lvlB - (extBf - stopBuf * atrB)) : na
tooWideS = readyS and riskS > maxRisk * atrS
tooWideB = readyB and riskB > maxRisk * atrB

fillS = readyS and not tooWideS
fillB = readyB and not tooWideB

if tooWideS or tooWideB
    nRefused += 1
    if tooWideS
        lvlS := na
        swS := na
    if tooWideB
        lvlB := na
        swB := na

// ================================ SMC ======================================
// Structure is drawn only when it BREAKS. An indicator that draws every swing
// is a picture of the past.
var float smcH  = na
var int   smcHb = na
var float smcL  = na
var int   smcLb = na
var int   smcTrend = 0

if not na(ph)
    smcH  := ph
    smcHb := bar_index - pvLen
if not na(pl)
    smcL  := pl
    smcLb := bar_index - pvLen

bosUp = showSmcEff and not na(smcH) and close > smcH and barstate.isconfirmed
bosDn = showSmcEff and not na(smcL) and close < smcL and barstate.isconfirmed
if bosUp
    label.new(bar_index, smcH, smcTrend < 0 ? "CHoCH" : "BOS",
         style = label.style_label_down, color = color.new(chart.bg_color, 100),
         textcolor = color.new(cBuy, 15), size = size.tiny)
    smcTrend := 1
    smcH := na
if bosDn
    label.new(bar_index, smcL, smcTrend > 0 ? "CHoCH" : "BOS",
         style = label.style_label_up, color = color.new(chart.bg_color, 100),
         textcolor = color.new(cSell, 15), size = size.tiny)
    smcTrend := -1
    smcL := na

// ============================ ORDER BLOCKS =================================
// wugamlo's rule, MPL-2.0 (notice at the top). A DOWN candle followed by obLen
// consecutive UP candles clearing obThr percent is a bullish block; its zone is
// that candle's high..low. Mirror for bearish.
var array<box> obBullBx = array.new<box>()
var array<box> obBearBx = array.new<box>()
var float obBullTop = na
var float obBullBot = na
var float obBearTop = na
var float obBearBot = na

f_trim(arr, cap) =>
    while array.size(arr) > cap
        box.delete(array.shift(arr))
    true

obp    = obLen + 1
obMove = close[obp] != 0 ? math.abs(close[obp] - close[1]) / close[obp] * 100.0 : 0.0
obUps  = 0
obDns  = 0
for i = 1 to obLen
    obUps += close[i] > open[i] ? 1 : 0
    obDns += close[i] < open[i] ? 1 : 0

// DRAWING AND TRADING ARE SEPARATE. E-151 turned the order block OFF as an
// ENTRY, but Veer asked for the blocks on the chart - "i want order block
// entries used as well they are incredible" - and they ARE real structure, they
// just do not clear the spread. So the block is detected whenever it is going
// to be drawn OR traded, and only the ENTRY is gated on useOB. Before this the
// tooltip promised the blocks would still draw and they did not.
obDetect = showZones or useOB
useCandleOb = obRule == "3 candles (wugamlo)" or obRule == "both"
newObBull = obDetect and useCandleOb and obMove >= obThr and close[obp] < open[obp] and obUps == obLen
     and barstate.isconfirmed
newObBear = obDetect and useCandleOb and obMove >= obThr and close[obp] > open[obp] and obDns == obLen
     and barstate.isconfirmed

// ---- VOLUME PIVOT BLOCKS (LuxAlgo rule) -----------------------------------
// A block is the candle where PARTICIPATION peaked, not one picked by the shape
// of the candles after it. `os` tracks which leg we are in: 1 after a swing low
// was taken out, 0 after a swing high was. On a volume pivot, the block is the
// half-candle on the side that is about to be traded away from.
useVolOb = obDetect and (obRule == "volume pivot (LuxAlgo)" or obRule == "both")
volOk    = not na(volume) and volume > 0
vUpper = ta.highest(volLen)
vLower = ta.lowest(volLen)
var int osLeg = 0
osLeg := high[volLen] > vUpper ? 0 : low[volLen] < vLower ? 1 : nz(osLeg[1], 0)
phv = ta.pivothigh(volume, volLen, volLen)
newVolBull = useVolOb and volOk and not na(phv) and osLeg == 1 and barstate.isconfirmed
newVolBear = useVolOb and volOk and not na(phv) and osLeg == 0 and barstate.isconfirmed
if newVolBull and showZones
    array.push(obBullBx, box.new(bar_index - volLen, math.avg(high[volLen], low[volLen]),
         bar_index + 10, low[volLen],
         border_color = color.new(cBuy, 55), border_width = 1,
         bgcolor = color.new(cBuy, 88)))
    f_trim(obBullBx, maxOB)
if newVolBear and showZones
    array.push(obBearBx, box.new(bar_index - volLen, high[volLen],
         bar_index + 10, math.avg(high[volLen], low[volLen]),
         border_color = color.new(cSell, 55), border_width = 1,
         bgcolor = color.new(cSell, 88)))
    f_trim(obBearBx, maxOB)

// ---- VOLUME PUSH ----------------------------------------------------------
// Participation arriving WITH direction: volume well above its own recent
// median and a bar that is mostly body. Tick volume, so broker-dependent.
volMed  = ta.median(volume, 50)
pushUp  = volPushEff and volOk and not na(volMed) and volMed > 0 and barstate.isconfirmed
     and volume >= volPushX * volMed and close > open
     and (high - low) > 0 and (close - open) / (high - low) >= 0.55
pushDn  = volPushEff and volOk and not na(volMed) and volMed > 0 and barstate.isconfirmed
     and volume >= volPushX * volMed and close < open
     and (high - low) > 0 and (open - close) / (high - low) >= 0.55

// ---- REAL TIME: the block AS IT FORMS -------------------------------------
// Veer: "real time orderblock if thats possible idk". It is, with one honest
// caveat. The wugamlo rule needs obLen candles AFTER the block candle, so a
// CONFIRMED block is always obLen bars late - that is the rule, not a
// limitation of this code. What can be shown now is the block that is one
// candle short of confirming: the same shape, one bar earlier.
//
// It is drawn DASHED and fainter, and it is redrawn from scratch every bar, so
// it can and will disappear if the next candle breaks the pattern. That is NOT
// a signal vanishing - it is a maybe that did not happen, and it looks like a
// maybe on purpose. Every SOLID box has confirmed and is permanent, and no
// plotshape signal is ever affected by any of this.
formUps = 0
formDns = 0
if obLen > 1
    for i = 1 to obLen - 1
        formUps += close[i] > open[i] ? 1 : 0
        formDns += close[i] < open[i] ? 1 : 0
formP    = obLen                       // the candle one bar closer than obp
formMove = close[formP] != 0 ? math.abs(close[formP] - close[1]) / close[formP] * 100.0 : 0.0
formBull = showZones and obRealtimeEff and obLen > 1 and formMove >= obThr
     and close[formP] < open[formP] and formUps == obLen - 1
formBear = showZones and obRealtimeEff and obLen > 1 and formMove >= obThr
     and close[formP] > open[formP] and formDns == obLen - 1

var box fBull = na
var box fBear = na
if not na(fBull)
    box.delete(fBull)
    fBull := na
if not na(fBear)
    box.delete(fBear)
    fBear := na
if formBull
    fBull := box.new(bar_index - formP, high[formP], bar_index + 4, low[formP],
         border_color = color.new(cBuy, 45), border_width = 1,
         border_style = line.style_dashed, bgcolor = color.new(cBuy, 94))
if formBear
    fBear := box.new(bar_index - formP, high[formP], bar_index + 4, low[formP],
         border_color = color.new(cSell, 45), border_width = 1,
         border_style = line.style_dashed, bgcolor = color.new(cSell, 94))

if newObBull
    obBullTop := high[obp]
    obBullBot := low[obp]
    if showZones
        array.push(obBullBx, box.new(bar_index - obp, obBullTop, bar_index + 10, obBullBot,
             border_color = color.new(cBuy, 65), border_width = 1,
             bgcolor = color.new(cBuy, 90)))
        f_trim(obBullBx, maxOB)
if newObBear
    obBearTop := high[obp]
    obBearBot := low[obp]
    if showZones
        array.push(obBearBx, box.new(bar_index - obp, obBearTop, bar_index + 10, obBearBot,
             border_color = color.new(cSell, 65), border_width = 1,
             bgcolor = color.new(cSell, 90)))
        f_trim(obBearBx, maxOB)

// a zone that price has traded through is no longer a zone. SIGNALS are never
// removed - only zones - and "keep dead zones" turns even this off.
if array.size(obBullBx) > 0
    for i = array.size(obBullBx) - 1 to 0
        b = array.get(obBullBx, i)
        box.set_right(b, bar_index + 10)
        if low < box.get_bottom(b) and not keepDead
            box.delete(b)
            array.remove(obBullBx, i)
if array.size(obBearBx) > 0
    for i = array.size(obBearBx) - 1 to 0
        b = array.get(obBearBx, i)
        box.set_right(b, bar_index + 10)
        if high > box.get_top(b) and not keepDead
            box.delete(b)
            array.remove(obBearBx, i)

obAliveB = obDetect and not na(obBullBot) and low >= obBullBot
obAliveS = obDetect and not na(obBearTop) and high <= obBearTop
// THE RISK CAP APPLIES TO EVERY SOURCE. The first build of this file computed
// obRisk after the take conditions and never used it, so an order block with a
// stop wider than the cap would have been taken anyway. That cap is the only
// thing standing between this and the -GBP34 trade E-138 found.
obRiskB  = not na(obBullTop) and not na(obBullBot)
     ? math.abs(obBullTop - (obBullBot - stopBuf * atr)) : na
obRiskS  = not na(obBearTop) and not na(obBearBot)
     ? math.abs(obBearBot - (obBearTop + stopBuf * atr)) : na
obUseDet = obMode != "on the return"
obUseRet = obMode != "at detection"
// AT DETECTION. The block confirms on THIS bar, so this is the earliest a
// human or an EA could act. E-148's claim that it measured nearly double the
// return entry is WITHDRAWN by E-151: corrected, detection is -0.0089 a trade
// and the return -0.0319. Both lose. This code stays so the blocks can be
// DRAWN, which is what Veer asked for and which costs nothing.
// The marker the eye loves is drawn obp bars back on the block candle, and
// that price was not knowable when the block formed. This is the honest
// version of "catch the birth of the move".
obDetRiskB = newObBull ? math.abs(close - (low[obp] - stopBuf * atr)) : na
obDetRiskS = newObBear ? math.abs(close - (high[obp] + stopBuf * atr)) : na
obDetB   = useOB and obUseDet and newObBull and obDetRiskB <= maxRisk * atr
obDetS   = useOB and obUseDet and newObBear and obDetRiskS <= maxRisk * atr

obFillB  = useOB and obUseRet and obAliveB and low <= obBullTop and low[1] > obBullTop
     and obRiskB <= maxRisk * atr and barstate.isconfirmed
obFillS  = useOB and obUseRet and obAliveS and high >= obBearBot and high[1] < obBearBot
     and obRiskS <= maxRisk * atr and barstate.isconfirmed

// ========================== BREAK AND RETEST ===============================
// The level is DISRESPECTED by a CLOSE, price comes back, holds, then resumes.
// Its own level tracking, kept separate from the sweep engine's so the two can
// never disturb each other - the sweep engine nulls its levels on a fill and
// this must not inherit that.
var float rLvl = na
var float rAtr = na
var int   rState = 0
var int   rBar = na
var float rTrig = na
var float rStop = na
var float sLvl = na
var float sAtr = na
var int   sState = 0
var int   sBar = na
var float sTrig = na
var float sStop = na

if useBR and not na(ph) and rState == 0
    rLvl := ph
    rAtr := atr
if useBR and not na(pl) and sState == 0
    sLvl := pl
    sAtr := atr

if useBR and barstate.isconfirmed
    // ---- upside: break a swing HIGH, retest it, buy the resumption
    if rState == 0 and not na(rLvl) and close > rLvl + brAtr * rAtr
        rState := 1
        rBar := bar_index
    else if rState == 1
        if bar_index - rBar > brWait or close < rLvl - brTol * rAtr
            rState := 0
            rLvl := na
        else if low <= rLvl + brTol * rAtr and close > rLvl
            rState := 2
            rTrig := high
            rStop := low - stopBuf * rAtr
            rBar := bar_index
    else if rState == 2
        if bar_index - rBar > brWait or close < rLvl - brTol * rAtr
            rState := 0
            rLvl := na
    // ---- downside: break a swing LOW, retest it, sell the resumption
    if sState == 0 and not na(sLvl) and close < sLvl - brAtr * sAtr
        sState := 1
        sBar := bar_index
    else if sState == 1
        if bar_index - sBar > brWait or close > sLvl + brTol * sAtr
            sState := 0
            sLvl := na
        else if high >= sLvl - brTol * sAtr and close < sLvl
            sState := 2
            sTrig := low
            sStop := high + stopBuf * sAtr
            sBar := bar_index
    else if sState == 2
        if bar_index - sBar > brWait or close > sLvl + brTol * sAtr
            sState := 0
            sLvl := na

brFillB = useBR and rState == 2 and bar_index > rBar and high >= rTrig
     and math.abs(rTrig - rStop) <= maxRisk * rAtr and barstate.isconfirmed
brFillS = useBR and sState == 2 and bar_index > sBar and low <= sTrig
     and math.abs(sTrig - sStop) <= maxRisk * sAtr and barstate.isconfirmed

// ======================= ONE POSITION, THREE SOURCES =======================
// First come, first served, strongest first when two fire on the same bar.
// The priority order is sweep, then break+retest, then order block. Those
// three control-se figures (107.3 / 73.8 / 56.8) are WITHDRAWN - E-151 showed
// they were measured on a trail that filled at unreachable prices, and only the
// sweep survives correction. The ORDER is kept because it is still the right
// order, and because with the other two off by default nothing else contends
// for the slot anyway.
var int   posSrc = 0          // 1 sweep, 2 break+retest, 3 order block
var float posTgt = na
var bool  posWith = true
var int   posGrade = 0

// per-source books, so the panel can show which one is carrying
var int   nS = 0
var int   nB = 0
var int   nO = 0
var float pS = 0.0
var float pB = 0.0
var float pO = 0.0
var int   wS = 0
var int   wB = 0
var int   wO = 0

// The per-signal books reset with the day too. They are declared here rather
// than with the others, and Pine is single-pass, so this is the earliest point
// they CAN be reset - hence a second block instead of one.
if newDay
    nS := 0
    nB := 0
    nO := 0
    pS := 0.0
    pB := 0.0
    pO := 0.0
    wS := 0
    wB := 0
    wO := 0

// ============ THE SIGNAL IS NOT THE SIMULATED TRADE ========================
// THIS WAS A REAL BUG AND IT IS THE ONE VEER KEPT REPORTING: "it hit a level
// and produced no signal", "we missed the clear top tick entries".
//
// Every take* below used to carry `posDir == 0`, and the BUY/SELL marks were
// drawn from those. So while the simulated position was open - which on M1 is
// most of the time - a perfectly valid setup fired and NOTHING WAS DRAWN. The
// panel's one-trade-at-a-time rule was silently deleting signals off the chart.
//
// Veer trades these by hand. He is not limited to one position, and the chart's
// job is to show him every setup. So:
//     sig*   = the setup fired. DRAWN. Nothing suppresses it.
//     take*  = the simulation took it. Still one at a time, because the panel
//              has to model a single account honestly.
// The panel's "missed while busy" row counts the difference, so the gap between
// what you see and what the panel books is visible rather than hidden.
// ---- the bias flags, and the checklist, BEFORE the gate that uses them ----
// The checklist is computed from the RAW setup conditions (fillB/fillS,
// brFill*, obFill*, obDet*), never from sig*. sig* depends on the gate and the
// gate depends on the score, so scoring off sig* would be circular.
biasKnown = htfUp or htfDn
withB  = not biasKnown or htfUp
withS  = not biasKnown or htfDn

rawB = fillB or brFillB or obFillB or obDetB
rawS = fillS or brFillS or obFillS or obDetS

ckSweep = fillB or fillS
ckOB    = not na(obBullTop) or not na(obBearBot)
ckVol   = pushUp or pushDn or pushUp[1] or pushDn[1]
ckBias  = rawB ? withB : withS
ckSess  = inLSess and inNSess
// f_nextLevel walks a 300-entry array. This ran on EVERY bar, signal or not -
// about 6M interpreted iterations over a 20k-bar M1 chart, before anything else
// in the script - and when no setup was live it scanned for a level nobody had
// asked about. That is a realistic "calculation timeout" on the clock Veer
// trades. Only ask when there is a signal to ask about.
ckDOL   = (rawB or rawS) and not na(f_nextLevel(rawB ? 1 : -1, close))
ckTight = not na(atr) and atr > 0 and
     ((fillB ? math.abs(lvlB - (extBf - stopBuf * atrB)) :
       fillS ? math.abs(lvlS - (extSf + stopBuf * atrS)) : na) <= 0.70 * atr)
ckScore = (ckSweep ? 1 : 0) + (ckOB ? 1 : 0) + (ckVol ? 1 : 0) + (ckBias ? 1 : 0)
     + (ckSess ? 1 : 0) + (ckDOL ? 1 : 0) + (ckTight ? 1 : 0)

// The grade gate. ckScore is computed above from seven things all knowable at
// this bar. Raising the gate prints fewer marks; whether they are BETTER marks
// is what the per-grade panel rows measure, and nothing here assumes it.
gradeOk = minGrade == "A  — every setup" ? true
     : minGrade == "A+ — 4 of 7 or better" ? ckScore >= 4 : ckScore >= 6

// ===================== THE LEG CATCHER (E-184) =============================
// Five conditions, each of which BEAT a time-shifted copy of itself on four
// separate samples. They are all one family - mean reversion at an extreme -
// and they are deliberately the OPPOSITE of the continuation family (FVG,
// displacement, BOS) that scored 0.34-0.61 and is what makes an indicator fire
// in the middle of a move it has already missed.
//
// +1 = expect an UP leg, -1 = a DOWN leg, 0 = silent. Nothing here reads a bar
// that is not closed.
lcEma  = ta.ema(close, lcEmaLen)
lcDist = atr > 0 ? (close - lcEma) / atr : 0.0
lcStr  = lcDist <= -lcStretch ? 1 : lcDist >= lcStretch ? -1 : 0

lcHH = ta.highest(high, 60)
lcLL = ta.lowest(low, 60)
lcPos = lcHH > lcLL ? (close - lcLL) / (lcHH - lcLL) : 0.5
lcPrem = lcPos < 0.35 ? 1 : lcPos > 0.65 ? -1 : 0

lcRng = high - low
lcUpW = lcRng > 0 ? (high - math.max(open, close)) / lcRng : 0.0
lcDnW = lcRng > 0 ? (math.min(open, close) - low) / lcRng : 0.0
lcWick = lcDnW >= 0.6 ? 1 : lcUpW >= 0.6 ? -1 : 0

// EQUAL HIGHS / LOWS TAKEN. Two swings within 0.1 ATR of each other, then
// swept and closed back inside - the strongest single concept on M1 (1.42).
var float eqA = na
var float eqB = na
var float eqC = na
var float eqD = na
if not na(ph)
    eqB := eqA
    eqA := ph
if not na(pl)
    eqD := eqC
    eqC := pl
lcEqH = not na(eqA) and not na(eqB) and math.abs(eqA - eqB) <= 0.10 * atr
     and high > math.max(eqA, eqB) and close < math.max(eqA, eqB) ? -1 : 0
lcEqL = not na(eqC) and not na(eqD) and math.abs(eqC - eqD) <= 0.10 * atr
     and low < math.min(eqC, eqD) and close > math.min(eqC, eqD) ? 1 : 0
lcEq = lcEqH != 0 ? lcEqH : lcEqL

lcVmed = ta.median(volume, 50)
lcVol  = (not na(volume) and lcVmed > 0 and volume >= lcVolX * lcVmed) ? 1 : 0

lcUp = (lcStr > 0 ? 1 : 0) + (lcPrem > 0 ? 1 : 0) + (lcWick > 0 ? 1 : 0)
     + (lcEq > 0 ? 1 : 0) + lcVol
lcDn = (lcStr < 0 ? 1 : 0) + (lcPrem < 0 ? 1 : 0) + (lcWick < 0 ? 1 : 0)
     + (lcEq < 0 ? 1 : 0) + lcVol
lcScore = math.max(lcUp, lcDn)
lcDir   = lcUp > lcDn ? 1 : lcDn > lcUp ? -1 : 0

sigLegB = useLegCatch and lcDir > 0 and lcUp >= lcNeed and barstate.isconfirmed
sigLegS = useLegCatch and lcDir < 0 and lcDn >= lcNeed and barstate.isconfirmed

// ---- WHERE IT IS GOING (E-185) -------------------------------------------
// The higher timeframe is NOT a filter. Five different HTF contexts were
// layered on this signal and every one landed within 0.02 of the unfiltered
// 1.53 lift, on 12,092 signals - while cutting the count by half to two thirds.
// Both directions of the "H1 downtrend, M15 buy" model came out flat. The
// reason is that this stack already measures "price is at an extreme", and the
// HTF's premium/discount is the same measurement on a bigger bar.
//
// What the HTF IS good for is the DESTINATION. From an M1 signal, price reaches
// the next H1 swing level 54.5% of the time (n = 3,666) and the median leg
// travels 115% of the way there - it overshoots. Against E-172, where every
// fixed R target sat on zero, a level-based target is a different animal.
//
// So the signal gets a target drawn on it: the next HTF swing level in its
// direction. It is a destination, not a promise - it is reached just over half
// the time, and that is what the number says.
lcHtfHi = request.security(syminfo.tickerid, htfTf, ta.highest(high, 20)[1],
     lookahead = barmerge.lookahead_off)
lcHtfLo = request.security(syminfo.tickerid, htfTf, ta.lowest(low, 20)[1],
     lookahead = barmerge.lookahead_off)
lcTgt = sigLegB ? lcHtfHi : sigLegS ? lcHtfLo : na

var line  lcTLine = na
var label lcTLab  = na
if (sigLegB or sigLegS) and not na(lcTgt) and showLive
    if not na(lcTLine)
        line.delete(lcTLine)
    if not na(lcTLab)
        label.delete(lcTLab)
    tcol = sigLegB ? cBuy : cSell
    lcTLine := line.new(bar_index, lcTgt, bar_index + 30, lcTgt,
         color = color.new(tcol, 35), width = 1, style = line.style_dashed)
    lcTLab := label.new(bar_index + 30, lcTgt,
         "target  " + str.tostring(math.abs(lcTgt - close), format.mintick)
         + "pt   reached 55% on M1",
         style = label.style_label_left, size = size.tiny,
         color = color.new(chart.bg_color, 100), textcolor = color.new(tcol, 10))

sigSweepB = useSweep and sessOk and fillB and gradeOk
sigSweepS = useSweep and sessOk and fillS and gradeOk
sigBrB    = brFillB and gradeOk
sigBrS    = brFillS and gradeOk
sigObB    = obFillB and gradeOk
sigObS    = obFillS and gradeOk
sigDetB   = obDetB and gradeOk
sigDetS   = obDetS and gradeOk

anySig = sigSweepB or sigSweepS or sigBrB or sigBrS or sigObB or sigObS
     or sigDetB or sigDetS

// WITH the higher-timeframe bias, or against it. Buys agree with an up bias,
// sells with a down bias. When no bias is available (the HTF has not warmed up)
// everything counts as with-trend so nothing is ever hidden by missing data.
sigBuyWith    = (sigSweepB or sigBrB or sigObB or sigDetB) and withB
sigBuyAgainst = (sigSweepB or sigBrB or sigObB or sigDetB) and not withB
sigSellWith    = (sigSweepS or sigBrS or sigObS or sigDetS) and withS
sigSellAgainst = (sigSweepS or sigBrS or sigObS or sigDetS) and not withS

takeSweepB = sigSweepB and posDir == 0
takeSweepS = sigSweepS and posDir == 0
takeBrB    = sigBrB and posDir == 0 and not takeSweepB and not takeSweepS
takeBrS    = sigBrS and posDir == 0 and not takeSweepB and not takeSweepS
takeObB    = sigObB and posDir == 0 and not takeSweepB and not takeSweepS
     and not takeBrB and not takeBrS
takeObS    = sigObS and posDir == 0 and not takeSweepB and not takeSweepS
     and not takeBrB and not takeBrS
takeDetB   = sigDetB and posDir == 0 and not takeSweepB and not takeSweepS
     and not takeBrB and not takeBrS and not takeObB and not takeObS
takeDetS   = sigDetS and posDir == 0 and not takeSweepB and not takeSweepS
     and not takeBrB and not takeBrS and not takeObB and not takeObS

anyBuy  = takeSweepB or takeBrB or takeObB or takeDetB
anySell = takeSweepS or takeBrS or takeObS or takeDetS

// ==================== THE CONFLUENCE CHECKLIST =============================
// The shape Veer showed me from a real trader's tool: a list of confluences,
// a GRADE, and the win rate per grade. Seven things that are all knowable at
// the signal bar and none of which uses a later bar.
//
// THE GRADE IS A COUNT, NOT A CLAIM. Nothing here has been shown to predict
// anything - E-159 found stop width monotone but unusable, E-162 found the
// overlap best per trade but not per pound, E-167 found volume worth t 1.68,
// E-170 found the trend split worth nothing. So the panel does NOT tell you a
// grade is good. It COUNTS the confluences and then MEASURES what each grade
// actually did on your own chart. If A++ does not beat A on your data, the
// panel will say so, and that is the point of building it this way.
f_tick(b) =>
    b ? "yes" : "-"

// how many setups the chart showed you that the panel could not book
var int nMissed = 0
// The open question of E-169, kept as two separate books so Veer's own live
// data answers it: does the sweep that agrees with the higher-timeframe bias
// behave differently from the one that fights it? Pooling the two is what
// produced a flat result in the research, and pooling them here would hide the
// same thing on the chart.
var int   nA    = 0
var int   nAp   = 0
var int   nApp  = 0
var float pA    = 0.0
var float pAp   = 0.0
var float pApp  = 0.0
var int   wA    = 0
var int   wAp   = 0
var int   wApp  = 0
var int   nWith    = 0
var int   nAgainst = 0
var float pWith    = 0.0
var float pAgainst = 0.0
var int   wWith    = 0
var int   wAgainst = 0
if newDay
    nMissed := 0
    nA := 0
    nAp := 0
    nApp := 0
    pA := 0.0
    pAp := 0.0
    pApp := 0.0
    wA := 0
    wAp := 0
    wApp := 0
    nWith := 0
    nAgainst := 0
    pWith := 0.0
    pAgainst := 0.0
    wWith := 0
    wAgainst := 0
if anySig and posDir != 0 and barstate.isconfirmed
    nMissed += 1

// ======================== THE LEGS, MEASURED ===============================
// A leg runs extreme to extreme. `ph`/`pl` confirm pvLen bars late, so a leg is
// only ever CLOSED and drawn once its far end is confirmed - nothing here is
// knowable earlier than it was, and nothing repaints.
var float legFrom  = na          // price the current leg started at
var int   legFromB = na          // bar it started on
var int   legDir   = 0           // +1 rising, -1 falling
var bool  legHit   = false       // did any signal fire inside it, its way
var int   nLegAll  = 0
var int   nLegHit  = 0
var float ptsLegAll = 0.0
var float ptsLegHit = 0.0
if newDay
    nLegAll := 0
    nLegHit := 0
    ptsLegAll := 0.0
    ptsLegHit := 0.0

// WHY THIS USED TO PRINT 0 / 74 ON EVERY CHART, AND WHY THAT WAS A LIE.
//
// It used to read "a signal counts for the leg it is INSIDE, in that leg's
// direction" - `if legDir > 0 and sigSweepB -> legHit := true`. For THIS
// strategy that condition is structurally unreachable:
//
//   * a rising leg only becomes legDir > 0 when a pivot LOW CONFIRMS, which is
//     pvLen bars AFTER the low formed
//   * a sweep BUY fires when price sweeps BELOW that low and returns - i.e. AT
//     the low, while the leg still in progress is the FALLING one, legDir = -1
//   * so when the buy fires, legDir > 0 is false
//   * then the low confirms, and the reset block below sets legHit := false,
//     wiping anything that had been recorded
//   * during the rising leg no new low is swept, so no further buy fires
//
// The entry is a TURN entry. It is supposed to fire at the end of one leg and
// the start of the next. The scoreboard only credited signals fired in the
// MIDDLE of an already-confirmed leg, so it could only ever print zero - and
// it printed "0 / 74, +0.0pt of +572.4pt on offer" on Veer's live chart, which
// reads as "this system catches nothing" and is a measurement artefact.
//
// The honest question is "was there a signal, this leg's way, anywhere from
// just before it started to the bar it ended". pvLen of slack at the front is
// exactly the pivot's confirmation lag - the signal fires inside it by design.
var int lastBuySigB  = -1
var int lastSellSigB = -1
if sigSweepB or sigBrB or sigObB or sigDetB or sigLegB
    lastBuySigB := bar_index
if sigSweepS or sigBrS or sigObS or sigDetS or sigLegS
    lastSellSigB := bar_index

// Pine CANNOT modify a global inside a user function, so this is written
// inline rather than as f_closeLeg(). It was a function first and that is a
// compile error - the counters would never have been written.
legClose = false
float legToPx  = na
int   legToBar = na
if barstate.isconfirmed and not na(ph) and legDir >= 0 and not na(legFrom)
    legClose := true
    legToPx  := ph
    legToBar := bar_index - pvLen
if barstate.isconfirmed and not na(pl) and legDir <= 0 and not na(legFrom)
    legClose := true
    legToPx  := pl
    legToBar := bar_index - pvLen

if legClose
    legSize = math.abs(legToPx - legFrom)
    // Caught = a signal this leg's way, between pvLen bars before the leg
    // started and the bar it ended on.
    sigB = legDir > 0 ? lastBuySigB : lastSellSigB
    legHit := sigB >= legFromB - pvLen and sigB <= legToBar and sigB >= 0
    if legSize >= legMin * atr
        nLegAll += 1
        ptsLegAll += legSize
        if legHit
            nLegHit += 1
            ptsLegHit += legSize
        if showLegsEff
            legCol = legHit ? (legDir > 0 ? cBuy : cSell) : color.new(#8FA3B8, 30)
            line.new(legFromB, legFrom, legToBar, legToPx, color = legCol,
                 width = 1, style = legHit ? line.style_solid : line.style_dotted)
            if legLblEff
                label.new(math.round((legFromB + legToBar) / 2),
                     (legFrom + legToPx) / 2,
                     f_num(legDir * (legToPx - legFrom), "0.0") + "pt"
                     + (legHit ? "" : "  MISSED"),
                     style = label.style_label_center, size = size.tiny,
                     color = color.new(chart.bg_color, 100),
                     textcolor = legHit ? legCol : color.new(#8FA3B8, 10))

// start the next leg from whichever extreme just confirmed
if barstate.isconfirmed and not na(ph)
    legFrom  := ph
    legFromB := bar_index - pvLen
    legDir   := -1
if barstate.isconfirmed and not na(pl)
    legFrom  := pl
    legFromB := bar_index - pvLen
    legDir   := 1

// ---------------------------------------------------------- open a trade ---
if anyBuy or anySell
    posDir   := anyBuy ? 1 : -1
    posSrc   := (takeSweepB or takeSweepS) ? 1 : (takeBrB or takeBrS) ? 2 : 3
    // E-165. THE FILL, NOT THE LEVEL. A stop order resting at a level only
    // fills AT that level if this bar has not already opened past it. The
    // sweep bar is a WICK - it closes back through the level - so on 75% of
    // setups this bar opens on the far side, nothing can still be resting
    // there, and the real fill is the OPEN. Booking the level instead is what
    // made this strategy look profitable when it is not: it extracted +0.0226
    // a trade at t = 5 from a DRIFTLESS RANDOM WALK. f_fill never returns a
    // price better than the trigger.
    trigPx = takeSweepB ? lvlB : takeSweepS ? lvlS :
             takeBrB    ? rTrig : takeBrS   ? sTrig :
             takeObB    ? obBullTop : takeObS ? obBearBot : close
    posEntry := f_fill(trigPx, open, anyBuy ? 1 : -1)
    // Built in pieces on single lines. A multi-line ternary indented by a
    // multiple of four is read by Pine as a BLOCK, not a continuation, and the
    // compiler then reports "end of line without line continuation" on the
    // line ABOVE - which is what this file shipped with. check_pine.py now
    // catches that; it did not before.
    stopSweep = takeSweepB ? extBf - stopBuf * atrB : extSf + stopBuf * atrS
    stopBr    = takeBrB ? rStop : sStop
    stopObRet = takeObB ? obBullBot - stopBuf * atr : obBearTop + stopBuf * atr
    stopObDet = takeDetB ? low[obp] - stopBuf * atr : high[obp] + stopBuf * atr
    isSweep   = takeSweepB or takeSweepS
    isBr      = takeBrB or takeBrS
    isObRet   = takeObB or takeObS
    posStop  := isSweep ? stopSweep : isBr ? stopBr : isObRet ? stopObRet : stopObDet
    posWith  := anyBuy ? withB : withS
    posGrade := ckScore
    posInit  := posStop
    posPeak  := posEntry
    posBar   := bar_index
    tgtRuler = tgtMode == "N x risk" and tgtR > 0 ? posEntry + posDir * tgtR * math.abs(posEntry - posInit) : na
    posTgt  := tgtMode == "next liquidity level" ? f_nextLevel(posDir, posEntry) : tgtRuler

// ---- CONSUMING THE SETUP, AND WHY IT IS NOT INSIDE THE BLOCK ABOVE --------
// This used to sit inside `if anyBuy or anySell`, i.e. it only ran when the
// SIMULATED book took the trade. That was harmless only while sig* was itself
// gated on the book being flat. Now that a signal is drawn whether or not the
// book is busy, a setup left unconsumed would re-fire its mark on every later
// bar that touched the same level and bury the chart in duplicates.
//
// So the setup is spent when the SIGNAL fires. One mark per setup, drawn
// always; the book still takes it only when flat. It runs after the block
// above because that block reads lvlB / swB / extBf to build the stop.
if sigSweepB
    lvlB := na
    swB  := na
if sigSweepS
    lvlS := na
    swS  := na
if sigBrB
    rState := 0
    rLvl := na
if sigBrS
    sState := 0
    sLvl := na
if sigObB
    obBullTop := na
if sigObS
    obBearBot := na

// ----------------------------------------------------------- the exit ------
// E-110: the bar that filled us may not book a FAVOURABLE exit. The stop IS
// allowed on the entry bar, because a move running straight on through us is a
// real loss and pretending otherwise flatters the result.
var float exitPx = na
closedNow = false

if posDir != 0 and barstate.isconfirmed
    hitStop = posDir > 0 ? low <= posStop : high >= posStop
    aged    = bar_index - posBar >= maxHold

    // The give-back ratchet, in the SAME ORDER the research does it: the stop
    // is tested first against the level that was already resting, THEN this
    // bar's extreme updates the peak, THEN the new level is worked out.
    //
    // E-151. That new level comes from THIS bar's high, so it cannot be placed
    // until this bar has closed. If price has already left it behind, no order
    // could have been resting there. The reference implementation
    // (engine.trail_level) treats that as EXIT NOW, at this bar's close - and
    // an earlier version of this file instead moved the stop to the close and
    // held the position into the next bar. That is a third model, it fires on
    // about 40% of trades, and it booked 9.4% per trade MORE than the strategy
    // this file's header claims to measure. The panel must not be more
    // optimistic than the backtest that justified the rule.
    // HIGH WIN RATE MODE. A fixed target at hiWin x risk, checked before the
    // trail so it wins the tie. E-110: the entry bar may not book its own
    // favourable extreme, so this cannot fire on posBar.
    hiTgt = hiWin > 0 and not na(posInit)
         ? posEntry + posDir * hiWin * math.abs(posEntry - posInit) : na
    hitTgt = not na(hiTgt) and bar_index > posBar
         and (posDir > 0 ? high >= hiTgt : low <= hiTgt)

    trailOut = false
    if not hitStop and not hitTgt and bar_index > posBar
        posPeak := posDir > 0 ? math.max(posPeak, high) : math.min(posPeak, low)
        runUp = posDir * (posPeak - posEntry)
        risk0 = math.abs(posEntry - posInit)
        runR  = risk0 > 0 ? runUp / risk0 : 0.0

        // STAGE 1 - BREAK EVEN. Veer: "sl closer to be as it grows". The stop
        // goes to the TRUE breakeven, which is entry plus the spread and both
        // slippages, not entry - a stop at entry still loses the round trip.
        if beAtR > 0 and runR >= beAtR
            beLvl = posEntry + posDir * (spreadPts + 2.0 * slipPts)
            if posDir > 0 ? beLvl < close : beLvl > close
                posStop := posDir > 0 ? math.max(posStop, beLvl)
                                      : math.min(posStop, beLvl)

        // STAGE 2 - THE TRAIL, and only once the trade has earned it. Veer:
        // "trail sl not too aggressively for liquidity sweeps". A sweep needs
        // room to breathe before the ratchet starts, so the trail arms at
        // trailAtR rather than on bar one.
        if runUp > 0 and runR >= trailAtR
            cand = posEntry + posDir * runUp * (1.0 - giveBack)
            if posDir > 0 ? cand >= close : cand <= close
                trailOut := true
            else
                posStop := posDir > 0 ? math.max(posStop, cand)
                                      : math.min(posStop, cand)

    if hitStop or hitTgt or aged or trailOut
        // A stop does not fill at its price when the bar OPENS past it - it
        // fills at the open. 15% of exits on M1 gap through, and booking the
        // stop price for those flattered the book by 9.1 points.
        gapPx   = posDir > 0 ? (open <= posStop ? open : posStop)
                             : (open >= posStop ? open : posStop)
        exitPx  := hitStop ? gapPx : hitTgt ? hiTgt : close
        // NET, not gross. The spread once (buy the ask, sell the bid) and the
        // slippage twice (a stop order fills at or worse than its level, both
        // on the way in and on the way out).
        pts     = posDir * (exitPx - posEntry) - spreadPts - 2.0 * slipPts
        if nTrades == 0
            firstT := time
        nTrades  += 1
        nWins    += pts > 0 ? 1 : 0
        sumPts   += pts
        bestPts  := math.max(bestPts, pts)
        worstPts := math.min(worstPts, pts)
        peakEq   := math.max(peakEq, sumPts)
        maxDD    := math.max(maxDD, peakEq - sumPts)
        if posDir > 0
            nLong   += 1
            ptsLong += pts
        else
            nShort   += 1
            ptsShort += pts
        if posGrade >= 6
            nApp += 1
            pApp += pts
            wApp += pts > 0 ? 1 : 0
        else if posGrade >= 4
            nAp += 1
            pAp += pts
            wAp += pts > 0 ? 1 : 0
        else
            nA += 1
            pA += pts
            wA += pts > 0 ? 1 : 0
        if posWith
            nWith += 1
            pWith += pts
            wWith += pts > 0 ? 1 : 0
        else
            nAgainst += 1
            pAgainst += pts
            wAgainst += pts > 0 ? 1 : 0
        if posSrc == 1
            nS += 1
            pS += pts
            wS += pts > 0 ? 1 : 0
        else if posSrc == 2
            nB += 1
            pB += pts
            wB += pts > 0 ? 1 : 0
        else
            nO += 1
            pO += pts
            wO += pts > 0 ? 1 : 0
        if showHistEff
            label.new(bar_index, posDir > 0 ? math.max(posEntry, exitPx) : math.min(posEntry, exitPx),
                 f_num(pts, "0.0") + "pt " + f_ccy(pts),
                 style = posDir > 0 ? label.style_label_lower_left : label.style_label_upper_left,
                 color = color.new(chart.bg_color, 100),
                 textcolor = color.new(pts > 0 ? cBuy : cSell, 15), size = size.tiny)
        posDir := 0
        posEntry := na
        posStop := na
        posBar := na
        posSrc := 0
        posTgt := na
        closedNow := true


// ======================= THE LIVE POSITION, DRAWN ==========================
// One set of objects, created on the fill and moved each bar, deleted on the
// exit. Nothing is recreated per bar.
var box   pBox   = na
var line  pEnt   = na
var line  pSl    = na
var line  pTp    = na
var label lSl    = na
var label lTp    = na
var label lPnl   = na
var line  pBe    = na
var label lBe    = na

f_killLive() =>
    if not na(pBox)
        box.delete(pBox)
    if not na(pEnt)
        line.delete(pEnt)
    if not na(pSl)
        line.delete(pSl)
    if not na(pTp)
        line.delete(pTp)
    if not na(lSl)
        label.delete(lSl)
    if not na(lTp)
        label.delete(lTp)
    if not na(lPnl)
        label.delete(lPnl)
    if not na(pBe)
        line.delete(pBe)
    if not na(lBe)
        label.delete(lBe)
    true

// posDir is checked as well as the signal: a trade can open and be stopped
// out on the SAME bar, and the exit block resets posBar to na when it does.
// Without this guard that case called box.new(na, ...) with a na coordinate.
if (anyBuy or anySell) and showLive and posDir != 0
    f_killLive()
    col = posDir > 0 ? cBuy : cSell
    // Veer: "massive profit box". On M1 a trade can hold 240 bars, so this box
    // is genuinely four hours wide - the fix is not to shrink it but to stop it
    // shouting. Border only, and a fill faint enough that the candles inside it
    // stay the brightest thing on the chart.
    pBox := box.new(posBar, posEntry, bar_index, close,
         border_color = color.new(col, 45), border_width = 1,
         bgcolor = color.new(col, 97))
    pEnt := line.new(posBar, posEntry, bar_index, posEntry,
         color = color.new(#B0BEC5, 20), width = 1)
    pSl  := line.new(posBar, posStop, bar_index, posStop,
         color = color.new(cSell, 15), width = 1, style = line.style_dashed)
    lSl  := label.new(bar_index, posStop, "", style = label.style_label_left,
         color = color.new(chart.bg_color, 100), textcolor = color.new(cSell, 0),
         size = size.tiny)
    lPnl := label.new(bar_index, close, "", style = label.style_label_left,
         color = color.new(chart.bg_color, 100), textcolor = color.new(col, 0),
         size = size.small)
    // THE REAL BREAKEVEN. Not the entry - the price at which the trade nets
    // zero after the spread and both sides of slippage. Until the stop is past
    // this line, "at breakeven" is a story.
    bePx = posEntry + posDir * (spreadPts + 2.0 * slipPts)
    pBe := line.new(posBar, bePx, bar_index, bePx,
         color = color.new(#8FA3B8, 40), width = 1, style = line.style_dotted)
    lBe := label.new(bar_index, bePx, "", style = label.style_label_left,
         color = color.new(chart.bg_color, 100), textcolor = color.new(#8FA3B8, 10),
         size = size.tiny)
    if not na(posTgt)
        pTp := line.new(posBar, posTgt, bar_index, posTgt,
             color = color.new(cBuy, 30), width = 1, style = line.style_dotted)
        lTp := label.new(bar_index, posTgt, "", style = label.style_label_left,
             color = color.new(chart.bg_color, 100), textcolor = color.new(cBuy, 10),
             size = size.tiny)

if posDir == 0 and not na(pEnt)
    f_killLive()
    pBox := na
    pEnt := na
    pSl  := na
    pTp  := na
    lSl  := na
    lTp  := na
    lPnl := na
    pBe  := na
    lBe  := na

if posDir != 0 and showLive and not na(pEnt)
    live = posDir * (close - posEntry) - spreadPts - 2.0 * slipPts
    col  = live >= 0 ? cBuy : cSell
    box.set_right(pBox, bar_index)
    box.set_top(pBox, math.max(posEntry, close))
    box.set_bottom(pBox, math.min(posEntry, close))
    box.set_bgcolor(pBox, color.new(col, 93))
    box.set_border_color(pBox, color.new(col, 60))
    line.set_x2(pEnt, bar_index)
    line.set_x2(pSl, bar_index)
    line.set_y1(pSl, posStop)
    line.set_y2(pSl, posStop)
    // NET. A stop at the entry price is not breakeven - you are still down the
    // round trip. This is the number that decides whether the trade is actually
    // safe yet, and it is the honest version of "move to breakeven".
    locked = posDir * (posStop - posEntry) - spreadPts - 2.0 * slipPts
    label.set_xy(lSl, bar_index, posStop)
    label.set_text(lSl, (locked >= 0 ? "LOCKED " : "SL ") + f_num(locked, "0.0")
         + "pt " + f_ccy(locked))
    label.set_textcolor(lSl, color.new(locked >= 0 ? cBuy : cSell, 0))
    label.set_xy(lPnl, bar_index, close)
    label.set_text(lPnl, (posSrc == 1 ? "SWEEP " : posSrc == 2 ? "B+R " : "OB ")
         + f_num(live, "0.0") + "pt " + f_ccy(live))
    label.set_textcolor(lPnl, color.new(col, 0))
    if not na(pBe)
        bePx2 = posEntry + posDir * (spreadPts + 2.0 * slipPts)
        line.set_x2(pBe, bar_index)
        line.set_y1(pBe, bePx2)
        line.set_y2(pBe, bePx2)
        label.set_xy(lBe, bar_index, bePx2)
        // green once the stop has passed it: the trade genuinely cannot lose
        safe = posDir * (posStop - bePx2) >= 0
        label.set_text(lBe, safe ? "BREAKEVEN · locked in" : "BREAKEVEN")
        label.set_textcolor(lBe, color.new(safe ? cBuy : #8FA3B8, 10))
    if not na(pTp)
        line.set_x2(pTp, bar_index)
        label.set_xy(lTp, bar_index, posTgt)
        label.set_text(lTp, (tgtMode == "next liquidity level" ? "LIQUIDITY " : "RULER ")
             + f_num(posDir * (posTgt - posEntry), "0.0")
             + "pt " + f_ccy(posDir * (posTgt - posEntry)))

// ---------------------------------------------------------------- drawing --
// SIGNALS ARE plotshape ON CONFIRMED BARS. plotshape output cannot be deleted
// or moved after the fact, so these can never vanish from history.
// Veer: "we need clear levels like smc idniactor amrekd out". The level is a
// fact about price; whether a simulated trade is open is not a reason to take
// it off his chart, and `posDir == 0` here used to do exactly that.
plot(showLvl and not na(lvlS) ? lvlS : na, "Sell-side level",
     color = color.new(cSell, 45), style = plot.style_linebr, linewidth = 1)
plot(showLvl and not na(lvlB) ? lvlB : na, "Buy-side level",
     color = color.new(cBuy, 45), style = plot.style_linebr, linewidth = 1)

// WITH the bias: the full label. AGAINST it: a small dot, still permanent.
// Nothing is deleted - Veer: "make sure like signals dont disappear".
// THE LEG CATCHER'S OWN MARKS. Deliberately a different shape from the sweep
// so the two can be told apart on the chart and judged separately - E-184 says
// they are measuring completely different things.
plotshape(sigLegB, "LEG BUY", shape.arrowup, location.belowbar,
     color = cBuy, text = "LEG", textcolor = color.white, size = size.small)
plotshape(sigLegS, "LEG SELL", shape.arrowdown, location.abovebar,
     color = cSell, text = "LEG", textcolor = color.white, size = size.small)

plotshape(sigSweepB and (not htfDim or withB), "BUY  sweep",
     shape.labelup, location.belowbar,
     color = cBuy,  text = "BUY",  textcolor = color.white, size = size.tiny)
plotshape(sigSweepS and (not htfDim or withS), "SELL sweep",
     shape.labeldown, location.abovebar,
     color = cSell, text = "SELL", textcolor = color.white, size = size.tiny)
plotshape(pushUp, "volume push up",   shape.triangleup,   location.belowbar,
     color = color.new(cBuy, 30),  size = size.tiny)
plotshape(pushDn, "volume push down", shape.triangledown, location.abovebar,
     color = color.new(cSell, 30), size = size.tiny)
plotshape(htfDim and sigSweepB and not withB, "buy sweep (against bias)",
     shape.circle, location.belowbar, color = color.new(cBuy, 55), size = size.tiny)
plotshape(htfDim and sigSweepS and not withS, "sell sweep (against bias)",
     shape.circle, location.abovebar, color = color.new(cSell, 55), size = size.tiny)
plotshape(sigBrB, "BUY  break+retest",  shape.triangleup,   location.belowbar,
     color = cBuy,  size = size.small)
plotshape(sigBrS, "SELL break+retest",  shape.triangledown, location.abovebar,
     color = cSell, size = size.small)
plotshape(sigObB, "BUY  order block",  shape.diamond, location.belowbar,
     color = cBuy,  size = size.tiny)
plotshape(sigObS, "SELL order block",  shape.diamond, location.abovebar,
     color = cSell, size = size.tiny)
plotshape(sigDetB, "BUY  OB at detection",  shape.circle, location.belowbar,
     color = cBuy,  size = size.tiny)
plotshape(sigDetS, "SELL OB at detection",  shape.circle, location.abovebar,
     color = cSell, size = size.tiny)
plotshape(showRefEff and tooWideB, "risk cap refused (buy)",  shape.xcross, location.belowbar,
     color = color.new(cBuy, 70),  size = size.tiny)
plotshape(showRefEff and tooWideS, "risk cap refused (sell)", shape.xcross, location.abovebar,
     color = color.new(cSell, 70), size = size.tiny)

// ================================ THE PANEL ================================
var table tp = na

f_row(r, a, b, c, col) =>
    table.cell(tp, 0, r, a, text_color = color.new(#8FA3B8, 0), text_size = size.small,
         text_halign = text.align_left)
    table.cell(tp, 1, r, b, text_color = col, text_size = size.small,
         text_halign = text.align_right)
    table.cell(tp, 2, r, c, text_color = color.new(#8FA3B8, 25), text_size = size.tiny,
         text_halign = text.align_right)

f_sep(r, cap) =>
    table.cell(tp, 0, r, cap, text_color = color.new(#5C7089, 0), text_size = size.tiny,
         text_halign = text.align_left)
    table.cell(tp, 1, r, "", text_color = color.new(#5C7089, 0))
    table.cell(tp, 2, r, "", text_color = color.new(#5C7089, 0))

if barstate.islast and showPanel
    if not na(tp)
        table.delete(tp)
    pos = panelPos == "Top right" ? position.top_right :
          panelPos == "Bottom left" ? position.bottom_left : position.bottom_right
    // The panel is exactly as tall as the rows it will draw. With one signal
    // running there is no "which signal is paying" to answer - the profit row
    // IS the sweep - so that block disappears rather than printing two rows of
    // zeros. Veer: "nothing overboard".
    nSigOn   = (useSweep ? 1 : 0) + (useBR ? 1 : 0) + (useOB ? 1 : 0)
    showSplit = nSigOn > 1
    // THE ROW COUNT MUST MATCH THE ROWS ACTUALLY WRITTEN, and it did not.
    // A table.cell() at a row index past the table's size is a Pine RUNTIME
    // ERROR and the panel stops drawing. On the SHIPPED defaults this wrote 16
    // rows into a table of 15: the formula still charged 3 rows for an htfOn
    // block that had been removed, and charged NOTHING for the 5-row checklist
    // that replaced it. It was only correct with every single toggle switched
    // on, which is the one configuration nobody runs.
    //
    // So every term below names the block it pays for, in the order the blocks
    // are drawn, and tools/check_panel.py counts the file and fails the build
    // if the two ever disagree again.
    nRows = 1                                  // title
         + 4                                   // today / if traded / trades / win
         + (showSplit ? 1 + nSigOn : 0)         // -- which signal is paying --
         + 2                                   // cost paid / enter by
         + (showCheck ? 5 : 0)                  // -- checklist -- + 4 grade rows
         + (mtfOn ? 1 : 0)                      // trend stack
         + (showLegsEff ? 3 : 0)                   // -- legs -- + 2
         + 1                                   // the separator before the tail
         + (panelBig ? 10 : 0)                  // the full panel
    tp := table.new(pos, 3, nRows, border_width = 1,
         bgcolor = color.new(#0E1621, 8), border_color = color.new(#2A3A4D, 40),
         frame_color = color.new(#2A3A4D, 20), frame_width = 1)

    cVal = color.new(#E6EDF5, 0)
    cPos = color.new(cBuy, 0)
    cNeg = color.new(cSell, 0)
    winPc = nTrades > 0 ? 100.0 * nWins / nTrades : 0.0

    table.cell(tp, 0, 0, "LIQUIDITY SNIPER", text_color = cVal, text_size = size.small,
         text_halign = text.align_left)
    table.cell(tp, 1, 0, "", text_color = cVal)
    table.cell(tp, 2, 0, posDir == 0 ? "flat" : posDir > 0 ? "LONG" : "SHORT",
         text_color = posDir == 0 ? color.new(#8FA3B8, 0) : posDir > 0 ? cPos : cNeg,
         text_size = size.tiny, text_halign = text.align_right)

    // Rows are placed from a running counter, not hard-coded indices, so
    // hiding a block cannot leave a hole or stack two rows on each other.
    r = 1

    // WHAT PERIOD IS THIS? He asked and the old panel never said: it is every
    // bar TradingView has loaded on the chart - roughly a fortnight on M1, not
    // today - so the range is printed.
    f_row(r, "today",
             str.format_time(time, "EEE dd MMM", tzSess),
             nTrades > 0 ? "since " + str.format_time(firstT, "HH:mm", tzSess)
                         : "no trades yet", cVal)
    r += 1
    // Labelled "if traded", not "profit". With the E-165 fill correction this
    // number is what the signals would REALLY have paid on the bars loaded -
    // and on XAUUSD that is around zero. It is a measurement, not a promise,
    // and it must never again read like a sales figure.
    f_row(r, "if traded", f_num(sumPts, "0.0") + "pt", f_ccy(sumPts),
             sumPts >= 0 ? cPos : cNeg)
    r += 1
    f_row(r, "trades", str.tostring(nTrades),
             str.tostring(nTrades) + " so far today", cVal)
    r += 1
    f_row(r, "win rate", str.tostring(winPc, "0.0") + "%",
             str.tostring(nWins) + "W " + str.tostring(nTrades - nWins) + "L", cVal)
    r += 1

    if showSplit
        f_sep(r, "── which signal is paying ──")
        r += 1
        if useSweep
            f_row(r, "SWEEP", f_num(pS, "0.0") + "pt",
                 str.tostring(nS) + " tr  " + (nS > 0 ? str.tostring(100.0 * wS / nS, "0") + "%W" : "-"),
                 pS >= 0 ? cPos : cNeg)
            r += 1
        if useBR
            f_row(r, "BREAK+RETEST", f_num(pB, "0.0") + "pt",
                 str.tostring(nB) + " tr  " + (nB > 0 ? str.tostring(100.0 * wB / nB, "0") + "%W" : "-"),
                 pB >= 0 ? cPos : cNeg)
            r += 1
        if useOB
            f_row(r, "ORDER BLOCK", f_num(pO, "0.0") + "pt",
                 str.tostring(nO) + " tr  " + (nO > 0 ? str.tostring(100.0 * wO / nO, "0") + "%W" : "-"),
                 pO >= 0 ? cPos : cNeg)
            r += 1

    // how late can he be and still have a valid trade? The stop does not move
    // when he chases, so the risk cap is what breaks first - not the profit.
    chaseTo  = posDir != 0 ? posStop + posDir * maxRisk * atr : na
    chasePts = posDir != 0 ? posDir * (chaseTo - close) : na
    // THE COST PAID, in full. E-149 found that adding signals raises total
    // points and CUTS the per-trade edge, and every extra trade pays the round
    // trip again. On M1 all four signals beat the sweep alone at zero slippage
    // and LOSE to it past 0.02 - because 85 trades a day pay 85 round trips a
    // day. This row is that trade-off, live, in money.
    costPaid = nTrades * (spreadPts + 2.0 * slipPts)
    f_row(r, "cost paid", "-" + str.tostring(costPaid, "0.0") + "pt",
             f_ccy(-costPaid), cNeg)
    r += 1
    f_row(r, "enter by",
             posDir == 0 ? "-" : str.tostring(chaseTo, format.mintick),
             posDir == 0 ? "flat" : f_num(chasePts, "0.0") + "pt of chase left",
             posDir == 0 ? cVal : (chasePts > 0 ? cPos : cNeg))
    r += 1
    // THE TREND STACK. Veer's own model: "a m15 changes from m5 which changes
    // from m1" - the lower clock makes the new trend first, so an H1 downtrend
    // is where the M15 buy lives. Four directions, one row, no interpretation
    // applied. Where they disagree is where the turn is.
    // THE CHECKLIST, live. Seven confluences, all knowable at the signal bar.
    if showCheck
        f_sep(r, "── checklist " + str.tostring(ckScore) + "/7 ──   grade "
                  + (ckScore >= 6 ? "A++" : ckScore >= 4 ? "A+" : "A"))
        r += 1
        f_row(r, "sweep OB vol bias",
                 f_tick(ckSweep) + " " + f_tick(ckOB) + " " + f_tick(ckVol) + " " + f_tick(ckBias),
                 "sess " + f_tick(ckSess) + "  room " + f_tick(ckDOL) + "  tight " + f_tick(ckTight),
                 ckScore >= 4 ? cPos : cVal)
        r += 1
        f_row(r, "A++  6-7", f_num(pApp, "0.0") + "pt",
                 str.tostring(nApp) + " tr  " +
                 (nApp > 0 ? str.tostring(100.0 * wApp / nApp, "0") + "%W" : "-"),
                 pApp >= 0 ? cPos : cNeg)
        r += 1
        f_row(r, "A+   4-5", f_num(pAp, "0.0") + "pt",
                 str.tostring(nAp) + " tr  " +
                 (nAp > 0 ? str.tostring(100.0 * wAp / nAp, "0") + "%W" : "-"),
                 pAp >= 0 ? cPos : cNeg)
        r += 1
        f_row(r, "A    0-3", f_num(pA, "0.0") + "pt",
                 str.tostring(nA) + " tr  " +
                 (nA > 0 ? str.tostring(100.0 * wA / nA, "0") + "%W" : "-"),
                 pA >= 0 ? cPos : cNeg)
        r += 1
    if mtfOn
        f_row(r, "trend stack",
                 f_arrow(b1) + " " + f_arrow(b5) + " " + f_arrow(b15) + " " + f_arrow(b60),
                 "M1  M5  M15  H1",
                 (b1 == b5 and b5 == b15 and b15 == b60)
                      ? (nz(b1) > 0 ? cPos : cNeg) : cVal)
        r += 1
    if showLegsEff
        f_sep(r, "── the legs, and how many we flagged ──")
        r += 1
        f_row(r, "legs caught", str.tostring(nLegHit) + " / " + str.tostring(nLegAll),
                 nLegAll > 0 ? str.tostring(100.0 * nLegHit / nLegAll, "0") + "% flagged" : "-",
                 nLegAll > 0 and nLegHit * 2 >= nLegAll ? cPos : cNeg)
        r += 1
        f_row(r, "points in legs", f_num(ptsLegHit, "0.0") + "pt",
                 "of " + f_num(ptsLegAll, "0.0") + "pt on offer", cVal)
        r += 1
    f_sep(r, "signals are real · the edge is NOT proven (E-165)")
    r += 1

    if panelBig
        f_sep(r, "── risk ──")
        r += 1
        f_row(r, "worst trade", f_num(worstPts, "0.0") + "pt", f_ccy(worstPts), cNeg)
        r += 1
        f_row(r, "max drawdown", f_num(-maxDD, "0.0") + "pt", f_ccy(-maxDD), cNeg)
        r += 1
        f_row(r, "refused", str.tostring(nRefused), "stop too wide", cVal)
        r += 1
        // Volume-pivot blocks silently do nothing on a feed without volume,
        // and "no blocks" looks identical to "no setups". Say which it is.
        // The gap between what the CHART shows and what the PANEL books. On
        // M1 the simulation is in a trade most of the time, so most setups
        // cannot be booked - and that is a fact about one-account simulation,
        // not about the signals. Veer trades by hand and can take them.
        // E-170 tested this split on history and REJECTED it - the with-trend
        // and against-trend halves shared a sign in 22 of 25 cells. It stays in
        // the full panel only so the counters are not computed and thrown away,
        // which is a habit this file has been caught in before.
        f_row(r, "with / against bias",
                 f_num(pWith, "0.0") + " / " + f_num(pAgainst, "0.0") + "pt",
                 str.tostring(nWith) + " / " + str.tostring(nAgainst) + " tr", cVal)
        r += 1
        f_row(r, "missed while busy", str.tostring(nMissed),
                 "shown, not booked", nMissed > 0 ? cNeg : cVal)
        r += 1
        f_row(r, "volume feed", volOk ? "present" : "MISSING",
                 volOk ? "volume blocks work" : "volume blocks cannot fire",
                 volOk ? cVal : cNeg)
        r += 1
        // CLAUDE.md requires a long/short split on every claim. These four
        // counters were being accumulated on every trade and displayed
        // NOWHERE - the required check was computed and thrown away.
        f_row(r, "long / short",
                 f_num(ptsLong, "0.0") + " / " + f_num(ptsShort, "0.0") + "pt",
                 str.tostring(nLong) + "L " + str.tostring(nShort) + "S",
                 ptsLong >= 0 and ptsShort >= 0 ? cPos : cNeg)
        r += 1
        f_row(r, "best trade", f_num(bestPts, "0.0") + "pt", f_ccy(bestPts), cPos)
        r += 1
        f_row(r, "session",
                 inN ? "New York" : inL ? "London" : inA ? "Asia" : "closed",
                 posDir == 0 ? str.tostring(lots, "0.00") + " lots"
                             : f_ccy(posDir * (close - posEntry)), cVal)

plot(posDir, "Position (1 long, -1 short)", display = display.status_line)
plot(posSrc, "Source (1 sweep, 2 B+R, 3 OB)", display = display.status_line)
plot(posDir != 0 ? posEntry : na, "Entry", display = display.status_line)
plot(atr, "ATR(14)", display = display.status_line)

alertcondition(sigLegB, "LEG BUY", "Leg catcher BUY - {{ticker}} {{interval}}")
alertcondition(sigLegS, "LEG SELL", "Leg catcher SELL - {{ticker}} {{interval}}")
alertcondition(sigSweepB or sigBrB or sigObB or sigDetB, "LS BUY",  "Liquidity Sniper BUY")
alertcondition(sigSweepS or sigBrS or sigObS or sigDetS, "LS SELL", "Liquidity Sniper SELL")
alertcondition(closedNow,  "LS CLOSE", "Liquidity Sniper trade closed")
