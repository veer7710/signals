//@version=6
// =====================================================================
//  xau clean  --  the chart SNIPER.mq5 trades from
//
//  Deliberately sparse. Everything drawn here is something the EA acts on
//  or refuses on. Nothing is decoration.
//
//    BSL  buy-side liquidity   -- highs. Buy stops and resting sells rest
//                                 ABOVE price. Drawn above.
//    SSL  sell-side liquidity  -- lows. Sell stops rest BELOW price.
//    LRL  low resistance       -- clean path to the pool, nothing in the way.
//                                 Price travels to these fast.
//    HRL  high resistance      -- levels stacked in between. Price grinds,
//                                 and a target behind HRL is a bad target.
//    ***  a REACTION level     -- price has already turned here 3+ times.
//                                 These are the ones that matter.
//
//  A level is NOT resistance. It is a shelf of resting orders plus the stops
//  of everyone positioned underneath it. Price is ATTRACTED to it, trades
//  through to fill them, and only then reverses. So the chart marks where
//  price is GOING, not where it will stop.
//
//  Signals appear only on CONFIRMED bars. Nothing that appears ever vanishes.
// =====================================================================
indicator("xau clean", overlay = true, max_lines_count = 100,
          max_labels_count = 60, max_boxes_count = 20)

gL = "Liquidity"
swN     = input.int(3,    "Swing strength",           group = gL, minval = 1)
lookN   = input.int(300,  "Lookback (bars)",          group = gL, minval = 50)
showN   = input.int(2,    "Pools shown each side",    group = gL, minval = 1, maxval = 4,
   tooltip = "Kept low on purpose. Forty levels on a chart is the same as none.")
eqTol   = input.float(0.15,"Equal levels merge (ATR)",group = gL, step = 0.05)
reactN  = input.int(3,    "Touches to call it a reaction level", group = gL, minval = 2)
hrlN    = input.int(2,    "Levels in between = HRL",  group = gL, minval = 1)

gS = "Signal"
pierceA = input.float(0.05,"Pierce depth (ATR)",      group = gS, step = 0.01)
expandA = input.float(0.35,"Close beyond = dead (ATR)",group = gS, step = 0.05,
   tooltip = "A close this far past the level means the stops were taken. The level is spent and must not be faded.")
minRoom = input.float(1.20,"Min clear air to trade (ATR)", group = gS, step = 0.1)

gX = "Trade"
bufA    = input.float(0.30,"Stop buffer (ATR)",       group = gX, step = 0.05)
maxStop = input.float(3.00,"Skip if stop > (ATR)",    group = gX, step = 0.1)
showBox = input.bool(true, "Position box",            group = gX)

gV = "Look"
cBuy  = input.color(#26a69a, "Buy",      group = gV)
cSell = input.color(#ef5350, "Sell",     group = gV)
cBsl  = input.color(#ef5350, "BSL",      group = gV)
cSsl  = input.color(#26a69a, "SSL",      group = gV)
cDead = input.color(#546e7a, "Spent",    group = gV)

atr  = ta.atr(14)
band = ta.tr * 0.5          // one noise band; a trail cannot hold inside this
ok   = barstate.isconfirmed or barstate.ishistory

// ---------------------------------------------------------------- pools
// level, touch count, spent flag. Newest last.
var float[] hL = array.new_float()
var int[]   hT = array.new_int()
var bool[]  hD = array.new_bool()
var float[] lL = array.new_float()
var int[]   lT = array.new_int()
var bool[]  lD = array.new_bool()

ph = ta.pivothigh(high, swN, swN)
pl = ta.pivotlow(low,  swN, swN)

push(float[] L, int[] T, bool[] D, float v, float tol) =>
    hit = -1
    if array.size(L) > 0
        for i = 0 to array.size(L) - 1
            if math.abs(array.get(L, i) - v) <= tol
                hit := i
    if hit >= 0
        array.set(T, hit, array.get(T, hit) + 1)     // an equal level is a TOUCH
    else
        array.push(L, v)
        array.push(T, 1)
        array.push(D, false)
        if array.size(L) > 30
            array.shift(L)
            array.shift(T)
            array.shift(D)

if not na(ph)
    push(hL, hT, hD, ph, eqTol * atr)
if not na(pl)
    push(lL, lT, lD, pl, eqTol * atr)

// count how many live levels sit BETWEEN price and a target -> HRL or LRL
between(float target, int dir) =>
    n = 0
    if dir == 1 and array.size(hL) > 0
        for i = 0 to array.size(hL) - 1
            v = array.get(hL, i)
            if not array.get(hD, i) and v > close and v < target
                n += 1
    if dir == -1 and array.size(lL) > 0
        for i = 0 to array.size(lL) - 1
            v = array.get(lL, i)
            if not array.get(lD, i) and v < close and v > target
                n += 1
    n

// nearest live pool on a side
nearest(int dir) =>
    best = 0.0
    bi = -1
    if dir == 1 and array.size(hL) > 0
        for i = 0 to array.size(hL) - 1
            v = array.get(hL, i)
            if not array.get(hD, i) and v > close and (bi < 0 or v < best)
                best := v
                bi := i
    if dir == -1 and array.size(lL) > 0
        for i = 0 to array.size(lL) - 1
            v = array.get(lL, i)
            if not array.get(lD, i) and v < close and (bi < 0 or v > best)
                best := v
                bi := i
    [best, bi]

// ---------------------------------------------------------------- signal
// pierce a pool, fail to expand, close back inside -> the stops were taken
// and the level did NOT hold. That is the only thing traded here.
sig = 0
if ok
    [bslLv, bi] = nearest(1)
    [sslLv, li] = nearest(-1)
    if li >= 0 and low <= sslLv - pierceA * atr
        if close < sslLv - expandA * atr
            array.set(lD, li, true)                  // spent: broke, never fade
        else if close > sslLv
            sig := 1
            array.set(lD, li, true)                  // one event per level
    if sig == 0 and bi >= 0 and high >= bslLv + pierceA * atr
        if close > bslLv + expandA * atr
            array.set(hD, bi, true)
        else if close < bslLv
            sig := -1
            array.set(hD, bi, true)

// room to the opposing pool -- a trade with a shelf in its face has nowhere to go
[tgtUp, _iu] = nearest(1)
[tgtDn, _id] = nearest(-1)
roomUp = _iu >= 0 ? tgtUp - close : 1e9
roomDn = _id >= 0 ? close - tgtDn : 1e9
room   = sig == 1 ? roomUp : sig == -1 ? roomDn : 0.0

swLo = ta.lowest(low,  swN)
swHi = ta.highest(high, swN)
stopD = sig == 1 ? close - swLo + bufA * atr : sig == -1 ? swHi - close + bufA * atr : na
blocked = sig != 0 and (room < minRoom * atr or stopD > maxStop * atr)
buy  = sig ==  1 and not blocked
sell = sig == -1 and not blocked

// ---------------------------------------------------------------- position
var int   pd = 0
var float pe = na
var float ps = na
var float pt = na
var float pk = 0.0
var int   pb = na

if ok
    if pd != 0
        pk := math.max(pk, pd == 1 ? high - pe : pe - low)
        if (pd == 1 ? low <= ps : high >= ps) or (pd == 1 ? high >= pt : low <= pt)
            pd := 0
            pk := 0.0
        else if pk >= 0.5 * atr
            // keep 65% of the peak, rising to 90% as the peak grows, and never
            // closer than one noise band -- no trail can hold inside the noise
            k = math.min(0.90, 0.65 + 0.25 * math.min(1.0, (pk / atr - 0.5) / 1.5))
            want = pe + (pd == 1 ? 1 : -1) * math.min(pk * k, pk - band)
            ps := pd == 1 ? math.max(ps, want) : math.min(ps, want)
    if pd == 0 and (buy[1] or sell[1])
        pd := buy[1] ? 1 : -1
        pe := open
        d = pd == 1 ? stopD[1] : stopD[1]
        ps := pe - pd * d
        pt := pd == 1 ? tgtUp : tgtDn          // target IS the opposing pool
        pk := 0.0
        pb := bar_index

// ---------------------------------------------------------------- draw
var line[] drawn = array.new_line()
var label[] tags = array.new_label()
var box  pBox = na
var line pSl = na
var line pTp = na

if barstate.islast
    if array.size(drawn) > 0
        for i = 0 to array.size(drawn) - 1
            line.delete(array.get(drawn, i))
        array.clear(drawn)
    if array.size(tags) > 0
        for i = 0 to array.size(tags) - 1
            label.delete(array.get(tags, i))
        array.clear(tags)

    // nearest showN live pools each side, nothing more
    for side = -1 to 1 by 2
        L = side == 1 ? hL : lL
        T = side == 1 ? hT : lT
        D = side == 1 ? hD : lD
        col = side == 1 ? cBsl : cSsl
        shown = 0
        prev = side == 1 ? 0.0 : 1e12
        for pass = 1 to showN
            b = 0.0
            bi = -1
            if array.size(L) > 0
                for i = 0 to array.size(L) - 1
                    v = array.get(L, i)
                    inFront = side == 1 ? (v > close and v > prev) : (v < close and v < prev)
                    if not array.get(D, i) and inFront and (bi < 0 or (side == 1 ? v < b : v > b))
                        b := v
                        bi := i
            if bi >= 0
                t = array.get(T, bi)
                react = t >= reactN
                res = between(b, side) >= hrlN ? "HRL" : "LRL"
                ln = line.new(bar_index - 40, b, bar_index + 12, b,
                     color = color.new(col, react ? 10 : 55),
                     width = react ? 2 : 1,
                     style = react ? line.style_solid : line.style_dotted)
                array.push(drawn, ln)
                if pass == 1
                    txt = (side == 1 ? "BSL " : "SSL ") + str.tostring(b, format.mintick) +
                          "  " + res + (react ? "  ***" : "")
                    array.push(tags, label.new(bar_index + 12, b, txt,
                        style = side == 1 ? label.style_label_left : label.style_label_left,
                        size = size.tiny, color = color.new(col, 88),
                        textcolor = color.new(col, 10)))
                prev := b
                shown += 1

    if not na(pBox)
        box.delete(pBox)
    if not na(pSl)
        line.delete(pSl)
    if not na(pTp)
        line.delete(pTp)
    if pd != 0 and showBox
        c = pd == 1 ? cBuy : cSell
        pBox := box.new(pb, math.max(pe, ps), bar_index + 8, math.min(pe, ps),
                border_color = color.new(c, 55), bgcolor = color.new(c, 91))
        pSl := line.new(pb, ps, bar_index + 8, ps, color = cSell, width = 1,
                style = line.style_dashed)
        pTp := line.new(pb, pt, bar_index + 8, pt, color = cBuy, width = 1,
                style = line.style_dotted)

plotshape(buy,  "BUY",  shape.labelup,   location.belowbar, cBuy,
          text = "BUY",  textcolor = color.white, size = size.tiny)
plotshape(sell, "SELL", shape.labeldown, location.abovebar, cSell,
          text = "SELL", textcolor = color.white, size = size.tiny)
plotshape(blocked, "no room", shape.circle, location.absolute,
          color.new(cDead, 35), size = size.tiny)

// ---------------------------------------------------------------- panel
sess() =>
    h = hour(time, "GMT")
    h >= 23 or h < 7 ? "ASIA" : h < 12 ? "LONDON" : h < 16 ? "LDN/NY" :
       h < 21 ? "NY" : "OFF"

var table tb = na
if barstate.islast
    if na(tb)
        tb := table.new(position.bottom_right, 1, 3,
              bgcolor = color.new(color.black, 84),
              border_color = color.new(color.gray, 75), border_width = 1)
    table.cell(tb, 0, 0, sess() + "   ATR " + str.tostring(atr, "#.##"),
        text_color = color.new(color.white, 15), text_size = size.tiny)
    table.cell(tb, 0, 1, "room  " + str.tostring(roomUp / atr, "#.#") + " up / " +
        str.tostring(roomDn / atr, "#.#") + " dn  (ATR)",
        text_color = color.new(color.gray, 12), text_size = size.tiny)
    table.cell(tb, 0, 2, pd == 0 ? (blocked ? "signal blocked - no room" : "flat") :
        (pd == 1 ? "LONG " : "SHORT ") + str.tostring(pe, format.mintick) +
        "   peak " + str.tostring(atr > 0 ? pk / atr : 0, "#.#") + " ATR",
        text_color = pd == 0 ? (blocked ? color.orange : color.gray) :
                     (pd == 1 ? cBuy : cSell), text_size = size.tiny)

alertcondition(buy,  "xau clean BUY",  "xau clean BUY")
alertcondition(sell, "xau clean SELL", "xau clean SELL")
