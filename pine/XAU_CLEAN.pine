//@version=6
// =====================================================================
//  xau clean  --  the chart SNIPER.mq5 trades from
//
//  PARITY IS THE RULE: every signal this prints, the EA takes. Same ATR,
//  same levels, same absorption test, same confirmation, same bar. If they
//  ever disagree one of them is lying and there is no way to tell which
//  from the chart.
//
//  WHAT IS AND IS NOT A SIGNAL
//    Piercing a level is NOT a signal.
//      EXPANSION  = decisive close beyond -> stops were won, level is dead,
//                   never fade it. Drawn greyed out.
//      ABSORPTION = pierce, no expansion, close back inside -> tradeable,
//                   but only after a reclaim PLUS confirmation.
//    The confirmation is a body close through the OPEN of the last unbroken
//    run of same-direction closes into the extreme. Parameter-free, and
//    earlier than waiting for a swing break.
//
//  RANGE REGIME: when efficiency is low the chart rotates instead of
//  chasing -- buy the lower boundary, sell the upper. On the reference day
//  efficiency was 0.038 and it was traded as a trend. That is the failure
//  this replaces.
//
//  Nothing is drawn on an unconfirmed bar, so a signal that appears never
//  disappears.
// =====================================================================
indicator("xau clean", overlay = true, max_boxes_count = 80,
          max_lines_count = 300, max_labels_count = 200)

grpL = "Levels"
swN     = input.int(3,    "Swing strength",            group = grpL, minval = 1)
lookN   = input.int(240,  "Level lookback (bars)",     group = grpL, minval = 30)
eqTol   = input.float(0.15,"Equal-highs tolerance (ATR)", group = grpL, step = 0.05)
minTouch= input.int(2,    "Minimum touches to count",  group = grpL, minval = 1,
   tooltip = "Significance is MEASURED -- bars that traded back into the level -- not guessed from age.")

grpS = "Sweep test"
pierceA = input.float(0.05,"Pierce depth (ATR)",       group = grpS, step = 0.01)
expandA = input.float(0.35,"Close beyond = EXPANSION (ATR)", group = grpS, step = 0.05,
   tooltip = "A close this far beyond the level means the stops were won. The level is dead and must never be faded.")

grpR = "Regime"
regN    = input.int(30,   "Efficiency window (bars)",  group = grpR, minval = 5)
rangeER = input.float(0.15,"Below this = RANGE",       group = grpR, step = 0.01)
trendER = input.float(0.30,"Above this = TREND",       group = grpR, step = 0.01)
driftM  = input.int(30,   "Drift window (minutes)",    group = grpR, minval = 1)

grpX = "Trade geometry (mirrors the EA)"
stopBuf = input.float(0.30,"Stop buffer (ATR)",        group = grpX, step = 0.05)
maxStop = input.float(3.0, "Skip if stop > (ATR)",     group = grpX, step = 0.1)
cutATR  = input.float(0.41,"Fast-fail cut (ATR)",      group = grpX, step = 0.01,
   tooltip = "0.60 pts / 1.47 M1 ATR. Trades that go this far against inside 60s had a 6.2% hit rate; the rest had 82.6%.")
lockArm = input.float(0.50,"Lock arms at peak (ATR)",  group = grpX, step = 0.05)

grpV = "Chart"
showLv  = input.bool(true, "Levels",        group = grpV)
showBox = input.bool(true, "Live trade box",group = grpV)
showPan = input.bool(true, "Panel",         group = grpV)
cBuy    = input.color(#26a69a, "Buy",   group = grpV)
cSell   = input.color(#ef5350, "Sell",  group = grpV)
cLive   = input.color(#ffb74d, "Level", group = grpV)
cDead   = input.color(#607d8b, "Dead level", group = grpV)

atr = ta.atr(14)
confirmed = barstate.isconfirmed or barstate.ishistory

// ---------------------------------------------------- regime + drift
efficiency() =>
    net = math.abs(close - close[regN])
    path = 0.0
    for i = 0 to regN - 1
        path += math.abs(close[i] - close[i + 1])
    path > 0 ? net / path : 0.0

er = efficiency()
regime = er < rangeER ? "RANGE" : er > trendER ? "TREND" : "MIXED"
driftBars = math.max(2, math.round(driftM * 60 / timeframe.in_seconds()))
drift = close > close[driftBars] ? 1 : close < close[driftBars] ? -1 : 0

// ---------------------------------------------------- levels
var float[] hiLv = array.new_float()
var float[] loLv = array.new_float()
var bool[]  hiDead = array.new_bool()
var bool[]  loDead = array.new_bool()
var line[]  hiLn = array.new_line()
var line[]  loLn = array.new_line()

ph = ta.pivothigh(high, swN, swN)
pl = ta.pivotlow(low,  swN, swN)

addLevel(float[] lv, bool[] dd, line[] ln, float v, float tol, color c) =>
    dup = false
    if array.size(lv) > 0
        for i = 0 to array.size(lv) - 1
            if math.abs(array.get(lv, i) - v) <= tol
                dup := true
    if not dup
        array.push(lv, v)
        array.push(dd, false)
        array.push(ln, showLv ? line.new(bar_index - swN, v, bar_index, v,
                   color = color.new(c, 55), width = 1) : na)
        if array.size(lv) > 40
            old = array.shift(ln)
            if not na(old)
                line.delete(old)
            array.shift(lv)
            array.shift(dd)

if not na(ph)
    addLevel(hiLv, hiDead, hiLn, ph, eqTol * atr, cLive)
if not na(pl)
    addLevel(loLv, loDead, loLn, pl, eqTol * atr, cLive)

// how many bars traded back into a level -- significance, measured
touches(float lv, float tol) =>
    n = 0
    for i = 1 to lookN
        if high[i] >= lv - tol and low[i] <= lv + tol
            n += 1
    n

// open of the last unbroken run of same-direction closes into the extreme
runOrigin(int dir) =>
    i = 1
    brk = false
    for k = 1 to 50
        if not brk
            same = dir == 1 ? close[k] < open[k] : close[k] > open[k]
            if same
                i := k
            else
                brk := true
    open[i]

// ---------------------------------------------------- absorption test
sig = 0
sigLvl = 0.0
if confirmed and array.size(loLv) > 0
    for i = 0 to array.size(loLv) - 1
        if sig == 0 and not array.get(loDead, i)
            lv = array.get(loLv, i)
            if low <= lv - pierceA * atr
                if close < lv - expandA * atr
                    array.set(loDead, i, true)          // EXPANSION: never fade
                    if showLv and array.size(loLn) > i
                        l = array.get(loLn, i)
                        if not na(l)
                            line.set_color(l, color.new(cDead, 70))
                else if close > lv and close > runOrigin(1) and touches(lv, eqTol * atr) >= minTouch
                    sig := 1
                    sigLvl := lv
                    array.set(loDead, i, true)          // one event per level
if confirmed and sig == 0 and array.size(hiLv) > 0
    for i = 0 to array.size(hiLv) - 1
        if sig == 0 and not array.get(hiDead, i)
            lv = array.get(hiLv, i)
            if high >= lv + pierceA * atr
                if close > lv + expandA * atr
                    array.set(hiDead, i, true)
                    if showLv and array.size(hiLn) > i
                        l = array.get(hiLn, i)
                        if not na(l)
                            line.set_color(l, color.new(cDead, 70))
                else if close < lv and close < runOrigin(-1) and touches(lv, eqTol * atr) >= minTouch
                    sig := -1
                    sigLvl := lv
                    array.set(hiDead, i, true)

// ---------------------------------------------------- range rotation
rHi = ta.highest(high, regN * 2)
rLo = ta.lowest(low,  regN * 2)
rW  = rHi - rLo
pos = rW > 0 ? (close - rLo) / rW : 0.5
if confirmed and sig == 0 and regime == "RANGE" and rW > atr * 2.0
    if pos <= 0.20
        sig := 1
    else if pos >= 0.80
        sig := -1

// ---------------------------------------------------- geometry
swLo = ta.lowest(low,  swN)
swHi = ta.highest(high, swN)
stopD = sig == 1 ? math.abs(close - swLo) + stopBuf * atr
      : sig == -1 ? math.abs(swHi - close) + stopBuf * atr : na
tooWide = not na(stopD) and stopD > maxStop * atr
buy  = sig ==  1 and not tooWide
sell = sig == -1 and not tooWide

// ---------------------------------------------------- live trade box
var int   pDir = 0
var float pEnt = na
var float pStop = na
var float pDist = na
var float pPeak = 0.0
var int   pBar = na
var bool  pLocked = false

if confirmed
    if pDir != 0
        pPeak := math.max(pPeak, pDir == 1 ? high - pEnt : pEnt - low)
        if (pDir == 1 ? low <= pStop : high >= pStop)
            pDir := 0
            pPeak := 0.0
            pLocked := false
        else if pPeak >= lockArm * atr
            pLocked := true
            span = math.max(0.0001, 3.0 - lockArm)
            t = math.min(1.0, math.max(0.0, (pPeak / atr - lockArm) / span))
            keep = 0.50 + t * (0.85 - 0.50)
            lockLv = pEnt + (pDir == 1 ? 1 : -1) * pPeak * keep
            trailLv = pDir == 1 ? close - 2.0 * atr : close + 2.0 * atr
            want = pDir == 1 ? math.max(lockLv, trailLv) : math.min(lockLv, trailLv)
            pStop := pDir == 1 ? math.max(pStop, want) : math.min(pStop, want)
    if pDir == 0 and (buy[1] or sell[1])
        pDir := buy[1] ? 1 : -1
        pEnt := open
        pDist := stopD[1]
        pStop := pEnt - pDir * pDist
        pPeak := 0.0
        pBar := bar_index
        pLocked := false

if showLv and barstate.islast
    if array.size(hiLn) > 0
        for i = 0 to array.size(hiLn) - 1
            l = array.get(hiLn, i)
            if not na(l)
                line.set_x2(l, bar_index + 8)
    if array.size(loLn) > 0
        for i = 0 to array.size(loLn) - 1
            l = array.get(loLn, i)
            if not na(l)
                line.set_x2(l, bar_index + 8)

var box  tBox = na
var line tStop = na
var line tCut = na
if barstate.islast
    if not na(tBox)
        box.delete(tBox)
    if not na(tStop)
        line.delete(tStop)
    if not na(tCut)
        line.delete(tCut)
    if showBox and pDir != 0
        c = pDir == 1 ? cBuy : cSell
        tBox := box.new(pBar, math.max(pEnt, pStop), bar_index + 6, math.min(pEnt, pStop),
                        border_color = color.new(c, 50), bgcolor = color.new(c, 90))
        tStop := line.new(pBar, pStop, bar_index + 6, pStop,
                          color = pLocked ? cBuy : cSell, width = pLocked ? 2 : 1,
                          style = pLocked ? line.style_solid : line.style_dashed)
        cutLv = pEnt - pDir * cutATR * atr
        tCut := line.new(pBar, cutLv, bar_index + 6, cutLv,
                         color = color.new(color.gray, 45), style = line.style_dotted)

plotshape(buy,  "BUY",  shape.labelup,   location.belowbar, cBuy,
          text = "BUY",  textcolor = color.white, size = size.tiny)
plotshape(sell, "SELL", shape.labeldown, location.abovebar, cSell,
          text = "SELL", textcolor = color.white, size = size.tiny)
plotshape(sig != 0 and tooWide, "stop too wide", shape.xcross, location.absolute,
          color.new(color.gray, 50), size = size.tiny)

// ---------------------------------------------------- panel
var table tb = na
if showPan and barstate.islast
    if na(tb)
        tb := table.new(position.bottom_right, 1, 4,
                        bgcolor = color.new(color.black, 82),
                        border_color = color.new(color.gray, 70), border_width = 1)
    table.cell(tb, 0, 0, regime + "   ER " + str.tostring(er, "#.###") +
               "   drift " + (drift == 1 ? "up" : drift == -1 ? "down" : "flat"),
               text_color = color.new(color.white, 12), text_size = size.tiny)
    table.cell(tb, 0, 1, "levels " + str.tostring(array.size(hiLv)) + "H / " +
               str.tostring(array.size(loLv)) + "L    ATR " + str.tostring(atr, "#.##"),
               text_color = color.new(color.gray, 15), text_size = size.tiny)
    table.cell(tb, 0, 2, pDir == 0 ? "flat" :
               (pDir == 1 ? "LONG " : "SHORT ") + str.tostring(pEnt, format.mintick) +
               (pLocked ? "   LOCKED" : "   cut live"),
               text_color = pDir == 0 ? color.gray : (pDir == 1 ? cBuy : cSell),
               text_size = size.tiny)
    table.cell(tb, 0, 3, pDir == 0 ? "" : "peak " +
               str.tostring(atr > 0 ? pPeak / atr : 0, "#.##") + " ATR",
               text_color = color.new(color.gray, 10), text_size = size.tiny)

alertcondition(buy,  "xau clean BUY",  "xau clean BUY")
alertcondition(sell, "xau clean SELL", "xau clean SELL")
