//@version=6
// =====================================================================
//  xau clean  --  the chart SNIPER trades from
//
//  Deliberately sparse. On screen: the DEMA, the signal arrows, the live
//  position box, the nearest liquidity each side, and structure. Nothing
//  else. Everything drawn is something the EA acts or refuses on.
//
//  BSL  buy-side liquidity   -- highs. Buy stops and resting sells sit ABOVE.
//  SSL  sell-side liquidity  -- lows. Sell stops sit BELOW.
//  LRL  low resistance       -- clean path. Price travels there fast.
//  HRL  high resistance      -- levels stacked in between. Price grinds.
//  ***  reaction level       -- price has already turned here 3+ times.
//
//  A level is not resistance. It is a shelf of resting orders plus the
//  stops of everyone positioned under it. Price is ATTRACTED to it, trades
//  through to fill them, and only then turns. So the chart marks where
//  price is GOING, not where it will stop.
//
//  Levels are remembered far further back than they are drawn: price reacts
//  to zones from hours ago, not just the last few candles.
// =====================================================================
indicator("xau clean", overlay = true, max_lines_count = 120,
          max_labels_count = 200, max_boxes_count = 20)

gT = "Trend"
demaLen = input.int(50,   "DEMA length",            group = gT, minval = 2)
showDema= input.bool(true,"Show DEMA",              group = gT)

gL = "Liquidity"
swN     = input.int(3,    "Swing strength",         group = gL, minval = 1)
keepN   = input.int(40,   "Pools remembered",       group = gL, minval = 10, maxval = 80,
   tooltip = "How many levels stay in MEMORY. Price reacts to zones from far back, so this is much larger than the number drawn.")
showN   = input.int(2,    "Pools drawn each side",  group = gL, minval = 1, maxval = 4)
eqTol   = input.float(0.15,"Equal levels merge (ATR)", group = gL, step = 0.05)
reactN  = input.int(3,    "Touches = reaction level", group = gL, minval = 2)
hrlN    = input.int(2,    "Levels between = HRL",   group = gL, minval = 1)

gS = "Signal"
pierceA = input.float(0.05,"Pierce depth (ATR)",    group = gS, step = 0.01)
expandA = input.float(0.35,"Close beyond = spent (ATR)", group = gS, step = 0.05)
minRoom = input.float(1.20,"Min clear air to trade (ATR)", group = gS, step = 0.1)

gX = "Trade"
bufA    = input.float(0.30,"Stop buffer (ATR)",     group = gX, step = 0.05)
maxStop = input.float(3.00,"Skip if stop > (ATR)",  group = gX, step = 0.1)
scalpATR= input.float(2.50,"Target under this ATR = SCALP", group = gX, step = 0.25,
   tooltip = "Most M1 trades are scalps. The box says which it is so you know what to expect from it.")

gP = "P/L"
ppp     = input.float(0.733,"Currency per point at 0.01 lots", group = gP, step = 0.001,
   tooltip = "XAUUSD 0.01 lot = 1 oz, so a $1 move is $1. In GBP about 0.733.")

gM = "Structure"
showBOS = input.bool(true, "BOS / CHoCH",           group = gM)
showEQ  = input.bool(true, "EQH / EQL",             group = gM)
showSW  = input.bool(true, "Strong / weak high-low",group = gM)

gV = "Look"
cBuy  = input.color(#2962ff, "Buy",   group = gV)
cSell = input.color(#f23645, "Sell",  group = gV)
cBsl  = input.color(#f23645, "BSL",   group = gV)
cSsl  = input.color(#2962ff, "SSL",   group = gV)
cDim  = input.color(#787b86, "Dim",   group = gV)

atr  = ta.atr(14)
band = ta.tr * 0.5
dema = ta.dema(close, demaLen)
ok   = barstate.isconfirmed or barstate.ishistory

plot(showDema ? dema : na, "DEMA", close > dema ? color.new(cBuy, 35)
     : color.new(cSell, 35), 2)

// ---------------------------------------------------------------- pools
var float[] hL = array.new_float()
var int[]   hT = array.new_int()
var bool[]  hD = array.new_bool()
var float[] lL = array.new_float()
var int[]   lT = array.new_int()
var bool[]  lD = array.new_bool()

ph = ta.pivothigh(high, swN, swN)
pl = ta.pivotlow(low,  swN, swN)

// CE10235 note: array.shift RETURNS the element it removes, so it must never
// be the last statement of a block -- the block would take that type while the
// implicit else stays void. Bound below, and the trim sits outside the if/else
// so both branches end on a void call.
push(float[] A, int[] T, bool[] D, float v, float tol, int cap) =>
    hit = -1
    if array.size(A) > 0
        for i = 0 to array.size(A) - 1
            if math.abs(array.get(A, i) - v) <= tol
                hit := i
    if hit >= 0
        array.set(T, hit, array.get(T, hit) + 1)
    else
        array.push(A, v)
        array.push(T, 1)
        array.push(D, false)
    if array.size(A) > cap
        float dropA = array.shift(A)
        int   dropT = array.shift(T)
        bool  dropD = array.shift(D)

eqhNow = false
eqlNow = false
if not na(ph)
    n0 = array.size(hL)
    push(hL, hT, hD, ph, eqTol * atr, keepN)
    eqhNow := array.size(hL) == n0        // merged into an existing level = EQH
if not na(pl)
    n0 = array.size(lL)
    push(lL, lT, lD, pl, eqTol * atr, keepN)
    eqlNow := array.size(lL) == n0

between(float target, int dir) =>
    n = 0
    A = dir == 1 ? hL : lL
    D = dir == 1 ? hD : lD
    if array.size(A) > 0
        for i = 0 to array.size(A) - 1
            v = array.get(A, i)
            if not array.get(D, i) and (dir == 1 ? (v > close and v < target)
                                                 : (v < close and v > target))
                n += 1
    n

nearest(int dir) =>
    b = 0.0
    bi = -1
    A = dir == 1 ? hL : lL
    D = dir == 1 ? hD : lD
    if array.size(A) > 0
        for i = 0 to array.size(A) - 1
            v = array.get(A, i)
            if not array.get(D, i) and (dir == 1 ? v > close : v < close)
                if bi < 0 or (dir == 1 ? v < b : v > b)
                    b := v
                    bi := i
    [b, bi]

// ---------------------------------------------------------------- structure
var float swHi = na
var float swLo = na
var int   bias = 0
var float strongLo = na
var float strongHi = na
bosUp = false
bosDn = false
chochUp = false
chochDn = false

if ok
    if not na(ph)
        swHi := ph
    if not na(pl)
        swLo := pl
    if not na(swHi) and close > swHi
        chochUp := bias < 0
        bosUp := bias >= 0
        // the low that launched the leg is now PROTECTED -- it held and caused
        // the break, which is what makes it strong rather than merely recent
        strongLo := swLo
        bias := 1
        swHi := na
    if not na(swLo) and close < swLo
        chochDn := bias > 0
        bosDn := bias <= 0
        strongHi := swHi
        bias := -1
        swLo := na

// ---------------------------------------------------------------- signal
sig = 0
if ok
    [bslLv, bi] = nearest(1)
    [sslLv, li] = nearest(-1)
    if li >= 0 and low <= sslLv - pierceA * atr
        if close < sslLv - expandA * atr
            array.set(lD, li, true)              // broke: spent, never fade it
        else if close > sslLv
            sig := 1
            array.set(lD, li, true)
    if sig == 0 and bi >= 0 and high >= bslLv + pierceA * atr
        if close > bslLv + expandA * atr
            array.set(hD, bi, true)
        else if close < bslLv
            sig := -1
            array.set(hD, bi, true)

[tgtUp, iu] = nearest(1)
[tgtDn, id] = nearest(-1)
roomUp = iu >= 0 ? tgtUp - close : 1e9
roomDn = id >= 0 ? close - tgtDn : 1e9
room   = sig == 1 ? roomUp : sig == -1 ? roomDn : 0.0
sLo = ta.lowest(low,  swN)
sHi = ta.highest(high, swN)
stopD = sig == 1 ? close - sLo + bufA * atr : sig == -1 ? sHi - close + bufA * atr : na
blocked = sig != 0 and (room < minRoom * atr or stopD > maxStop * atr)
buy  = sig ==  1 and not blocked
sell = sig == -1 and not blocked

// ---------------------------------------------------------------- position
var int   pd = 0
var float pe = na
var float ps = na
var float pt = na
var float pk = 0.0
var int   pb = na
var bool  pscalp = false

if ok
    if pd != 0
        pk := math.max(pk, pd == 1 ? high - pe : pe - low)
        if (pd == 1 ? low <= ps : high >= ps) or (pd == 1 ? high >= pt : low <= pt)
            pd := 0
            pk := 0.0
        else
            // breakeven FIRST, then trail hard. Most trades here reach 0-5
            // pounds, not 6+, so the ladder has to start where the peaks
            // actually are instead of where a swing system would put it.
            if pk >= 0.75 * band
                ps := pd == 1 ? math.max(ps, pe) : math.min(ps, pe)
            if pk >= 2.0 * band
                k = math.min(0.90, 0.65 + 0.25 * math.min(1.0, (pk / atr - 0.5) / 1.5))
                w = pe + (pd == 1 ? 1 : -1) * math.min(pk * k, pk - band)
                ps := pd == 1 ? math.max(ps, w) : math.min(ps, w)
    if pd == 0 and (buy[1] or sell[1])
        pd := buy[1] ? 1 : -1
        pe := open
        ps := pe - pd * stopD[1]
        pt := pd == 1 ? tgtUp : tgtDn
        pk := 0.0
        // anchored at the SIGNAL bar: the gap to the fill IS the late entry
        pb := bar_index - 1
        pscalp := math.abs(pt - pe) < scalpATR * atr

// ---------------------------------------------------------------- sessions
sessName(int h) =>
    h >= 23 or h < 7 ? "ASIA" : h < 12 ? "LONDON" : h < 16 ? "LDN/NY" :
       h < 21 ? "NEW YORK" : "OFF"
nextSess(int h) =>
    h < 7 ? "LONDON 07:00" : h < 12 ? "LDN/NY 12:00" : h < 16 ? "NEW YORK 16:00" :
       h < 21 ? "ASIA 23:00" : h < 23 ? "ASIA 23:00" : "LONDON 07:00"
hNow = hour(time, "GMT")
isOpen = hNow != hour(time[1], "GMT") and (hNow == 7 or hNow == 12 or hNow == 16 or hNow == 23)

// small tag at the bar where a session opens, sitting under the bar so it
// reads along the time axis rather than over price
if ok and isOpen
    label.new(bar_index, low, sessName(hNow), style = label.style_none,
        yloc = yloc.belowbar, size = size.tiny,
        textcolor = color.new(cDim, 25))

// ---------------------------------------------------------------- draw
var line[] drawn = array.new_line()
var label[] tags = array.new_label()
var box  pBox = na
var line pSl = na
var line pTp = na

if barstate.islast
    if array.size(drawn) > 0
        for i = 0 to array.size(drawn) - 1
            line.delete(array.get(drawn, i))
        array.clear(drawn)
    if array.size(tags) > 0
        for i = 0 to array.size(tags) - 1
            label.delete(array.get(tags, i))
        array.clear(tags)

    for side = -1 to 1 by 2
        A = side == 1 ? hL : lL
        T = side == 1 ? hT : lT
        D = side == 1 ? hD : lD
        col = side == 1 ? cBsl : cSsl
        prev = close
        for pass = 1 to showN
            b = 0.0
            bi = -1
            if array.size(A) > 0
                for i = 0 to array.size(A) - 1
                    v = array.get(A, i)
                    if not array.get(D, i) and (side == 1 ? v > prev : v < prev)
                        if bi < 0 or (side == 1 ? v < b : v > b)
                            b := v
                            bi := i
            if bi >= 0
                react = array.get(T, bi) >= reactN
                res = between(b, side) >= hrlN ? "HRL" : "LRL"
                array.push(drawn, line.new(bar_index - 60, b, bar_index + 14, b,
                    color = color.new(col, react ? 15 : 62),
                    width = react ? 2 : 1,
                    style = react ? line.style_solid : line.style_dotted))
                if pass == 1
                    array.push(tags, label.new(bar_index + 14, b,
                        (side == 1 ? "BSL " : "SSL ") + str.tostring(b, format.mintick) +
                        "  " + res + (react ? "  ***" : ""),
                        style = label.style_label_left, size = size.tiny,
                        color = color.new(col, 90), textcolor = color.new(col, 10)))
                prev := b

    if showSW
        if not na(strongLo)
            array.push(tags, label.new(bar_index + 14, strongLo, "Strong Low",
                style = label.style_label_left, size = size.tiny,
                color = color.new(cSsl, 92), textcolor = color.new(cSsl, 25)))
        if not na(strongHi)
            array.push(tags, label.new(bar_index + 14, strongHi, "Strong High",
                style = label.style_label_left, size = size.tiny,
                color = color.new(cBsl, 92), textcolor = color.new(cBsl, 25)))

    if not na(pBox)
        box.delete(pBox)
    if not na(pSl)
        line.delete(pSl)
    if not na(pTp)
        line.delete(pTp)
    if pd != 0
        c = pd == 1 ? cBuy : cSell
        pBox := box.new(pb, math.max(pe, ps), bar_index + 10, math.min(pe, ps),
            border_color = color.new(c, 55), bgcolor = color.new(c, 92))
        pSl := line.new(pb, ps, bar_index + 10, ps, color = cSell, width = 1,
            style = line.style_dashed)
        pTp := line.new(pb, pt, bar_index + 10, pt, color = cBuy, width = 1,
            style = line.style_dotted)

plotshape(buy,  "BUY",  shape.triangleup,   location.belowbar, cBuy,  size = size.tiny)
plotshape(sell, "SELL", shape.triangledown, location.abovebar, cSell, size = size.tiny)
plotshape(blocked, "no room", shape.circle, location.absolute,
          color.new(cDim, 40), size = size.tiny)
plotshape(showBOS and bosUp,   "BOS up",   shape.labelup,   location.belowbar,
          color.new(cBuy, 80),  text = "BOS",   textcolor = color.new(cBuy, 10),  size = size.tiny)
plotshape(showBOS and bosDn,   "BOS down", shape.labeldown, location.abovebar,
          color.new(cSell, 80), text = "BOS",   textcolor = color.new(cSell, 10), size = size.tiny)
plotshape(showBOS and chochUp, "CHoCH up", shape.labelup,   location.belowbar,
          color.new(cBuy, 70),  text = "CHoCH", textcolor = color.new(cBuy, 5),   size = size.tiny)
plotshape(showBOS and chochDn, "CHoCH dn", shape.labeldown, location.abovebar,
          color.new(cSell, 70), text = "CHoCH", textcolor = color.new(cSell, 5),  size = size.tiny)
plotshape(showEQ and eqhNow, "EQH", shape.labeldown, location.abovebar,
          color.new(cBsl, 88), text = "EQH", textcolor = color.new(cBsl, 20), size = size.tiny)
plotshape(showEQ and eqlNow, "EQL", shape.labelup,   location.belowbar,
          color.new(cSsl, 88), text = "EQL", textcolor = color.new(cSsl, 20), size = size.tiny)

// ---------------------------------------------------------------- daily P/L
// every closed simulated trade on this chart, today only, at 0.01 lots
var float dayPL = 0.0
var int   dayN = 0
var int   dayStamp = na
var float lastPd = 0.0
newDay = na(dayStamp) or dayStamp != dayofmonth(time, "GMT")
if ok and newDay
    dayPL := 0.0
    dayN := 0
    dayStamp := dayofmonth(time, "GMT")
if ok and pd == 0 and pd[1] != 0
    dayPL := dayPL + (close - pe) * pd[1] * ppp
    dayN := dayN + 1

livePL = pd == 0 ? 0.0 : (close - pe) * pd * ppp

var table tb = na
if barstate.islast
    if na(tb)
        tb := table.new(position.bottom_right, 1, 4,
              bgcolor = color.new(color.black, 84),
              border_color = color.new(color.gray, 78), border_width = 1)
    table.cell(tb, 0, 0, sessName(hNow) + "   next " + nextSess(hNow) +
        "   " + (bias == 1 ? "bullish" : bias == -1 ? "bearish" : "no bias"),
        text_color = color.new(color.white, 15), text_size = size.tiny)
    table.cell(tb, 0, 1, "room " + str.tostring(roomUp / atr, "#.#") + " up / " +
        str.tostring(roomDn / atr, "#.#") + " dn   ATR " + str.tostring(atr, "#.##"),
        text_color = color.new(cDim, 5), text_size = size.tiny)
    table.cell(tb, 0, 2, pd == 0 ? (blocked ? "signal blocked - no room" : "flat") :
        (pd == 1 ? "LONG " : "SHORT ") + str.tostring(pe, format.mintick) +
        (pscalp ? "  SCALP" : "  SWING") +
        "   SL " + str.tostring(ps, format.mintick) +
        "   TP " + str.tostring(pt, format.mintick),
        text_color = pd == 0 ? (blocked ? color.orange : color.gray)
                             : (pd == 1 ? cBuy : cSell), text_size = size.tiny)
    table.cell(tb, 0, 3, pd == 0 ? "" :
        "live " + (livePL >= 0 ? "+" : "") + str.tostring(livePL, "#.##") +
        "   peak " + str.tostring(atr > 0 ? pk / atr : 0, "#.#") + " ATR",
        text_color = livePL >= 0 ? cBuy : cSell, text_size = size.tiny)

var table dt = na
if barstate.islast
    if na(dt)
        dt := table.new(position.top_right, 1, 1,
              bgcolor = color.new(color.black, 84),
              border_color = color.new(color.gray, 78), border_width = 1)
    table.cell(dt, 0, 0, "today  " + (dayPL >= 0 ? "+" : "") +
        str.tostring(dayPL, "#.##") + "   " + str.tostring(dayN) + " trades",
        text_color = dayPL >= 0 ? cBuy : cSell, text_size = size.tiny)

alertcondition(buy,  "xau clean BUY",  "xau clean BUY")
alertcondition(sell, "xau clean SELL", "xau clean SELL")
