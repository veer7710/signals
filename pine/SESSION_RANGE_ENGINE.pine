//@version=5
// =====================================================================
//  SESSION RANGE ENGINE  --  chart twin of SessionRangeEngine.mq5
//
//  Built on the one effect that replicated on independent data:
//  hour-of-day volatility. On GOLD 15m the 13:00 UTC hour runs 1.82x
//  the median hourly range, 14:00 runs 1.68x, 20:00 runs 0.58x.
//  It predicts SIZE, never direction.
//
//  That matters for a FIXED range break and not for an ATR-scaled
//  system: spread is fixed in dollars, so a 1.8x bigger move is worth
//  ~1.8x more per dollar of spread paid. An ATR stop already absorbs
//  the difference (measured: +2.68 all hours vs +2.50 high-vol only).
//
//  Signals appear only on CONFIRMED bars -- they never vanish.
// =====================================================================
indicator("Session Range Engine", overlay = true, max_boxes_count = 120,
          max_lines_count = 200, max_labels_count = 200)

grpS = "Session"
sessHour  = input.int(13, "Break hour (GMT)", group = grpS, minval = 0, maxval = 23,
   tooltip = "13:00 GMT measured 1.82x the median hourly range on this data.")
rangeBars = input.int(16, "Bars before it that build the range", group = grpS, minval = 2)
windowBars= input.int(12, "Bars after it a break is accepted",   group = grpS, minval = 1)
alsoSecond= input.bool(false, "Also trade a second session",     group = grpS)
secondHour= input.int(7,  "Second hour (GMT)",  group = grpS, minval = 0, maxval = 23)

grpQ = "Range quality"
minRngATR = input.float(0.8, "Skip if range < (ATR)", group = grpQ, step = 0.1)
maxRngATR = input.float(6.0, "Skip if range > (ATR)", group = grpQ, step = 0.1)
closeBey  = input.bool(true, "Require a CLOSE beyond the range", group = grpQ)

grpX = "Stop / exit"
stopOpp   = input.bool(true, "Stop at the opposite side of the range", group = grpX)
stopAtrM  = input.float(1.5, "else stop = ATR x",  group = grpX, step = 0.1)
maxStop   = input.float(4.0, "Skip if stop > (ATR)", group = grpX, step = 0.1)
trailATR  = input.float(3.0, "ATR trail multiple", group = grpX, step = 0.1)
armAtR    = input.float(1.0, "Arm trail at (R)",   group = grpX, step = 0.1)
maxHold   = input.int(150,   "Max bars in trade",  group = grpX)

grpV = "Visuals"
showRange = input.bool(true, "Range box",      group = grpV)
showBox   = input.bool(true, "Position box",   group = grpV)
showSess  = input.bool(true, "Session panel",  group = grpV)
cUp = input.color(#26a69a, "Long",  group = grpV)
cDn = input.color(#ef5350, "Short", group = grpV)
cRng= input.color(#90a4ae, "Range", group = grpV)

atr = ta.atr(14)
h_  = hour(time, "GMT")
newSess = (h_ == sessHour and h_[1] != sessHour) or
          (alsoSecond and h_ == secondHour and h_[1] != secondHour)

var float rHi = na
var float rLo = na
var bool  rReady = false
var int   rLeft = 0
var int   rBar = na
var box   rBox = na
var int   takenDay = na

confirmed = barstate.isconfirmed or barstate.ishistory

if confirmed
    if newSess
        rHi := ta.highest(high, rangeBars)[1]
        rLo := ta.lowest(low,  rangeBars)[1]
        w = rHi - rLo
        rReady := w >= minRngATR * atr and w <= maxRngATR * atr
        rLeft := windowBars
        rBar := bar_index
        if showRange and rReady
            rBox := box.new(bar_index - rangeBars, rHi, bar_index + windowBars, rLo,
                            border_color = color.new(cRng, 40),
                            bgcolor = color.new(cRng, 90))
    else if rReady
        rLeft := rLeft - 1
        if rLeft <= 0
            rReady := false

brkUp = rReady and (closeBey ? close > rHi : high > rHi)
brkDn = rReady and (closeBey ? close < rLo : low  < rLo)

stopDistL = stopOpp ? math.abs(close - rLo) : stopAtrM * atr
stopDistS = stopOpp ? math.abs(rHi - close) : stopAtrM * atr
okL = brkUp and stopDistL <= maxStop * atr
okS = brkDn and stopDistS <= maxStop * atr

oncePerDay = na(takenDay) or takenDay != dayofmonth(time, "GMT")
sigLong  = confirmed and okL and oncePerDay
sigShort = confirmed and okS and oncePerDay
if sigLong or sigShort
    takenDay := dayofmonth(time, "GMT")
    rReady := false

// ------------------------------------------------- simulated position
var int   pDir = 0
var float pEnt = na
var float pStop = na
var float pDist = na
var float pPeak = 0.0
var int   pBar = na
var bool  pArmed = false

if confirmed
    if pDir != 0
        fav = pDir == 1 ? high - pEnt : pEnt - low
        pPeak := math.max(pPeak, fav)
        if (pDir == 1 ? low <= pStop : high >= pStop) or bar_index - pBar >= maxHold
            pDir := 0
            pArmed := false
            pPeak := 0.0
        else if pPeak >= armAtR * pDist
            pArmed := true
            cand = pDir == 1 ? close - trailATR * atr : close + trailATR * atr
            pStop := pDir == 1 ? math.max(pStop, cand) : math.min(pStop, cand)
    if pDir == 0 and (sigLong[1] or sigShort[1])
        pDir := sigLong[1] ? 1 : -1
        pEnt := open
        pDist := sigLong[1] ? stopDistL[1] : stopDistS[1]
        pStop := pDir == 1 ? pEnt - pDist : pEnt + pDist
        pPeak := 0.0
        pBar := bar_index
        pArmed := false

var box  posBox = na
var line posEnt = na
var line posSl  = na
if barstate.islast
    if not na(posBox)
        box.delete(posBox)
    if not na(posEnt)
        line.delete(posEnt)
    if not na(posSl)
        line.delete(posSl)
    if pDir != 0 and showBox
        col = pDir == 1 ? cUp : cDn
        posBox := box.new(pBar, math.max(pEnt, pStop), bar_index + 6, math.min(pEnt, pStop),
                          border_color = color.new(col, 45), bgcolor = color.new(col, 88))
        posEnt := line.new(pBar, pEnt,  bar_index + 6, pEnt,  color = col, width = 2)
        posSl  := line.new(pBar, pStop, bar_index + 6, pStop, color = cDn, width = 1,
                           style = line.style_dashed)

plot(rReady ? rHi : na, "Range high", color.new(cRng, 20), 1, plot.style_linebr)
plot(rReady ? rLo : na, "Range low",  color.new(cRng, 20), 1, plot.style_linebr)

plotshape(sigLong,  "BUY",  shape.labelup,   location.belowbar, cUp,
          text = "BUY",  textcolor = color.white, size = size.tiny)
plotshape(sigShort, "SELL", shape.labeldown, location.abovebar, cDn,
          text = "SELL", textcolor = color.white, size = size.tiny)

// ------------------------------------------------- session panel
sessName() =>
    h = hour(time, "GMT")
    h >= 23 or h < 7 ? "ASIA" : h < 12 ? "LONDON" :
       h < 16 ? "LDN / NY overlap" : h < 21 ? "NEW YORK" : "OFF"
volTag() =>
    h = hour(time, "GMT")
    (h >= 12 and h <= 15) or h <= 1 ? "HIGH VOL" :
       (h >= 3 and h <= 4) or h == 20 or h == 22 ? "thin" : "normal"

var table tb = na
if showSess and barstate.islast
    if na(tb)
        tb := table.new(position.bottom_right, 1, 4,
                        bgcolor = color.new(color.black, 82),
                        border_color = color.new(color.gray, 70), border_width = 1)
    table.cell(tb, 0, 0, sessName() + "   " + volTag(),
               text_color = color.new(color.white, 15), text_size = size.tiny)
    table.cell(tb, 0, 1, rReady ? "range ARMED  " + str.tostring(rLo, format.mintick) +
               " - " + str.tostring(rHi, format.mintick) + "   " + str.tostring(rLeft) + " bars left"
               : "range idle   break hour " + str.tostring(sessHour) + ":00 GMT",
               text_color = color.new(color.gray, 15), text_size = size.tiny)
    table.cell(tb, 0, 2, pDir == 0 ? "flat" :
               (pDir == 1 ? "LONG " : "SHORT ") + str.tostring(pEnt, format.mintick),
               text_color = pDir == 0 ? color.gray : (pDir == 1 ? cUp : cDn),
               text_size = size.tiny)
    table.cell(tb, 0, 3, pDir == 0 ? "" :
               "peak " + str.tostring(pDist > 0 ? pPeak / pDist : 0, "#.##") + "R" +
               (pArmed ? "  [armed]" : "  [not armed]"),
               text_color = color.new(color.gray, 10), text_size = size.tiny)

alertcondition(sigLong,  "Session BUY",  "Session Range Engine BUY")
alertcondition(sigShort, "Session SELL", "Session Range Engine SELL")
