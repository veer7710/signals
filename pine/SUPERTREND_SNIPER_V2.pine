//@version=5
// =====================================================================
//  SUPERTREND SNIPER v2  --  chart twin of SuperTrendSniper2.mq5
//
//  Parity rules (so the chart and the EA take the SAME trade on the
//  SAME bar -- if they disagree, one of them is lying and you have no
//  way to tell which):
//    * identical SuperTrend recursion (Wilder ATR, same band logic)
//    * a flip is acted on at the OPEN OF THE NEXT BAR, never at the
//      close of the flip bar
//    * nothing is drawn on an unconfirmed bar, so a signal that
//      appears NEVER disappears again
//    * the trail arms only at ArmAtR -- the whole point of v2
// =====================================================================
indicator("SuperTrend Sniper v2", overlay = true, max_boxes_count = 60,
          max_lines_count = 200, max_labels_count = 200)

// ------------------------------------------------- inputs
grpE = "Entry"
stLen   = input.int(10,   "SuperTrend ATR period", group = grpE, minval = 1)
stMult  = input.float(3.0,"SuperTrend multiplier", group = grpE, step = 0.1)

grpS = "Stop"
swLook  = input.int(3,    "Swing lookback for stop", group = grpS, minval = 1)
bufATR  = input.float(0.25,"Stop buffer (ATR)",      group = grpS, step = 0.05)
maxStop = input.float(3.0,"Skip if stop wider than (ATR)", group = grpS, step = 0.1)

grpX = "Exit  (the v2 fix)"
exitMode = input.string("ATR trail", "Exit rule", options = ["ATR trail", "Give-back"], group = grpX)
trailATR = input.float(3.0, "ATR trail multiple",   group = grpX, step = 0.1)
giveBack = input.float(0.55,"Give-back fraction",   group = grpX, step = 0.05)
armAtR   = input.float(1.0, "ARM the trail at (R)", group = grpX, step = 0.1,
   tooltip = "v1 armed at 0R, so it exited on the first pullback of every trade. " +
             "Measured average winner was $5.06. Arming at 1R was worth " +
             "+$2.70/trade (t=2.48) on 498 paired GOLD 15m entries.")
maxHold  = input.int(120,   "Max bars in trade",    group = grpX, minval = 5)

grpV = "Visuals"
showBox  = input.bool(true,  "Live position box",   group = grpV)
showST   = input.bool(true,  "SuperTrend line",     group = grpV)
showSess = input.bool(true,  "Session panel",       group = grpV)
cUp      = input.color(#26a69a, "Long",  group = grpV)
cDn      = input.color(#ef5350, "Short", group = grpV)
cStop    = input.color(#ef5350, "Stop",  group = grpV)
cTgt     = input.color(#26a69a, "Target",group = grpV)

// ------------------------------------------------- SuperTrend
atr = ta.atr(stLen)
hl2_ = (high + low) / 2.0
upB  = hl2_ - stMult * atr
dnB  = hl2_ + stMult * atr

var float fUp = na
var float fDn = na
var int   stDir = 1
fUp := close[1] > nz(fUp[1], upB) ? math.max(upB, nz(fUp[1], upB)) : upB
fDn := close[1] < nz(fDn[1], dnB) ? math.min(dnB, nz(fDn[1], dnB)) : dnB
stDir := nz(stDir[1], 1) == 1 ? (close < fUp ? -1 : 1) : (close > fDn ? 1 : -1)
stLine = stDir == 1 ? fUp : fDn

flipUp = stDir == 1  and nz(stDir[1], 1) == -1
flipDn = stDir == -1 and nz(stDir[1], 1) == 1

// only a CONFIRMED bar may produce a signal -> no vanishing arrows
confirmed = barstate.isconfirmed or barstate.ishistory
sigUp = flipUp and confirmed
sigDn = flipDn and confirmed

// ------------------------------------------------- stop distance
swLow  = ta.lowest(low,  swLook)
swHigh = ta.highest(high, swLook)
stopDistL = math.abs(close - swLow)  + bufATR * atr
stopDistS = math.abs(swHigh - close) + bufATR * atr
tooWideL  = stopDistL > maxStop * atr
tooWideS  = stopDistS > maxStop * atr

// ------------------------------------------------- simulated position
var int    pDir   = 0
var float  pEnt   = na
var float  pStop  = na
var float  pDist  = na
var float  pPeak  = 0.0
var int    pBar   = na
var bool   pArmed = false
var box    pBox   = na
var line   lEnt   = na
var line   lSl    = na

closePos() =>
    pDir := 0
    pArmed := false
    pPeak := 0.0

if confirmed
    // ---- manage an open simulated trade first
    if pDir != 0
        fav = (pDir == 1 ? high - pEnt : pEnt - low)
        pPeak := math.max(pPeak, fav)
        hitStop = pDir == 1 ? low <= pStop : high >= pStop
        aged    = bar_index - pBar >= maxHold
        if hitStop or aged
            closePos()
        else
            if pPeak >= armAtR * pDist
                pArmed := true
                cand = exitMode == "ATR trail"
                     ? (pDir == 1 ? close - trailATR * atr : close + trailATR * atr)
                     : pEnt + pDir * pPeak * (1.0 - giveBack)
                pStop := pDir == 1 ? math.max(pStop, cand) : math.min(pStop, cand)

    // ---- new entry on the bar AFTER the flip (parity with the EA)
    if pDir == 0
        if sigUp[1] and not tooWideL[1]
            pDir := 1
            pEnt := open
            pDist := stopDistL[1]
            pStop := pEnt - pDist
            pPeak := 0.0
            pBar := bar_index
            pArmed := false
        else if sigDn[1] and not tooWideS[1]
            pDir := -1
            pEnt := open
            pDist := stopDistS[1]
            pStop := pEnt + pDist
            pPeak := 0.0
            pBar := bar_index
            pArmed := false

// ------------------------------------------------- drawing
plot(showST ? stLine : na, "SuperTrend", stDir == 1 ? cUp : cDn, 2,
     plot.style_linebr)

plotshape(sigUp and not tooWideL, "BUY",  shape.labelup,   location.belowbar,
          cUp, text = "BUY",  textcolor = color.white, size = size.tiny)
plotshape(sigDn and not tooWideS, "SELL", shape.labeldown, location.abovebar,
          cDn, text = "SELL", textcolor = color.white, size = size.tiny)
// refused-for-risk markers: you can see what the stop cap costs you
plotshape(sigUp and tooWideL, "skip", shape.xcross, location.belowbar,
          color.new(color.gray, 40), size = size.tiny)
plotshape(sigDn and tooWideS, "skip", shape.xcross, location.abovebar,
          color.new(color.gray, 40), size = size.tiny)

if barstate.islast
    if not na(pBox)
        box.delete(pBox)
    if not na(lEnt)
        line.delete(lEnt)
    if not na(lSl)
        line.delete(lSl)
    if pDir != 0 and showBox
        col = pDir == 1 ? cUp : cDn
        pBox := box.new(pBar, math.max(pEnt, pStop), bar_index + 6,
                        math.min(pEnt, pStop),
                        border_color = color.new(col, 40),
                        bgcolor = color.new(col, 88))
        lEnt := line.new(pBar, pEnt, bar_index + 6, pEnt,
                         color = col, width = 2)
        lSl  := line.new(pBar, pStop, bar_index + 6, pStop,
                         color = cStop, width = 1, style = line.style_dashed)

// ------------------------------------------------- session panel
sessName() =>
    h = hour(time, "GMT")
    h >= 23 or h < 7 ? "ASIA" : h < 12 ? "LONDON" :
       h < 16 ? "LDN / NY overlap" : h < 21 ? "NEW YORK" : "OFF"

// measured on this data: 13:00 UTC runs 1.82x the median hourly range,
// 20:00 runs 0.58x. It predicts SIZE, not direction.
volTag() =>
    h = hour(time, "GMT")
    (h >= 12 and h <= 15) or h <= 1 ? "HIGH VOL" :
       (h >= 3 and h <= 4) or h == 20 or h == 22 ? "thin" : "normal"

var table tb = na
if showSess and barstate.islast
    if na(tb)
        tb := table.new(position.bottom_right, 1, 4,
                        bgcolor = color.new(color.black, 82),
                        border_color = color.new(color.gray, 70), border_width = 1)
    table.cell(tb, 0, 0, sessName() + "   " + volTag(),
               text_color = color.new(color.white, 15), text_size = size.tiny)
    table.cell(tb, 0, 1, str.format("{0,date,HH:mm} GMT", time_close),
               text_color = color.new(color.gray, 20), text_size = size.tiny)
    table.cell(tb, 0, 2, pDir == 0 ? "flat" :
               (pDir == 1 ? "LONG " : "SHORT ") +
               str.tostring(pEnt, format.mintick) +
               (pArmed ? "  [trail armed]" : "  [trail not armed]"),
               text_color = pDir == 0 ? color.gray : (pDir == 1 ? cUp : cDn),
               text_size = size.tiny)
    table.cell(tb, 0, 3, pDir == 0 ? "" :
               "peak " + str.tostring(pDist > 0 ? pPeak / pDist : 0, "#.##") + "R",
               text_color = color.new(color.gray, 10), text_size = size.tiny)

alertcondition(sigUp and not tooWideL, "Sniper BUY",  "SuperTrend Sniper v2 BUY")
alertcondition(sigDn and not tooWideS, "Sniper SELL", "SuperTrend Sniper v2 SELL")
